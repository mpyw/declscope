package fixqualify

// Both names merge to userRepositoryLoad. The first in source order takes it,
// and the second is offered the plain prefix instead of no fix.
func userRepositoryLoad() int { return 6 } // want `func load does not carry namespace "userRepository" anywhere in its name; give it a name that carries "userRepository", such as userRepositoryLoad, or move it to the file it belongs to`

func userRepositoryRepositoryLoad() int { return 8 } // want `func repositoryLoad does not carry namespace "userRepository" anywhere in its name; give it a name that carries "userRepository", such as userRepositoryRepositoryLoad, or move it to the file it belongs to`

// The name opens with the word that opens the namespace, so it is prefixed
// whole: putting the rest of the namespace after it would change what it says.
func userRepositoryUserLoad() int { return 9 } // want `func userLoad does not carry namespace "userRepository" anywhere in its name; give it a name that carries "userRepository", such as userRepositoryUserLoad, or move it to the file it belongs to`
