package fixtesttaggedonly

// The only test file is user_tagged_test.go, which the build leaves out, so
// the package has no test variant. The non-test variant learns from the
// ignored files that no variant sees it, and reads it for its names.

// load is named from user_tagged_test.go, so it is not renamed.
func load() int { return 1 } // want `func load does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userLoad, or move it to the file it belongs to`

// Named only in this file, so it is renamed.
func userFree() int { return 3 } // want `func free does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userFree, or move it to the file it belongs to`

func Exported() int { return load() + userFree() }
