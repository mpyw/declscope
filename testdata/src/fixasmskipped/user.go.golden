package fixasmskipped

// The go command skips _old.s, as it skips every name that starts with _ or
// ., so plain is still renamed.
func userPlain() int64 { return 2 } // want `func plain does not carry namespace "user" anywhere in its name; move it to the file it belongs to, or give it a name that carries "user" \(userPlain is one candidate, not necessarily the best\)`

func Exported() int64 { return userPlain() }
