package fixlinkname

import _ "unsafe"

// The directive names helper as text, which a rename cannot follow.
//
//go:linkname helper
func helper() int { return 1 } // want `func helper does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userHelper, or move it to the file it belongs to`

// A cgo //export names tick as text the same way.
//
//export tick
func tick() int { return 3 } // want `func tick does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userTick, or move it to the file it belongs to`

func userPlain() int { return 2 } // want `func plain does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userPlain, or move it to the file it belongs to`

func Exported() int { return helper() + tick() + userPlain() }
