package fixlinkname

import _ "unsafe"

// The directive names helper as text, which a rename cannot follow.
//
//go:linkname helper
func helper() int { return 1 } // want `func helper does not carry namespace "user" anywhere in its name; move it to the file it belongs to, or give it a name that carries "user" \(userHelper is one candidate, not necessarily the best\)`

// A cgo //export names tick as text the same way.
//
//export tick
func tick() int { return 3 } // want `func tick does not carry namespace "user" anywhere in its name; move it to the file it belongs to, or give it a name that carries "user" \(userTick is one candidate, not necessarily the best\)`

func userPlain() int { return 2 } // want `func plain does not carry namespace "user" anywhere in its name; move it to the file it belongs to, or give it a name that carries "user" \(userPlain is one candidate, not necessarily the best\)`

func Exported() int { return helper() + tick() + userPlain() }
