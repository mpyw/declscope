package fixpredeclared

// Dropping the label would leave a predeclared name. The declaration itself
// would compile, shadowing the builtin for the whole package, so the fix is
// withheld and the violation reported alone.
var onlyLen = 3 // want `var onlyLen carries the label of namespace "only", which is not required here; rename it to len`

type onlyError struct{} // want `type onlyError carries the label of namespace "only", which is not required here; rename it to error`

var _ onlyError

// Free, so renamed.
var helper = 1 // want `var onlyHelper carries the label of namespace "only", which is not required here; rename it to helper`

func Exported(s string) int { return len(s) + onlyLen + helper }
