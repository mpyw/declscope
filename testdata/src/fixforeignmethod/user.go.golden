package fixforeignmethod

// help satisfies orderHelper. Renamed, orderT would no longer implement it,
// and the assignment in order.go would not compile.
func (o orderT) help() int { return 1 } // want `method help does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userHelp, or move it to the file it belongs to`

// assert is asked for only by a type assertion. Renamed, the program would
// still compile, but the assertion would fail where it now succeeds.
func (o orderT) assert() int { return 2 } // want `method assert does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userAssert, or move it to the file it belongs to`

// check would become userCheck, which orderChecker asks for. Renamed, orderT
// would start satisfying it, and the assertion would succeed where it now fails.
func (o orderT) check() bool { return true } // want `method check does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userCheck, or move it to the file it belongs to`

// size would become userSize, the name of a field orderT already has.
func (o orderT) size() int { return 3 } // want `method size does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userSize, or move it to the file it belongs to`

// depth would become userDepth, a field of orderOuter, which promotes depth.
func (o orderT) depth() int { return 4 } // want `method depth does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userDepth, or move it to the file it belongs to`

// width would become userWidth, a field of the unnamed struct orderAnon has.
func (o *orderT) width() int { return 5 } // want `method width does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userWidth, or move it to the file it belongs to`

// spare is free on orderT, on every type promoting it, and in every interface,
// so it is renamed.
func (o orderT) userSpare() int { return 6 } // want `method spare does not carry namespace "user" anywhere in its name; give it a name that carries "user", such as userSpare, or move it to the file it belongs to`

func userCall(o orderOuter) int { return o.help() + o.userSpare() }
