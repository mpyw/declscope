// The rename guard the implementation applies, and that it is sound.
//
// rename_sound.fsl is the negative control: it models a guard checking package
// scope only and enumerates what a sound one must check beyond it. A control
// with no positive counterpart proves nothing about the code that exists —
// internal/rename.go renameSafe could lose fileScopesBind and no spec here
// would change verdict.
//
// This is that counterpart. It models all four scope checks renameSafe applies
// (Pkg.Scope().Lookup, types.Universe.Lookup, fileScopesBind, and
// LookupParent at the reference site) and proves the rename sound under them.
// Dropping any one of the four turns this spec violated.
//
// ASSUME-1: names reduce to Old / New / Other, since only the presence of a
//   collision matters, not the spelling (modelling assumption)
// ASSUME-2: two reference sites are modeled — one that referred to the
//   declaration, and one elsewhere in the package that already used the new
//   name. Soundness over more sites is the conjunction over each (modelling
//   assumption)
spec RenameGuarded {
  enum NameId { OldName, NewName, OtherName }
  enum Bind   { Unbound, BindsOld, BindsNew, BindsOther }
  enum Target { ToDecl, ToLocal, ToFile, ToOtherPkg, ToUniverse, Unresolved }

  state {
    configured: Bool,
    declName:   NameId,   // The declaration's current name
    localAt:    Bind,     // What the innermost scope at the reference binds
    fileAt:     Bind,     // What that file's imports bind
    otherPkg:   Bind,     // Another package-scope declaration
    universeNew: Bool,    // NewName is predeclared (len, error, string, ...)
    renamed:    Bool,
    // What a second site elsewhere in the package resolved NewName to before
    // the rename. Captured so the rename can be checked not to capture it.
    elsewhereBefore: Target
  }

  init {
    configured = false  declName = OldName
    localAt = Unbound  fileAt = Unbound  otherPkg = Unbound
    universeNew = false  renamed = false  elsewhereBefore = Unresolved
  }

  action configure(l: Bind, f: Bind, o: Bind, u: Bool) {
    requires not configured
    configured = true  localAt = l  fileAt = f  otherPkg = o  universeNew = u
  }

  def bindOf(n: NameId) =
    if n == OldName then BindsOld else if n == NewName then BindsNew else BindsOther

  // Resolution from the reference site, innermost scope first.
  def resolve(n: NameId) =
    if localAt == bindOf(n) then ToLocal
    else if fileAt == bindOf(n) then ToFile
    else if otherPkg == bindOf(n) then ToOtherPkg
    else if n == declName then ToDecl
    else if n == NewName and universeNew then ToUniverse
    else Unresolved

  // A second site elsewhere in the package, with no local or import binding of
  // its own, resolving NewName.
  def resolveElsewhere() =
    if otherPkg == BindsNew then ToOtherPkg
    else if declName == NewName then ToDecl
    else if universeNew then ToUniverse
    else Unresolved

  // The guard as implemented: every scope Go resolves through.
  def guardAsImplemented() =
    otherPkg != BindsNew      // Pkg.Scope().Lookup
    and fileAt != BindsNew    // fileScopesBind
    and localAt != BindsNew   // LookupParent at the reference site
    and not universeNew       // types.Universe.Lookup

  fair action rename() {
    requires configured
    requires not renamed
    requires declName == OldName
    requires resolve(OldName) == ToDecl   // The reference resolves correctly before
    requires guardAsImplemented()
    declName = NewName
    renamed = true
    elsewhereBefore = resolveElsewhere()   // Reads the pre-rename state
  }

  // Soundness, part one: the reference to the declaration must still reach it.
  invariant RenameKeepsReferenceOnTarget { renamed => resolve(NewName) == ToDecl }

  // Soundness, part two: a reference that already used the new name elsewhere
  // must not be captured by the renamed declaration. A package-level name
  // legitimately shadows the universe, so the first invariant stays silent
  // here — the harm falls on everything else that wanted the predeclared name.
  invariant RenameCapturesNothingElsewhere {
    renamed and elsewhereBefore != Unresolved => resolveElsewhere() == elsewhereBefore
  }

  invariant RenameImpliesConfigured { renamed => configured }
  invariant RenameRecordsNewName    { renamed => declName == NewName }
  // Under the full guard nothing elsewhere ever resolved the new name, which is
  // why RenameCapturesNothingElsewhere reports a vacuous antecedent here: the
  // guard removes the states that would have exercised it. That is the guard
  // working, stated as a property rather than left as a warning.
  invariant NothingResolvedNewName { renamed => elsewhereBefore == Unresolved }

  reachable RenameHappens { renamed }
  // The rename still happens with a local binding present, as long as it is not
  // the new name: the guard must be no broader than it needs to be.
  reachable RenameUnderLocalOther { renamed and localAt == BindsOther }
}
