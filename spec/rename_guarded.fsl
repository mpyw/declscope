// The rename guard the implementation applies, and a proof that it is sound.
//
// rename_sound.fsl is the negative control. It models a guard that checks
// package scope only. Its counterexamples list what a sound guard must check
// beyond that. A control alone proves nothing about the code that exists.
// Without a positive counterpart, safeToRename in internal/rename.go could
// lose renameBoundByImport, and no spec would change verdict.
//
// This spec is that counterpart. It models the four scopes Go resolves
// through, with one guard row for each. It proves the rename sound under
// them. Dropping any one row makes this spec violated.
//
// safeToRename covers the four scopes with four calls:
// Pkg.Scope().Lookup, types.Universe.Lookup, renameBoundByImport, and
// LookupParent at each reference site. The rows do not map one to one onto
// these calls. LookupParent walks from the reference out to the universe. So
// in Go it also catches the imports of the reference's file and the
// predeclared names. The other two calls stay for two reasons. They hold
// where no reference exists. And an import in another file is not on the
// LookupParent path.
//
// ASSUME-1: names reduce to Old, New and Other. Only the presence of a
//   collision matters, not the spelling (modelling assumption).
// ASSUME-2: two reference sites are modeled. One referred to the
//   declaration. The other is elsewhere in the package and already used the
//   new name. Soundness over more sites is the conjunction over each site
//   (modelling assumption).
fsl 5
spec RenameGuarded {
  enum Name    { OldName, NewName, OtherName }
  // What a scope binds the name to, if anything.
  enum Binding { Unbound, BindsOld, BindsNew, BindsOther }
  // Where a reference to a name resolves.
  enum Resolution {
    ToDeclaration,       // The declaration being renamed
    ToLocal,             // A local, parameter, result or type parameter
    ToImport,            // An import of the file
    ToOtherDeclaration,  // Another package-scope declaration
    ToPredeclared,       // The universe: len, error, string, ...
    Unresolved
  }

  state {
    configured:              Bool = false,
    declarationName:         Name = OldName,      // The declaration's current name
    localBinding:            Binding = Unbound,   // What the innermost scope at the reference binds
    importBinding:           Binding = Unbound,   // What that file's imports bind
    otherDeclarationBinding: Binding = Unbound,   // What another package-scope declaration binds
    newNameIsPredeclared:    Bool = false,        // NewName is predeclared (len, error, string, ...)
    renamed:                 Bool = false,
    // What a second site elsewhere in the package resolved NewName to before
    // the rename. The rename records it, so the spec can check that the
    // rename does not capture that site.
    elsewhereResolvedBefore: Resolution = Unresolved,
    // Where the reference to the declaration resolved before the rename. The
    // rename records it, so the spec can check that the rename moves the
    // reference nowhere.
    referenceResolvedBefore: Resolution = Unresolved
  }

  action configure(local: Binding, imported: Binding, otherDeclaration: Binding,
                   predeclared: Bool) {
    requires not configured
    configured = true
    localBinding = local
    importBinding = imported
    otherDeclarationBinding = otherDeclaration
    newNameIsPredeclared = predeclared
  }

  def bindingOf(name: Name) =
    if name == OldName then BindsOld
    else if name == NewName then BindsNew
    else BindsOther

  // Resolution from the reference site, innermost scope first.
  def resolveAtReference(name: Name) =
    if localBinding == bindingOf(name) then ToLocal
    else if importBinding == bindingOf(name) then ToImport
    else if otherDeclarationBinding == bindingOf(name) then ToOtherDeclaration
    else if name == declarationName then ToDeclaration
    else if name == NewName and newNameIsPredeclared then ToPredeclared
    else Unresolved

  // How a second site elsewhere in the package resolves NewName. That site
  // has no local or import binding of its own.
  def resolveElsewhere() =
    if otherDeclarationBinding == BindsNew then ToOtherDeclaration
    else if declarationName == NewName then ToDeclaration
    else if newNameIsPredeclared then ToPredeclared
    else Unresolved

  // The guard as implemented. It checks every scope Go resolves through.
  // Each row names the call in safeToRename that covers it where no other
  // call does.
  def guardAsImplemented() =
    otherDeclarationBinding != BindsNew  // Pkg.Scope().Lookup
    and importBinding != BindsNew        // renameBoundByImport (and LookupParent, at this site)
    and localBinding != BindsNew         // LookupParent at the reference site
    and not newNameIsPredeclared         // types.Universe.Lookup (and LookupParent)

  fair action rename() {
    requires configured
    requires not renamed
    requires declarationName == OldName
    // The reference resolves correctly before the rename.
    requires resolveAtReference(OldName) == ToDeclaration
    requires guardAsImplemented()
    declarationName = NewName
    renamed = true
    // Reads the state before the rename.
    elsewhereResolvedBefore = resolveElsewhere()
    referenceResolvedBefore = resolveAtReference(OldName)
  }

  // Soundness, part one: the reference to the declaration must still reach it.
  invariant RenameKeepsReferenceOnTarget {
    renamed => resolveAtReference(NewName) == ToDeclaration
  }
  // The reference resolves after the rename where it resolved before. A
  // rename of a reference that a local already caught would move it onto the
  // declaration. That is also a change in what the package computes.
  invariant RenameKeepsReferenceWhereItWas {
    renamed => resolveAtReference(NewName) == referenceResolvedBefore
  }

  // Soundness, part two: the renamed declaration must not capture a reference
  // elsewhere that already used the new name. A package-level name may
  // legitimately shadow the universe. So the first invariant stays silent
  // when the new name is predeclared. The harm falls on every other reference
  // that wanted the predeclared name.
  invariant RenameCapturesNothingElsewhere {
    renamed
      and elsewhereResolvedBefore != Unresolved
      => resolveElsewhere() == elsewhereResolvedBefore
  }

  invariant RenameImpliesConfigured { renamed => configured }
  // Under the full guard, nothing elsewhere ever resolved the new name. The
  // guard removes the states that would exercise
  // RenameCapturesNothingElsewhere. So fslc reports a vacuous antecedent for
  // it. fslc classifies that warning as insufficient_depth. But no depth
  // reaches the antecedent, and this invariant proves it. The warning is the
  // guard working, and this invariant states it as a property.
  // RenameCapturesNothingElsewhere still matters. It is the invariant that
  // breaks when the universe row is dropped.
  invariant NothingResolvedNewName { renamed => elsewhereResolvedBefore == Unresolved }

  reachable RenameHappens { renamed }
  // The rename still happens when a local binding exists, if it does not bind
  // the new name. The guard must be no broader than it needs to be.
  reachable RenameUnderLocalOther {
    renamed
      and localBinding == BindsOther
  }
  // The same for an import and for another declaration. Each binds a name
  // that is neither old nor new, and the rename still happens.
  reachable RenameUnderImportOther {
    renamed
      and importBinding == BindsOther
  }
  reachable RenameUnderOtherDeclarationOther {
    renamed
      and otherDeclarationBinding == BindsOther
  }

  // --- auxiliary ------------------------------------------------------------
  // Bookkeeping, not a claim: it restates what rename assigns.
  invariant RenameRecordsNewName { renamed => declarationName == NewName }
}
