// Inserting //declscope:shared always removes the boundary crossing. It is
// offered only where a crossing exists. It never overwrites a scope the
// author stated on the declaration itself.
//
// The fix is offered only where the configured default decided the scope. A
// `private` inherited from a block, the containing type or the file is a
// default, not a decision. A directive on the declaration would outrank it.
// But the outer directive would then reach one declaration fewer. That can
// make the outer directive unused, which is a report the fix created. So the
// fix is withheld at every level that stated a scope.
// FixKeepsEveryDirectiveBound states that reason. It reads a binding test of
// its own, not the guard.
//
// The scope model is copied verbatim from knobs.fsl: the enums, and the defs
// from defaultScopeUnder to boundaryFires. spec/verify.sh fails if the two
// copies differ. knobs.fsl holds the witnesses that each level and the
// default change the scope. They are not repeated here.
fsl 5
spec BoundaryFix {
  enum Scope { Shared, Private }
  // Member is anything written inside the declaration of a type: a struct
  // field, or the method name of an interface. Method is a method with a
  // receiver.
  enum Kind  { PackageLevel, Member, Method }
  enum Directive { NoDirective, SharedDirective, PrivateDirective }
  enum ReferencedFrom { Nowhere, SameNamespace, OtherNamespace }

  state {
    configured: Bool = false,
    unexportedDefault: Scope = Private,
    kind: Kind = PackageLevel,
    exported: Bool = false,
    declDirective: Directive = NoDirective,
    blockDirective: Directive = NoDirective,
    typeDirective: Directive = NoDirective,
    fileDirective: Directive = NoDirective,
    referencedFrom: ReferencedFrom = Nowhere,
    fixed: Bool = false,
    // A pass that reported and did not fix. Either -fix is off, or the fix is
    // withheld. It lets a run go on forever with a crossing pending. That
    // makes `fair` on fixBoundary a claim, not decoration.
    stalled: Bool = false
  }
  action configure(newUnexportedDefault: Scope, newKind: Kind, newExported: Bool,
                   newDeclDirective: Directive, newBlockDirective: Directive,
                   newTypeDirective: Directive, newFileDirective: Directive,
                   newReferencedFrom: ReferencedFrom) {
    requires not configured
    configured = true
    unexportedDefault = newUnexportedDefault
    kind = newKind
    exported = newExported
    declDirective = newDeclDirective
    blockDirective = newBlockDirective
    typeDirective = newTypeDirective
    fileDirective = newFileDirective
    referencedFrom = newReferencedFrom
  }

  // Exportedness decides the default and nothing else. An exported
  // declaration has no boundary unless a directive gives it one. The
  // rejected alternative asks whether it is reachable from outside the
  // package. A single-package analysis cannot answer that. A type escapes
  // through an exported signature, an embedding, an alias or an interface it
  // satisfies. Guessing produced boundary reports on API that every importer
  // reaches.
  //
  // The defs below take each input that a property varies as a parameter.
  // effectiveScope() passes the configured values. A property can then ask
  // what the scope would be with one input changed.
  def defaultScopeUnder(givenDefault: Scope) =
    if exported then Shared else givenDefault

  // The nearer directive if it states a scope. Otherwise the farther one.
  def directiveOr(nearer: Directive, farther: Directive) =
    if nearer != NoDirective then nearer else farther

  // What contains a member: its type, and through the type the var/const/type
  // block the type is declared in. addGenDeclToCollection merges the block
  // into the own directive of the spec. It passes the result as the container
  // of the members. So a block reaches a member. It never reaches a method
  // with a receiver.
  def containerDirectiveOf(givenType: Directive, givenBlock: Directive) =
    if kind == Member then directiveOr(givenType, givenBlock) else NoDirective
  def containerDirective() = containerDirectiveOf(typeDirective, blockDirective)

  // A parenthesized var/const/type block reaches only the specs it holds. So
  // only a package-level declaration has one. A member is not a spec of a
  // block, and a method is never in one. Decl.Merge lets the own scope of a
  // spec replace the scope of the block. That puts the block directly under
  // the declaration.
  def blockDirectiveOf(givenBlock: Directive) =
    if kind == PackageLevel then givenBlock else NoDirective
  def blockDirectiveOfSpec() = blockDirectiveOf(blockDirective)

  // The scope a directive states. If it states none, the scope from the next
  // level out.
  def scopeOr(directive: Directive, otherwise: Scope) =
    if directive == SharedDirective then Shared
    else if directive == PrivateDirective then Private
    else otherwise

  // The nearest level that states a scope decides it.
  def scopeUnder(givenDefault: Scope, givenDecl: Directive, givenBlock: Directive,
                 givenType: Directive, givenFile: Directive) =
    scopeOr(givenDecl,
      scopeOr(blockDirectiveOf(givenBlock),
        scopeOr(containerDirectiveOf(givenType, givenBlock),
          scopeOr(givenFile, defaultScopeUnder(givenDefault)))))
  def effectiveScope() =
    scopeUnder(unexportedDefault, declDirective, blockDirective, typeDirective, fileDirective)

  // One line on purpose: spec/verify.sh compares the shared scope model up to
  // the line that names this def.
  def boundaryFires() = effectiveScope() == Private and referencedFrom == OtherNamespace

  // The directive of the nearest level that stated the scope, if any. The fix
  // is withheld for every level, not only for the declaration. In the code
  // this is the test `t.boundAt != boundAtDefault` in boundaryFinding.
  def statedDirective() =
    directiveOr(declDirective,
      directiveOr(blockDirectiveOfSpec(),
        directiveOr(containerDirective(), fileDirective)))

  // --- binding, separate from the guard ---------------------------------------
  // A directive binds this declaration when deleting it would change the
  // scope of the declaration under some value of defaults.unexported. This is
  // the loose binding test of unused_modes.fsl, for one declaration. It reads
  // scopeUnder only, never statedDirective().
  def declBinds() =
    scopeUnder(Shared, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Shared, NoDirective, blockDirective, typeDirective, fileDirective)
    or scopeUnder(Private, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Private, NoDirective, blockDirective, typeDirective, fileDirective)
  def blockBinds() =
    scopeUnder(Shared, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Shared, declDirective, NoDirective, typeDirective, fileDirective)
    or scopeUnder(Private, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Private, declDirective, NoDirective, typeDirective, fileDirective)
  def typeBinds() =
    scopeUnder(Shared, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Shared, declDirective, blockDirective, NoDirective, fileDirective)
    or scopeUnder(Private, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Private, declDirective, blockDirective, NoDirective, fileDirective)
  def fileBinds() =
    scopeUnder(Shared, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Shared, declDirective, blockDirective, typeDirective, NoDirective)
    or scopeUnder(Private, declDirective, blockDirective, typeDirective, fileDirective)
      != scopeUnder(Private, declDirective, blockDirective, typeDirective, NoDirective)

  action reportWithoutFix() {
    requires configured
    stalled = true
  }

  fair action fixBoundary() {
    requires configured
    requires boundaryFires()
    requires statedDirective() == NoDirective
    declDirective = SharedDirective
    fixed = true
  }

  // --- what the fix must keep -------------------------------------------------
  // The fix settles the crossing it was written for.
  invariant BoundaryFixSettles { fixed => not boundaryFires() }

  // The inserted directive binds. Otherwise the fix would start an unused
  // report on its own directive.
  invariant InsertedDirectiveBinds { fixed => declBinds() }

  // The reason for the guard. Every directive that bound this declaration
  // before the fix still binds it after. The author's own directive is also
  // still the one written. An outer directive that stops binding here may bind
  // nothing at all. Then the fix has started an unused report.
  //
  // MODEL: binding is judged on this one declaration. An outer directive may
  // also bind other declarations in its reach and stay used. The model does
  // not hold them. So this is stricter than "no new unused report", and the
  // guard is too.
  trans FixKeepsEveryDirectiveBound {
    not old(fixed) and fixed =>
      (old(declBinds()) => declBinds() and declDirective == old(declDirective))
      and (old(blockBinds()) => blockBinds())
      and (old(typeBinds()) => typeBinds())
      and (old(fileBinds()) => fileBinds())
  }

  // The stall itself. Without these, nothing reads `stalled`. The assignment
  // that records it could then be deleted with no verdict moving.
  reachable CrossingSurvivesAPassWithoutFix {
    stalled
    and boundaryFires()
    and statedDirective() == NoDirective
  }
  reachable WithheldFixSurvivesAPass {
    stalled
    and boundaryFires()
    and statedDirective() != NoDirective
  }

  leadsTo BoundaryEventuallyFixed {
    configured and boundaryFires() and statedDirective() == NoDirective ~> not boundaryFires()
    helpful fixBoundary()
    decreases if boundaryFires() then 1 else 0
  }

  // --- auxiliary ---------------------------------------------------------------
  // A lemma, not a claim: a fix happens only after configuration. Induction
  // needs it for InsertedDirectiveBinds.
  invariant FixImpliesConfigured { fixed => configured }
}
