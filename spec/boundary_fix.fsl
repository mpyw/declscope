// Inserting //declscope:shared always removes the boundary crossing. It is
// offered only where a crossing exists. It never overwrites a scope the
// author stated on the declaration itself.
//
// The fix is offered only where the configured default decided the scope. A
// `private` inherited from a block, the containing type or the file is a
// default, not a decision. A directive on the declaration would outrank it.
// But the outer directive would then reach one declaration fewer. That can
// make the outer directive unused, which is a report the fix created. So the
// fix is withheld at every level that stated a scope.
// FixNeverClobbersDirective pins that.
//
// The scope model is copied verbatim from knobs.fsl: the enums, and the defs
// from defaultScope to boundaryFires. spec/verify.sh fails if the two copies
// differ.
fsl 5
spec BoundaryFix {
  enum Scope { Shared, Private }
  // Member is anything written inside the declaration of a type: a struct
  // field, or the method name of an interface. Method is a method with a
  // receiver.
  enum Kind  { PackageLevel, Member, Method }
  enum Directive { NoDirective, SharedDirective, PrivateDirective }
  enum ReferencedFrom { Nowhere, SameNamespace, OtherNamespace }

  state {
    configured: Bool = false,
    unexportedDefault: Scope = Private,
    kind: Kind = PackageLevel,
    exported: Bool = false,
    declDirective: Directive = NoDirective,
    blockDirective: Directive = NoDirective,
    typeDirective: Directive = NoDirective,
    fileDirective: Directive = NoDirective,
    referencedFrom: ReferencedFrom = Nowhere,
    fixed: Bool = false,
    // A pass that reported and did not fix. Either -fix is off, or the fix is
    // withheld. It lets a run go on forever with a crossing pending. That
    // makes `fair` on fixBoundary a claim, not decoration.
    stalled: Bool = false
  }
  action configure(newUnexportedDefault: Scope, newKind: Kind, newExported: Bool,
                   newDeclDirective: Directive, newBlockDirective: Directive,
                   newTypeDirective: Directive, newFileDirective: Directive,
                   newReferencedFrom: ReferencedFrom) {
    requires not configured
    configured = true
    unexportedDefault = newUnexportedDefault
    kind = newKind
    exported = newExported
    declDirective = newDeclDirective
    blockDirective = newBlockDirective
    typeDirective = newTypeDirective
    fileDirective = newFileDirective
    referencedFrom = newReferencedFrom
  }

  // Exportedness decides the default and nothing else. An exported
  // declaration has no boundary unless a directive gives it one. The
  // rejected alternative asks whether it is reachable from outside the
  // package. A single-package analysis cannot answer that. A type escapes
  // through an exported signature, an embedding, an alias or an interface it
  // satisfies. Guessing produced boundary reports on API that every importer
  // reaches.
  def defaultScope() = if exported then Shared else unexportedDefault

  // The nearer directive if it states a scope. Otherwise the farther one.
  def directiveOr(nearer: Directive, farther: Directive) =
    if nearer != NoDirective then nearer else farther

  // What contains a member: its type, and through the type the var/const/type
  // block the type is declared in. addGenDeclToCollection merges the block
  // into the own directive of the spec. It passes the result as the container
  // of the members. So a block reaches a member. It never reaches a method
  // with a receiver.
  def containerDirective() =
    if kind == Member then directiveOr(typeDirective, blockDirective) else NoDirective

  // A parenthesized var/const/type block reaches only the specs it holds. So
  // only a package-level declaration has one. A member is not a spec of a
  // block, and a method is never in one. Decl.Merge lets the own scope of a
  // spec replace the scope of the block. That puts the block directly under
  // the declaration.
  def blockDirectiveOfSpec() =
    if kind == PackageLevel then blockDirective else NoDirective

  // The scope a directive states. If it states none, the scope from the next
  // level out.
  def scopeOr(directive: Directive, otherwise: Scope) =
    if directive == SharedDirective then Shared
    else if directive == PrivateDirective then Private
    else otherwise

  // The nearest level that states a scope decides it.
  def effectiveScope() =
    scopeOr(declDirective,
      scopeOr(blockDirectiveOfSpec(),
        scopeOr(containerDirective(),
          scopeOr(fileDirective, defaultScope()))))

  // One line on purpose: spec/verify.sh compares the shared scope model up to
  // the line that names this def.
  def boundaryFires() = effectiveScope() == Private and referencedFrom == OtherNamespace

  // The directive of the nearest level that stated the scope, if any. The fix
  // is withheld for every level, not only for the declaration. A directive
  // inserted under an outer one leaves the outer one binding a declaration
  // fewer. That can make it unused. The unused report would not exist before
  // the fix ran, and -fix must never produce one. In the code this is the
  // test `t.boundAt != boundAtDefault` in boundaryFinding.
  def statedDirective() =
    directiveOr(declDirective,
      directiveOr(blockDirectiveOfSpec(),
        directiveOr(containerDirective(), fileDirective)))

  action reportWithoutFix() {
    requires configured
    stalled = true
  }

  fair action fixBoundary() {
    requires configured
    requires boundaryFires()
    requires statedDirective() == NoDirective
    declDirective = SharedDirective
    fixed = true
  }

  // Auxiliary: a fix happens only after configuration. The directive it
  // inserts records it. Together these make BoundaryFixSettles inductive.
  invariant FixImpliesConfigured { fixed => configured }
  invariant FixRecordsDirective  { fixed => declDirective == SharedDirective }
  invariant BoundaryFixSettles   { fixed => not boundaryFires() }

  // The guards are load-bearing. Without these, two defects would go
  // unnoticed: a spurious fix, and a fix that overwrites the own directive
  // of the author.
  trans FixOnlyWhereNeeded {
    not old(fixed) and fixed => old(boundaryFires())
  }
  trans FixNeverClobbersDirective {
    not old(fixed) and fixed => old(statedDirective()) == NoDirective
  }
  // The same rule with each level spelled out. FixNeverClobbersDirective reads
  // statedDirective(), so a level dropped from that def would pass it. This one
  // names every level that reaches the kind. A block never reaches a method,
  // and a type reaches only its members.
  trans FixFindsEveryLevelUnstated {
    not old(fixed) and fixed =>
      old(declDirective) == NoDirective
      and old(fileDirective) == NoDirective
      and (old(kind) == Method or old(blockDirective) == NoDirective)
      and (old(kind) != Member or old(typeDirective) == NoDirective)
  }

  reachable BoundaryCanFire { configured and boundaryFires() }

  // The FixWithheld* witnesses below are states where a boundary fires under
  // a stated scope and no fix is written yet. They are reachable whether or
  // not fixBoundary tests statedDirective(). So they do not pin the
  // withholding themselves. FixNeverClobbersDirective does. These show that
  // it is checked in the states where its guard decides.
  reachable FixWithheldUnderTypeDirective {
    configured
    and kind == Member
    and typeDirective == PrivateDirective
    and declDirective == NoDirective
    and boundaryFires()
    and not fixed
  }
  // Every nearer level and the default are pinned. So only the file can make
  // it cross.
  reachable FixWithheldUnderFileDirective {
    configured
    and kind == PackageLevel
    and fileDirective == PrivateDirective
    and declDirective == NoDirective
    and blockDirective == NoDirective
    and typeDirective == NoDirective
    and unexportedDefault == Shared
    and not exported
    and boundaryFires()
    and not fixed
  }
  // The file directive reaches every kind. Each of these pins every nearer
  // level and a shared default. So only the file can make it cross. Suppose
  // the file reached only package-level declarations. Then a member and a
  // method would have nothing to withhold.
  reachable FixWithheldUnderFileDirectiveOnMember {
    configured
    and kind == Member
    and fileDirective == PrivateDirective
    and declDirective == NoDirective
    and blockDirective == NoDirective
    and typeDirective == NoDirective
    and unexportedDefault == Shared
    and not exported
    and boundaryFires()
    and not fixed
  }
  reachable FixWithheldUnderFileDirectiveOnMethod {
    configured
    and kind == Method
    and fileDirective == PrivateDirective
    and declDirective == NoDirective
    and blockDirective == NoDirective
    and typeDirective == NoDirective
    and unexportedDefault == Shared
    and not exported
    and boundaryFires()
    and not fixed
  }
  // Exportedness has to do work here too. Without these, the default could
  // ignore exportedness and this spec would not notice. An exported
  // declaration narrowed by its own directive does cross. The fix is
  // withheld because the directive is the author's.
  reachable ExportedNarrowedNeverFixed {
    configured
    and exported
    and kind == PackageLevel
    and declDirective == PrivateDirective
    and referencedFrom == OtherNamespace
    and boundaryFires()
    and not fixed
  }
  reachable ExportedMemberWithheldUnderTypeDirective {
    configured
    and kind == Member
    and exported
    and typeDirective == PrivateDirective
    and declDirective == NoDirective
    and boundaryFires()
    and not fixed
  }
  // A declaration that states its own scope is the one case the fix must
  // refuse. Without a witness, FixNeverClobbersDirective is checked only in
  // states that never test its guard.
  reachable FixWithheldOverOwnDirective {
    configured
    and boundaryFires()
    and declDirective == PrivateDirective
    and not fixed
  }
  // defaults.unexported must reach this spec too, not only knobs. Under a
  // shared default there is no crossing to fix in the first place. There is
  // one witness per kind. Suppose one kind ignored defaults.unexported. A
  // witness that left the kind free would still be satisfied.
  reachable SharedDefaultLeavesNothingToFix {
    configured
    and kind == PackageLevel
    and unexportedDefault == Shared
    and statedDirective() == NoDirective
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable SharedDefaultLeavesNothingToFixOnMember {
    configured
    and kind == Member
    and unexportedDefault == Shared
    and statedDirective() == NoDirective
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable SharedDefaultLeavesNothingToFixOnMethod {
    configured
    and kind == Method
    and unexportedDefault == Shared
    and statedDirective() == NoDirective
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }

  // The block level and exportedness must do work here too, not only in
  // knobs. Without these, defaultScope() could ignore exportedness. And
  // blockDirective could go unread. This spec would not notice either.
  reachable BoundaryFromBlockDirectiveFires {
    configured
    and kind == PackageLevel
    and blockDirective == PrivateDirective
    and declDirective == NoDirective
    and typeDirective == NoDirective
    and fileDirective == NoDirective
    and unexportedDefault == Shared
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable ExportedNeverCrossesByDefault {
    configured
    and exported
    and kind == PackageLevel
    and declDirective == NoDirective
    and blockDirective == NoDirective
    and typeDirective == NoDirective
    and fileDirective == NoDirective
    and unexportedDefault == Private
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }

  // The stall itself. Without these, nothing reads `stalled`. The assignment
  // that records it could then be deleted with no verdict moving.
  reachable CrossingSurvivesAPassWithoutFix {
    stalled
    and boundaryFires()
    and statedDirective() == NoDirective
  }
  reachable WithheldFixSurvivesAPass {
    stalled
    and boundaryFires()
    and statedDirective() != NoDirective
  }

  leadsTo BoundaryEventuallyFixed {
    configured and boundaryFires() and statedDirective() == NoDirective ~> not boundaryFires()
    helpful fixBoundary()
    decreases if boundaryFires() then 1 else 0
  }
}
