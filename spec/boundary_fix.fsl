// Inserting //declscope:package always removes the boundary crossing.
//
// Only the variables these properties read are modeled: 216 action instances.
spec BoundaryFix {
  enum Scope { Public, Package, Private }
  enum Dir   { NoDir, DirPublic, DirPackage, DirPrivate }
  enum Refs  { NoRefs, SameNs, CrossNs }

  state {
    configured: Bool, cfgExported: Scope, cfgUnexported: Scope,
    exported: Bool, dir: Dir, refs: Refs, fixed: Bool
  }
  init {
    configured = false  cfgExported = Public  cfgUnexported = Private
    exported = false  dir = NoDir  refs = NoRefs  fixed = false
  }
  action configure(e: Scope, u: Scope, x: Bool, di: Dir, r: Refs) {
    requires not configured
    configured = true  cfgExported = e  cfgUnexported = u
    exported = x  dir = di  refs = r
  }
  def effScope() =
    if dir == DirPublic then Public
    else if dir == DirPackage then Package
    else if dir == DirPrivate then Private
    else if exported then cfgExported
    else cfgUnexported
  def boundaryFires() = effScope() == Private and refs == CrossNs

  fair action fixBoundary() {
    requires configured  requires boundaryFires()  requires dir == NoDir
    dir = DirPackage  fixed = true
  }
  invariant BoundaryFixSettles { fixed => not boundaryFires() }
  reachable BoundaryCanFire { configured and boundaryFires() }
}
