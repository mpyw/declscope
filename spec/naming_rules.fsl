// One rule and one fix. A declaration must carry its namespace somewhere in
// its name. The fix renames it so that the namespace leads. The fix is offered
// only under rules.naming.fix, and that switch is off by default. A rename can
// choose a name but not a place. A prefix that reads badly usually means the
// declaration belongs in another file. namingFixOn is that switch. The report
// does not read it. Neither does fixable(). fixable() is the guard alone, and
// it is what names[].fixable of declscope inspect reports.
//
// The rename merges the words the name already opens with. For example,
// FunctionCallExpr in ast_function_call_expr.go becomes AstFunctionCallExpr.
// Where the merged name is taken, the rename falls back to the whole prefix.
// Either way the namespace ends up at the start. fixQualify models that.
//
// The namespace need not lead the name. Go names a type for what it is and
// puts the category last. statementReducer is a reducer of statements. Go
// also names a constructor NewTracer. Demanding the prefix there gives
// reducerStatementReducer and TracerNewTracer. They double the word the name
// already carries. Over six measured repositories, one qualify diagnostic in
// eight had that shape.
//
// namespaceInName == Inside is what that relaxation buys.
// InsideWouldHaveFiredBefore pins it. namespaceInName is the outcome of the
// whole containment test. So it also stands for the forms that carry a
// namespace without spelling it. These are the two generated inflections
// (storing for store, applies for apply) and the words listed under
// rules.naming.vocabulary. Each goes through the same test as the namespace's
// own spelling. So none needs a state of its own.
//
// There is no unqualify rule. Such a rule needs the complement: drop the
// prefix where it is not demanded. The complement has no meaning once any
// position counts. There is no single word to drop out of statementReducer.
// Cutting one word from LoadConfig leaves Load. Over those repositories it
// also fired 24 times, against 1345 for qualify. So it paid almost nothing
// for the contradiction it brought in.
//
// rules.naming.exported lets the rule reach exported declarations. The rename
// is never applied there. It rewrites every use in the package, and an
// exported name has uses outside the package. The analysis cannot see them.
//
// A file marked //declscope:core joins the package's core namespace. Its
// prefix is empty. There is nothing to require, so the core is outside the
// rule.
//
// canPrefix is namespace.CanPrefix. Two kinds of stem are exempt. One cannot
// open a Go identifier, as 2fa.go cannot. The other has a first letter with
// no capital form, as 用户.go and _foo do. An exported name could not take
// that prefix and stay exported. Containment alone could still be satisfied
// there, by spelling the namespace later in the name. The fix could not be.
// The rule stays out and does not report what it cannot remedy.
//
// kind separates what the rule reaches by where the declaration is read from.
// A member is read through its type. A method with a receiver is read through
// its receiver. The receiver names the unit that holds its type. When that
// unit is the file the method is written in, the namespace is already at the
// call site. Then the rule stays out. Only a method filed in another
// namespace than its type must carry the namespace it is written in
// (target.foreignMethod in internal/subject.go). A method whose receiver
// names no type the pass indexed has no second namespace to disagree with. So
// it counts as colocated.
//
// ToolchainFunc is a function the toolchain finds by its name. It is func
// main in package main, or a TestXxx, BenchmarkXxx, FuzzXxx or ExampleXxx
// function in a _test.go file. A rename leaves a program or a test that
// nothing runs. So nothing is asked of it. It is a kind of its own and not a
// flag, since only a package-level function can be one.
//
// This rule does not read the scope settings, so they are left out.
fsl 5
spec NamingRules {
  enum Qualify { Always, OnDemand, Never }
  // PackageLevelDecl is a package-level declaration that is neither a method
  // nor a ToolchainFunc.
  enum Kind {
    PackageLevelDecl,
    ToolchainFunc,
    Member,
    ColocatedMethod,
    ForeignMethod
  }
  // Where the namespace sits in the name. Absent is the only one that fires.
  // The other three are kept apart, so each silence can be witnessed on its
  // own.
  enum NamespaceInName { Absent, Inside, AtStart, Equal }

  state {
    configured: Bool = false,
    // rules.naming.qualify.
    qualifyMode: Qualify = Never,
    // rules.naming.exported.
    namingExported: Bool = false,
    // Whether the package has a second namespace, which ondemand reads.
    manyNamespaces: Bool = false,
    kind: Kind = PackageLevelDecl,
    exported: Bool = false,
    canPrefix: Bool = true,
    isCore: Bool = false,
    namespaceInName: NamespaceInName = Absent,
    fixed: Bool = false,
    // namingFixOn is rules.naming.fix. It is off by default, as
    // Options.NamingFix is in internal/options.go.
    namingFixOn: Bool = false,
    // renameGuardPasses stands for everything safeToRename in
    // internal/rename.go withholds beyond exportedness:
    //   - a collision in any scope, or on a type that holds the method
    //   - an interface of the package that asks for the method's old or new
    //     name
    //   - a reference from a file the pass did not collect, such as a
    //     generated file or one the filter leaves out
    //   - a name a directive spells as text
    //   - an assembly or cgo file anywhere in the package
    //   - a file of the package the pass does not see
    //   - a name another fix has already taken
    // renameFix also withholds the fix when no collected file spells the
    // name, or when the new name is the old one.
    // The violation is reported either way. Only the fix is withheld.
    renameGuardPasses: Bool = true,
    // reportedWithoutFix records a pass that reported without fixing. The
    // cause is -fix off, rules.naming.fix off, or the rename withheld. It lets
    // a run go on forever with a violation pending. That makes `fair` on
    // fixQualify a claim and not decoration.
    reportedWithoutFix: Bool = false
  }

  action configure(givenQualifyMode: Qualify,
                   givenNamingExported: Bool,
                   givenManyNamespaces: Bool,
                   givenKind: Kind,
                   givenExported: Bool,
                   givenCanPrefix: Bool,
                   givenIsCore: Bool,
                   givenNamespaceInName: NamespaceInName,
                   givenRenameGuardPasses: Bool,
                   givenNamingFixOn: Bool) {
    requires not configured
    configured = true
    qualifyMode = givenQualifyMode
    namingExported = givenNamingExported
    manyNamespaces = givenManyNamespaces
    kind = givenKind
    exported = givenExported
    canPrefix = givenCanPrefix
    isCore = givenIsCore
    namespaceInName = givenNamespaceInName
    renameGuardPasses = givenRenameGuardPasses
    namingFixOn = givenNamingFixOn
  }

  // A pass that reports and does not fix. It may repeat forever.
  action reportOnly() {
    requires configured
    reportedWithoutFix = true
  }

  def qualifyRequired() =
    qualifyMode == Always
    or (qualifyMode == OnDemand and manyNamespaces)
  def kindReached() = kind == PackageLevelDecl or kind == ForeignMethod
  def ruleReaches() =
    kindReached()
    and canPrefix
    and not isCore
    and (not exported or namingExported)
  def carriesNamespace() = namespaceInName != Absent
  def qualifyFires() =
    ruleReaches()
    and qualifyRequired()
    and not carriesNamespace()
  def fixable() = not exported and renameGuardPasses
  // What -fix applies: the guard's rename, and only under rules.naming.fix.
  def fixOffered() = namingFixOn and fixable()

  fair action fixQualify() {
    requires configured
    requires qualifyFires()
    requires fixOffered()
    namespaceInName = AtStart
    fixed = true
  }

  invariant FixImpliesConfigured { fixed => configured }
  // FixLandsAtStart, FixSettles and FixLeavesNothingAbsent follow from the
  // assignment namespaceInName = AtStart in fixQualify. They pin that the
  // model's fix moves the name out of Absent. Then no later edit to
  // fixQualify can leave FixSettles true vacuously. They do not prove that
  // the real rename carries the namespace. That is
  // Contains(Qualify(n, ns), ns), and the Go tests in internal/namespace check
  // it.
  invariant FixLandsAtStart      { fixed => namespaceInName == AtStart }
  invariant FixSettles           { fixed => not qualifyFires() }
  invariant ExportedNeverFixed   { fixed => not exported }
  // The switch gates the fix. A rename is applied only under
  // rules.naming.fix. Replacing `requires fixOffered()` with fixable() breaks
  // this.
  invariant FixOnlyWhenOn        { fixed => namingFixOn }
  invariant FixLeavesNothingAbsent { fixed => carriesNamespace() }

  trans FixOnlyWhereNeeded {
    not old(fixed) and fixed => old(qualifyFires())
  }
  // Once the scenario is set, nothing in the rule moves a name back out of
  // its namespace. The guard is on configured, because configure is the setup
  // step and assigns namespaceInName freely. Only what follows it is the
  // rule's doing.
  trans CarryNeverLost {
    old(configured) and old(carriesNamespace()) => carriesNamespace()
  }

  reachable QualifyCanFire { configured and qualifyFires() }

  // Pins that the reachables below share. The first is a namespace that can
  // take a prefix and is not the core. The second is the strictest setting
  // with the namespace nowhere in the name. Together they give the state
  // where the rule fires unless something else stops it.
  def prefixableNamespace() = canPrefix and not isCore
  def alwaysWithoutNamespace() =
    qualifyMode == Always and namespaceInName == Absent

  // The relaxation itself. The namespace sits inside the name, and the rule
  // is at its strictest. Nothing is reported.
  reachable InsideSilentUnderAlways {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and not exported
    and qualifyMode == Always
    and namespaceInName == Inside
    and not qualifyFires()
  }
  // The negative control for the rule that demanded a prefix. Under that rule
  // this same state reported. If containment is ever narrowed back to a
  // prefix test, this witness becomes unreachable and the spec fails.
  reachable InsideWouldHaveFiredBefore {
    configured
    and ruleReaches()
    and qualifyRequired()
    and namespaceInName == Inside
    and not qualifyFires()
  }
  // A name identical to its namespace carries it, whatever the setting.
  reachable EqualSilentUnderAlways {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and not exported
    and qualifyMode == Always
    and namespaceInName == Equal
    and not qualifyFires()
  }

  // Each silence below pins every other reason for silence. So the reason it
  // is named for is the one being witnessed.
  reachable ExportedSilentByDefault {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and exported
    and not namingExported
    and alwaysWithoutNamespace()
    and not qualifyFires()
  }
  reachable ExportedReportedWithoutFix {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and exported
    and namingExported
    and alwaysWithoutNamespace()
    and qualifyFires()
    and not fixable()
  }
  reachable CoreSilentUnderAlways {
    configured
    and kind == PackageLevelDecl
    and canPrefix
    and isCore
    and not exported
    and alwaysWithoutNamespace()
    and not qualifyFires()
  }
  reachable MembersAreNeverNamed {
    configured
    and kind == Member
    and prefixableNamespace()
    and not exported
    and alwaysWithoutNamespace()
    and not qualifyFires()
  }
  // A method written beside its type: func (u user) greet() in user.go.
  reachable ColocatedMethodNeverNamed {
    configured
    and kind == ColocatedMethod
    and prefixableNamespace()
    and not exported
    and alwaysWithoutNamespace()
    and not qualifyFires()
  }
  // The same method, filed in query.go while its type is in statement.go.
  reachable ForeignMethodNamed {
    configured
    and kind == ForeignMethod
    and prefixableNamespace()
    and not exported
    and alwaysWithoutNamespace()
    and qualifyFires()
  }
  // func main in package main. It is unexported, and still silent.
  reachable ToolchainNameSilentUnderAlways {
    configured
    and kind == ToolchainFunc
    and prefixableNamespace()
    and not exported
    and alwaysWithoutNamespace()
    and not qualifyFires()
  }
  // TestGreet in user_test.go. It is exported. It is silent even with
  // rules.naming.exported on, which would otherwise reach it.
  reachable TestFunctionSilentUnderExportedNames {
    configured
    and kind == ToolchainFunc
    and prefixableNamespace()
    and exported
    and namingExported
    and alwaysWithoutNamespace()
    and not qualifyFires()
  }
  reachable UnprefixableNamespaceNeverNamed {
    configured
    and kind == PackageLevelDecl
    and not canPrefix
    and not isCore
    and not exported
    and alwaysWithoutNamespace()
    and not qualifyFires()
  }
  reachable OnDemandSilentInSingleNamespace {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and not exported
    and qualifyMode == OnDemand
    and not manyNamespaces
    and namespaceInName == Absent
    and not qualifyFires()
  }
  reachable NeverSilent {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and not exported
    and qualifyMode == Never
    and namespaceInName == Absent
    and not qualifyFires()
  }
  // ondemand with a second namespace. declscope holds itself to this setting
  // (.declscope-strict.yaml). The shipped default is Never, and NeverSilent
  // above is its silence. So this is the combination that a codebase opting
  // in actually runs under. Without this witness, nothing exercises it.
  reachable OnDemandBitesWithSecondNamespace {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and not exported
    and qualifyMode == OnDemand
    and manyNamespaces
    and namespaceInName == Absent
    and qualifyFires()
  }
  // rules.naming.exported and the ondemand namespace count are independent
  // gates. Widening the rule to exported names does not change *when* the
  // namespace is required.
  reachable ExportedNamesBiteUnderAlwaysSingleNamespace {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and exported
    and namingExported
    and alwaysWithoutNamespace()
    and not manyNamespaces
    and qualifyFires()
  }
  reachable ExportedNamesSilentInSingleNamespace {
    configured
    and kind == PackageLevelDecl
    and prefixableNamespace()
    and exported
    and namingExported
    and qualifyMode == OnDemand
    and not manyNamespaces
    and namespaceInName == Absent
    and not qualifyFires()
  }
  // Reported, with the rename withheld for a reason other than exportedness.
  reachable ReportedWithRenameWithheld {
    configured
    and qualifyFires()
    and not exported
    and not renameGuardPasses
    and not fixable()
  }
  // Without this, the fix need never record itself. Then a model where no
  // fix is applied satisfies every property about what a fix settles.
  reachable FixApplied { fixed }

  // The default. The rule fires, the guard would allow the rename, and the
  // switch is off. The report stands with no fix offered.
  reachable ReportedWithFixOff {
    configured
    and not namingFixOn
    and qualifyFires()
    and fixable()
    and not fixOffered()
  }
  // A pass under the default leaves the violation in place. Nothing is
  // renamed.
  reachable FixOffLeavesTheReport {
    reportedWithoutFix
    and not namingFixOn
    and qualifyFires()
    and fixable()
    and not fixed
  }
  // The stall itself. The leadsTo below has to escape this state. Without
  // these witnesses nothing reads reportedWithoutFix. Then the assignment
  // that records it could be deleted, and no verdict would move.
  reachable ViolationSurvivesAPassWithoutFix {
    reportedWithoutFix and qualifyFires() and fixOffered()
  }
  reachable WithheldRenameSurvivesAPass {
    reportedWithoutFix and qualifyFires() and not fixable()
  }

  leadsTo QualifyEventuallyFixed {
    configured and qualifyFires() and fixOffered()
      ~> not qualifyFires()
    helpful fixQualify()
    decreases if qualifyFires() then 1 else 0
  }
}
