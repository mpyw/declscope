// Soundness of the rename fix.
//
// A rename is correct when every reference still resolves to the same object
// afterwards. Go resolves a name from the inside out: local scope, then file
// scope (imports), then package scope, then the universe of predeclared names.
// The guard modeled here checks package scope only; the counterexamples
// enumerate the further scopes a sound guard must check.
//
// ASSUME-1: names reduce to Old / New / Other, since only the presence of a
//   collision matters, not the spelling (modelling assumption)
// ASSUME-2: two reference sites are modeled — one that referred to the
//   declaration, and one elsewhere in the package that already used the new
//   name. Soundness over more sites is the conjunction over each (modelling
//   assumption)
fsl 5
spec RenameSound {
  enum Name    { OldName, NewName, OtherName }
  // What a scope binds the name to, if anything.
  enum Binding { Unbound, BindsOld, BindsNew, BindsOther }
  // Where a reference to a name resolves.
  enum Resolution {
    ToDeclaration,       // The declaration being renamed
    ToLocal,             // A local, parameter, result or type parameter
    ToImport,            // An import of the file
    ToOtherDeclaration,  // Another package-scope declaration
    ToPredeclared,       // The universe: len, error, string, ...
    Unresolved
  }

  state {
    configured:              Bool = false,
    declarationName:         Name = OldName,      // The declaration's current name
    localBinding:            Binding = Unbound,   // What the innermost scope at the reference binds
    importBinding:           Binding = Unbound,   // What that file's imports bind
    otherDeclarationBinding: Binding = Unbound,   // What another package-scope declaration binds
    newNameIsPredeclared:    Bool = false,        // NewName is predeclared (len, error, string, ...)
    renamed:                 Bool = false,
    // What a second site elsewhere in the package resolved NewName to before
    // the rename. Captured so the rename can be checked not to capture it.
    elsewhereResolvedBefore: Resolution = Unresolved
  }

  action configure(local: Binding, imported: Binding, otherDeclaration: Binding,
                   predeclared: Bool) {
    requires not configured
    configured = true
    localBinding = local
    importBinding = imported
    otherDeclarationBinding = otherDeclaration
    newNameIsPredeclared = predeclared
  }

  def bindingOf(name: Name) =
    if name == OldName then BindsOld
    else if name == NewName then BindsNew
    else BindsOther

  // Resolution from the reference site, innermost scope first.
  def resolveAtReference(name: Name) =
    if localBinding == bindingOf(name) then ToLocal
    else if importBinding == bindingOf(name) then ToImport
    else if otherDeclarationBinding == bindingOf(name) then ToOtherDeclaration
    else if name == declarationName then ToDeclaration
    else if name == NewName and newNameIsPredeclared then ToPredeclared
    else Unresolved

  // A second site elsewhere in the package, with no local or import binding of
  // its own, resolving NewName.
  def resolveElsewhere() =
    if otherDeclarationBinding == BindsNew then ToOtherDeclaration
    else if declarationName == NewName then ToDeclaration
    else if newNameIsPredeclared then ToPredeclared
    else Unresolved

  // The guard modeled here: package scope only.
  def guardPackageScopeOnly() = otherDeclarationBinding != BindsNew

  fair action rename() {
    requires configured
    requires not renamed
    requires declarationName == OldName
    // The reference resolves correctly before
    requires resolveAtReference(OldName) == ToDeclaration
    requires guardPackageScopeOnly()
    declarationName = NewName
    renamed = true
    // Reads the pre-rename state
    elsewhereResolvedBefore = resolveElsewhere()
  }

  // Soundness, part one: the reference to the declaration must still reach it.
  invariant RenameKeepsReferenceOnTarget {
    renamed => resolveAtReference(NewName) == ToDeclaration
  }

  // Soundness, part two: a reference that already used the new name elsewhere
  // must not be captured by the renamed declaration. A package-level name
  // legitimately shadows the universe, so the first invariant stays silent
  // here — the harm falls on everything else that wanted the predeclared name.
  invariant RenameCapturesNothingElsewhere {
    renamed
      and elsewhereResolvedBefore != Unresolved
      => resolveElsewhere() == elsewhereResolvedBefore
  }

  reachable RenameHappens { renamed }
}
