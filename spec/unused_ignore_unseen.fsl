// The unused rule on a declaration's //declscope:ignore. It is judged over the
// two build configurations a repository runs the analyzer under (#168, #172).
//
// unused_ignore.fsl decides which ignore answers another's report within one
// pass. This spec decides what a pass may call silenced when it cannot read
// every file of the package. One file of the package is behind a build
// constraint. The configuration In reads it. Out leaves it out, and reads it
// for names only (unseenFiles.names).
//
// The ignore reaches a declaration. It is written on the declaration, or at
// the file level. A file-level ignore reaches every declaration of its file.
// What it covers:
//
//   Boundary  boundary, named or bare. It silences a crossing into the
//             declaration from another namespace. A crossing is made where
//             the declaration is used. So it can be in the constrained file
//   Other     only rules judged on the declaration itself, such as qualify.
//             Every configuration judges these alike
//
// What there is to silence:
//
//   seenCross      a crossing in a file that every configuration reads
//   unseenNamed    a crossing in the constrained file that writes the
//                  declaration's name. Only In sees it
//   unseenUnkeyed  a crossing in the constrained file into a field. An
//                  unkeyed literal makes it and fills the field by position.
//                  The literal writes a type name that it fills the field
//                  through. It does not write the field's name
//   names          the constrained file writes the declaration's name. Out
//                  reads that much. A crossing by name needs it. A name alone
//                  may be no crossing at all. It may be a local of that name,
//                  or a use from the declaration's own namespace
//   field          the declaration is a struct field
//   typeNames      the constrained file writes a type name of the package
//                  that an unkeyed literal fills the field through. That is
//                  its struct, an alias of it, a type defined over it, a
//                  named pointer to it, or a constraint whose type set holds
//                  it
//   fires          the Other finding fires
//
// Out keeps a Boundary ignore that the unseen file may answer
// (collection.ignoreMayCrossUnseen). That is when the file writes the
// declaration's name, or, for a field, one of the typeNames. In reads that
// file, and may find there the crossing the ignore answers. Those names alone
// decide. So a name written from the declaration's own namespace keeps the
// ignore too. A keyed literal of the type keeps it as well. In reads every
// file, and reports such an ignore where nothing crosses. A pass may be
// unable to read a file at all, or may miss in-package tests. That pass
// stands the whole check down instead (unseenFiles.all). That case is outside
// this model.
//
// What must hold is the same as for shrink_ignore.fsl. One ignore passes both
// runs where either run needs it. A stale ignore is still reported by one of
// them.
//
// ASSUME-1: one constrained file is enough. In reads it, and Out leaves it
//   out (modelling assumption)
// ASSUME-2: the ignore silences nothing else. What else it may silence is
//   unused_ignore.fsl's subject. So is which other ignore may answer its
//   report
fsl 5
spec UnusedIgnoreUnseen {
  enum Rule { Boundary, Other }

  state {
    phase: 0..3 = 0,
    rule: Rule = Boundary,
    seenCross: Bool = false,
    unseenNamed: Bool = false,
    unseenUnkeyed: Bool = false,
    names: Bool = false,
    field: Bool = false,
    typeNames: Bool = false,
    fires: Bool = false,
    // silencedIn and silencedOut: the run has a finding for the ignore to
    // silence. unusedIn and unusedOut: the run reports the ignore unused.
    silencedIn: Bool = false,
    silencedOut: Bool = false,
    unusedIn: Bool = false,
    unusedOut: Bool = false
  }

  action configure(r: Rule, sc: Bool, un: Bool, uu: Bool, n: Bool, fd: Bool, tn: Bool, f: Bool) {
    requires phase == 0
    // A crossing by name writes the declaration's name there. An unkeyed
    // crossing fills a field, and writes one of its typeNames.
    requires not un or n
    requires not uu or (fd and tn)
    phase = 1
    rule = r
    seenCross = sc
    unseenNamed = un
    unseenUnkeyed = uu
    names = n
    field = fd
    typeNames = tn
    fires = f
  }

  // What each run has for the ignore to silence.
  def hasIn()  = if rule == Boundary then seenCross or unseenNamed or unseenUnkeyed else fires
  def hasOut() = if rule == Boundary then seenCross else fires
  // Out keeps a Boundary ignore that the unseen file may answer.
  def keptOut() = rule == Boundary and (names or (field and typeNames))

  fair action judgeIn() {
    requires phase == 1
    phase = 2
    silencedIn = hasIn()
    unusedIn = not hasIn()
  }
  fair action judgeOut() {
    requires phase == 2
    phase = 3
    silencedOut = hasOut()
    unusedOut = not hasOut() and not keptOut()
  }

  def needed() = silencedIn or silencedOut

  // --- the two properties -------------------------------------------------------
  invariant OnePassesEvery { (phase == 3 and needed()) => not unusedIn and not unusedOut }
  invariant StaleIsCaught  { (phase == 3 and not needed()) => unusedIn or unusedOut }

  // --- per run ------------------------------------------------------------------
  invariant SilencingIsUseIn  { (phase >= 2 and silencedIn) => not unusedIn }
  invariant SilencingIsUseOut { (phase == 3 and silencedOut) => not unusedOut }
  // In reads every file. So it keeps nothing it does not silence.
  invariant InKeepsNothing    { phase >= 2 => (unusedIn == not silencedIn) }
  // Out keeps only a Boundary ignore whose declaration the unseen file names.
  // For a field, it also keeps one whose type the file names. Expanded, not
  // routed through keptOut(). Then a mutation of the guard moves one side
  // only, and the invariant can fail.
  invariant OutKeepsOnlyWrittenBoundary {
    (phase == 3 and not silencedOut and not unusedOut)
    => (rule == Boundary and (names or (field and typeNames)))
  }
  // The rules judged on the declaration are judged alike in both runs.
  invariant OtherIsConfigurationFree {
    (phase == 3 and rule == Other) => (unusedIn == unusedOut)
  }

  // Auxiliary. Each run records its judgment of inputs that are never
  // assigned again.
  invariant UnseenNamedIsNamed { unseenNamed => names }
  invariant UnseenUnkeyedIsAField { unseenUnkeyed => (field and typeNames) }
  invariant InRecordsItsJudgment {
    phase >= 2 => (silencedIn == hasIn() and unusedIn == not hasIn())
  }
  invariant OutRecordsItsJudgment {
    phase == 3
    => (silencedOut == hasOut() and unusedOut == (not hasOut() and not keptOut()))
  }
  invariant JudgedInFirst { (silencedIn or unusedIn) => phase >= 2 }
  invariant JudgedOutLast { (silencedOut or unusedOut) => phase == 3 }

  // --- witnesses ------------------------------------------------------------------
  // #168: the only crossing is behind the tag. In silences it, and Out keeps
  // the ignore for In.
  reachable UnseenCrossingKept {
    phase == 3
    and rule == Boundary
    and not seenCross
    and unseenNamed
    and not unseenUnkeyed
    and silencedIn
    and not silencedOut
    and not unusedIn
    and not unusedOut
  }
  // #172: the only crossing is an unkeyed literal behind the tag. It writes
  // the field's type and not the field. Out keeps the ignore for In.
  reachable UnkeyedCrossingKept {
    phase == 3
    and rule == Boundary
    and not seenCross
    and not unseenNamed
    and unseenUnkeyed
    and not names
    and silencedIn
    and not silencedOut
    and not unusedIn
    and not unusedOut
  }
  // The constrained file writes a field's type in a keyed literal that sets
  // other fields. Out keeps the ignore. In reads the file, and reports it.
  reachable TypeNameWithoutCrossingCaughtIn {
    phase == 3
    and rule == Boundary
    and field
    and typeNames
    and not names
    and not seenCross
    and not unseenNamed
    and not unseenUnkeyed
    and unusedIn
    and not unusedOut
  }
  // The constrained file names the declaration without crossing. Out keeps
  // the ignore. In reads the file, and reports it.
  reachable NameWithoutCrossingCaughtIn {
    phase == 3
    and rule == Boundary
    and not seenCross
    and not unseenNamed
    and not unseenUnkeyed
    and names
    and unusedIn
    and not unusedOut
  }
  // Nothing names it. Both runs report a stale ignore.
  reachable StaleReportedByBoth {
    phase == 3
    and rule == Boundary
    and not seenCross
    and not names
    and not typeNames
    and unusedIn
    and unusedOut
  }
  // A crossing that every configuration sees. Both runs use the ignore.
  reachable SeenCrossingUsedByBoth {
    phase == 3
    and rule == Boundary
    and seenCross
    and silencedIn
    and silencedOut
  }
  // An ignore of another rule is judged on the declaration, names or not.
  reachable OtherNamedStillReported {
    phase == 3
    and rule == Other
    and names
    and not fires
    and unusedIn
    and unusedOut
  }

  leadsTo BothRunsJudge {
    phase >= 1 ~> phase == 3
    decreases 3 - phase
  }
}
