// The unused rule on a declaration's //declscope:ignore. It is judged over the
// two build configurations a repository runs the analyzer under (#168, #172).
//
// unused_ignore.fsl decides which ignore answers another's report within one
// pass. This spec decides what a pass may call silenced when it cannot read
// every file of the package. One file of the package is behind a build
// constraint. The configuration In reads it. Out leaves it out, and reads it
// for names only (unseenFiles.names).
//
// The ignore reaches a declaration. It is written on the declaration, or at
// the file level. A file-level ignore reaches every declaration of its file.
// What it covers:
//
//   Boundary  boundary, named or bare. It silences a crossing into the
//             declaration from another namespace. A crossing is made where
//             the declaration is used. So it can be in the constrained file
//   Surplus   surplus, named or bare. It is judged on the declaration. But
//             a constrained file that writes any name of the package stands
//             the rule down for the whole package in Out. In judges it
//   Other     only rules judged on the declaration itself, such as qualify.
//             Every configuration judges these alike
//
// What there is to silence:
//
//   seenCrossing              a crossing in a file that every
//                             configuration reads
//   unseenCrossingByName      a crossing in the constrained file that
//                             writes the declaration's name. Only In sees
//                             it
//   unseenCrossingByPosition  a crossing in the constrained file into a
//                             field. An unkeyed literal makes it and fills
//                             the field by position. The literal writes a
//                             type name that it fills the field through.
//                             It does not write the field's name
//   writesName                the constrained file writes the declaration's
//                             name. Out reads that much. A crossing by name
//                             needs it. A name alone may be no crossing at
//                             all. It may be a local of that name, or a use
//                             from the declaration's own namespace
//   isField                   the declaration is a struct field
//   writesTypeName            the constrained file writes a type name of the
//                             package that an unkeyed literal fills the
//                             field through. That is its struct, an alias
//                             of it, a type defined over it, a named pointer
//                             to it, a constraint whose type set holds it,
//                             or a container (below)
//   throughContainer          the type name written is a slice, array or map
//                             type that holds the struct as an element or a
//                             key, at any depth, behind a pointer or not. The
//                             literal is written as Items{{1}}. The inner
//                             literal leaves its type out and fills the field
//                             by position. Only Items is written
//   writesAnyName             the constrained file writes some name of the
//                             package. Any name stands surplus down in Out
//   surplusFires              In's surplus finding on the declaration fires
//   otherFires                the Other finding fires
//
// Out keeps a Boundary ignore that the unseen file may answer
// (collection.ignoreMayCrossUnseen). That is when the file writes the
// declaration's name, or, for a field, one of those type names. In reads that
// file, and may find there the crossing the ignore answers. Those names alone
// decide. So a name written from the declaration's own namespace keeps the
// ignore too. A keyed literal of the type keeps it as well. In reads every
// file, and reports such an ignore where nothing crosses.
//
// Out keeps a Surplus ignore while the constrained file stands the rule down
// there (collection.surplusBlindOnlyToExcluded). In judges the rule, and
// reports the ignore where the rule finds nothing. Other sources that stand
// surplus down, such as cgo or assembly, stand it down in every
// configuration. They are outside this model. A pass may be
// unable to read a file at all, or may miss in-package tests. That pass
// stands the whole check down instead (unseenFiles.all). That case is outside
// this model.
//
// What must hold is the same as for shrink_ignore.fsl. One ignore passes both
// runs where either run needs it. A stale ignore is still reported by one of
// them.
//
// ASSUME-1: one constrained file is enough. In reads it, and Out leaves it
//   out (modelling assumption)
// ASSUME-2: the ignore silences nothing else. What else it may silence is
//   unused_ignore.fsl's subject. So is which other ignore may answer its
//   report
fsl 5
spec UnusedIgnoreUnseen {
  enum Rule { Boundary, Surplus, Other }

  state {
    phase: 0..3 = 0,
    rule: Rule = Boundary,
    seenCrossing: Bool = false,
    unseenCrossingByName: Bool = false,
    unseenCrossingByPosition: Bool = false,
    writesName: Bool = false,
    isField: Bool = false,
    writesTypeName: Bool = false,
    throughContainer: Bool = false,
    writesAnyName: Bool = false,
    surplusFires: Bool = false,
    otherFires: Bool = false,
    // silencedIn and silencedOut: the run has a finding for the ignore to
    // silence. unusedIn and unusedOut: the run reports the ignore unused.
    silencedIn: Bool = false,
    silencedOut: Bool = false,
    unusedIn: Bool = false,
    unusedOut: Bool = false
  }

  action configure(givenRule: Rule,
                   givenSeenCrossing: Bool,
                   givenUnseenCrossingByName: Bool,
                   givenUnseenCrossingByPosition: Bool,
                   givenWritesName: Bool,
                   givenIsField: Bool,
                   givenWritesTypeName: Bool,
                   givenThroughContainer: Bool,
                   givenWritesAnyName: Bool,
                   givenSurplusFires: Bool,
                   givenOtherFires: Bool) {
    requires phase == 0
    // A crossing by name writes the declaration's name there. An unkeyed
    // crossing fills a field, and writes one of the field's type names.
    requires not givenUnseenCrossingByName or givenWritesName
    requires not givenUnseenCrossingByPosition or (givenIsField and givenWritesTypeName)
    // A container is one of the type names.
    requires not givenThroughContainer or givenWritesTypeName
    // The declaration's name and its type names are names of the package.
    requires not givenWritesName or givenWritesAnyName
    requires not givenWritesTypeName or givenWritesAnyName
    phase = 1
    rule = givenRule
    seenCrossing = givenSeenCrossing
    unseenCrossingByName = givenUnseenCrossingByName
    unseenCrossingByPosition = givenUnseenCrossingByPosition
    writesName = givenWritesName
    isField = givenIsField
    writesTypeName = givenWritesTypeName
    throughContainer = givenThroughContainer
    writesAnyName = givenWritesAnyName
    surplusFires = givenSurplusFires
    otherFires = givenOtherFires
  }

  // What each run has for the ignore to silence.
  def inHasFinding() =
    if rule == Boundary then seenCrossing or unseenCrossingByName or unseenCrossingByPosition
    else if rule == Surplus then surplusFires
    else otherFires
  // Out judges surplus only where the constrained file writes no name. That
  // file then holds no use, so Out finds what In finds.
  def outHasFinding() =
    if rule == Boundary then seenCrossing
    else if rule == Surplus then surplusFires and not writesAnyName
    else otherFires
  // Out keeps a Boundary ignore that the unseen file may answer, and a
  // Surplus ignore while that file stands the rule down.
  def outKeeps() =
    (rule == Boundary and (writesName or (isField and writesTypeName)))
    or (rule == Surplus and writesAnyName)

  fair action judgeIn() {
    requires phase == 1
    phase = 2
    silencedIn = inHasFinding()
    unusedIn = not inHasFinding()
  }
  fair action judgeOut() {
    requires phase == 2
    phase = 3
    silencedOut = outHasFinding()
    unusedOut = not outHasFinding() and not outKeeps()
  }

  def needed() = silencedIn or silencedOut

  // --- the two properties -------------------------------------------------------
  invariant OnePassesEvery { (phase == 3 and needed()) => not unusedIn and not unusedOut }
  invariant StaleIsCaught  { (phase == 3 and not needed()) => unusedIn or unusedOut }

  // --- per run ------------------------------------------------------------------
  invariant SilencingIsUseIn  { (phase >= 2 and silencedIn) => not unusedIn }
  invariant SilencingIsUseOut { (phase == 3 and silencedOut) => not unusedOut }
  // In reads every file. So it keeps nothing it does not silence.
  invariant InKeepsNothing    { phase >= 2 => (unusedIn == not silencedIn) }
  // Out keeps only a Boundary ignore whose declaration the unseen file names.
  // For a field, it also keeps one whose type the file names. Besides those,
  // it keeps only a Surplus ignore while the unseen file stands the rule
  // down. Expanded, not routed through outKeeps(). Then a mutation of the
  // guard moves one side only, and the invariant can fail.
  invariant OutKeepsOnlyWrittenBoundary {
    (phase == 3 and not silencedOut and not unusedOut)
    => ((rule == Boundary and (writesName or (isField and writesTypeName)))
        or (rule == Surplus and writesAnyName))
  }
  // The rules judged on the declaration are judged alike in both runs.
  invariant OtherIsConfigurationFree {
    (phase == 3 and rule == Other) => (unusedIn == unusedOut)
  }

  // Auxiliary. Each run records its judgment of inputs that are never
  // assigned again.
  invariant UnseenNamedIsNamed { unseenCrossingByName => writesName }
  invariant UnseenUnkeyedIsAField { unseenCrossingByPosition => (isField and writesTypeName) }
  invariant ContainerIsATypeName { throughContainer => writesTypeName }
  invariant WrittenNamesAreNames { (writesName or writesTypeName) => writesAnyName }
  invariant InRecordsItsJudgment {
    phase >= 2 => (silencedIn == inHasFinding() and unusedIn == not inHasFinding())
  }
  invariant OutRecordsItsJudgment {
    phase == 3
    => (silencedOut == outHasFinding() and unusedOut == (not outHasFinding() and not outKeeps()))
  }
  invariant JudgedInFirst { (silencedIn or unusedIn) => phase >= 2 }
  invariant JudgedOutLast { (silencedOut or unusedOut) => phase == 3 }

  // --- witnesses ------------------------------------------------------------------
  // #168: the only crossing is behind the tag. In silences it, and Out keeps
  // the ignore for In.
  reachable UnseenCrossingKept {
    phase == 3
    and rule == Boundary
    and not seenCrossing
    and unseenCrossingByName
    and not unseenCrossingByPosition
    and silencedIn
    and not silencedOut
    and not unusedIn
    and not unusedOut
  }
  // #172: the only crossing is an unkeyed literal behind the tag. It writes
  // the field's type and not the field. Out keeps the ignore for In.
  reachable UnkeyedCrossingKept {
    phase == 3
    and rule == Boundary
    and not seenCrossing
    and not unseenCrossingByName
    and unseenCrossingByPosition
    and not writesName
    and silencedIn
    and not silencedOut
    and not unusedIn
    and not unusedOut
  }
  // The same through a container. The file writes Items{{1}}, and the inner
  // literal fills the field by position. Out keeps the ignore for In.
  reachable ContainerCrossingKept {
    phase == 3
    and rule == Boundary
    and not seenCrossing
    and not unseenCrossingByName
    and unseenCrossingByPosition
    and throughContainer
    and not writesName
    and silencedIn
    and not unusedOut
  }
  // The constrained file writes a field's type in a keyed literal that sets
  // other fields. Out keeps the ignore. In reads the file, and reports it.
  reachable TypeNameWithoutCrossingCaughtIn {
    phase == 3
    and rule == Boundary
    and isField
    and writesTypeName
    and not writesName
    and not seenCrossing
    and not unseenCrossingByName
    and not unseenCrossingByPosition
    and unusedIn
    and not unusedOut
  }
  // The constrained file names the declaration without crossing. Out keeps
  // the ignore. In reads the file, and reports it.
  reachable NameWithoutCrossingCaughtIn {
    phase == 3
    and rule == Boundary
    and not seenCrossing
    and not unseenCrossingByName
    and not unseenCrossingByPosition
    and writesName
    and unusedIn
    and not unusedOut
  }
  // Nothing names it. Both runs report a stale ignore.
  reachable StaleReportedByBoth {
    phase == 3
    and rule == Boundary
    and not seenCrossing
    and not writesName
    and not writesTypeName
    and unusedIn
    and unusedOut
  }
  // A crossing that every configuration sees. Both runs use the ignore.
  reachable SeenCrossingUsedByBoth {
    phase == 3
    and rule == Boundary
    and seenCrossing
    and silencedIn
    and silencedOut
  }
  // The constrained file stands surplus down in Out. In reads it, judges the
  // rule, and the ignore silences its finding. Out keeps the ignore for In.
  reachable SurplusKeptWhileStoodDown {
    phase == 3
    and rule == Surplus
    and writesAnyName
    and surplusFires
    and silencedIn
    and not silencedOut
    and not unusedIn
    and not unusedOut
  }
  // The same, where In finds nothing for the ignore to silence. In reports
  // it.
  reachable SurplusStaleCaughtIn {
    phase == 3
    and rule == Surplus
    and writesAnyName
    and not surplusFires
    and unusedIn
    and not unusedOut
  }
  // The constrained file writes no name. Both runs judge surplus alike.
  reachable SurplusJudgedAlikeWithoutNames {
    phase == 3
    and rule == Surplus
    and not writesAnyName
    and surplusFires
    and silencedIn
    and silencedOut
  }

  // An ignore of another rule is judged on the declaration, names or not.
  reachable OtherNamedStillReported {
    phase == 3
    and rule == Other
    and writesName
    and not otherFires
    and unusedIn
    and unusedOut
  }

  leadsTo BothRunsJudge {
    phase >= 1 ~> phase == 3
    decreases 3 - phase
  }
}
