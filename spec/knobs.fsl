// Every configuration key and every directive level must demonstrably change an
// outcome.
//
// An unwitnessed reachable means the level does not bite in that direction — a
// dead knob, and a lie in the documentation.
//
// Scope is two-valued: declscope's subject is the unexported surface of a
// package, so an exported symbol is never bounded by a namespace and `public`
// would name a distinction the analysis cannot make.
//
// Resolution order: declaration > enclosing type (members only) > file > config.
spec Knobs {
  enum Scope { Package, Private }
  enum Kind  { Pkg, Member }
  enum Dir   { NoDir, DirPackage, DirPrivate }
  enum Refs  { NoRefs, SameNs, CrossNs }

  state {
    configured: Bool, cfgUnexported: Scope,
    kind: Kind, exported: Bool,
    declDir: Dir, typeDir: Dir, fileDir: Dir,
    refs: Refs
  }
  init {
    configured = false  cfgUnexported = Private
    kind = Pkg  exported = false
    declDir = NoDir  typeDir = NoDir  fileDir = NoDir
    refs = NoRefs
  }
  action configure(u: Scope, k: Kind, x: Bool, dd: Dir, td: Dir, fd: Dir, r: Refs) {
    requires not configured
    configured = true  cfgUnexported = u
    kind = k  exported = x
    declDir = dd  typeDir = td  fileDir = fd
    refs = r
  }

  // The enclosing type's directive reaches members only.
  def inherited() = if kind == Member then typeDir else NoDir

  def effScope() =
    if declDir == DirPackage then Package
    else if declDir == DirPrivate then Private
    else if inherited() == DirPackage then Package
    else if inherited() == DirPrivate then Private
    else if fileDir == DirPackage then Package
    else if fileDir == DirPrivate then Private
    else cfgUnexported

  // An exported symbol is outside the subject: it carries no boundary.
  def subject() = not exported
  def boundaryFires() = subject() and effScope() == Private and refs == CrossNs

  // Does defaults.unexported bite, in both directions, for each kind?
  // The kind is pinned in each: a semantics under which members did not resolve
  // from defaults would still satisfy a reachable that left it free.
  reachable ConfigBitesOnPkg {
    configured and kind == Pkg and cfgUnexported == Private and declDir == NoDir
    and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable ConfigBitesOnMembers {
    configured and kind == Member and cfgUnexported == Private and declDir == NoDir
    and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable ConfigSilencesPkg {
    configured and kind == Pkg and cfgUnexported == Package and declDir == NoDir
    and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and not boundaryFires()
  }
  reachable ConfigSilencesMembers {
    configured and kind == Member and cfgUnexported == Package and declDir == NoDir
    and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and not boundaryFires()
  }
  // Does the file-level directive override the config, in both directions?
  reachable FileDirOverridesToPrivate {
    configured and fileDir == DirPrivate and cfgUnexported == Package
    and declDir == NoDir and typeDir == NoDir
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable FileDirOverridesToPackage {
    configured and fileDir == DirPackage and cfgUnexported == Private
    and declDir == NoDir and typeDir == NoDir
    and not exported and refs == CrossNs and not boundaryFires()
  }
  // Does the enclosing type's directive reach members, over the file level?
  reachable TypeDirReachesMembers {
    configured and kind == Member and typeDir == DirPackage and fileDir == DirPrivate
    and declDir == NoDir and not exported and refs == CrossNs and not boundaryFires()
  }
  // Does the declaration's own directive win over the type's?
  reachable DeclDirBeatsTypeDir {
    configured and kind == Member and declDir == DirPrivate and typeDir == DirPackage
    and not exported and refs == CrossNs and boundaryFires()
  }
  // The type's directive must NOT reach package-level declarations.
  invariant TypeDirIsMemberOnly {
    kind == Pkg => effScope() == (if declDir == DirPackage then Package
                                  else if declDir == DirPrivate then Private
                                  else if fileDir == DirPackage then Package
                                  else if fileDir == DirPrivate then Private
                                  else cfgUnexported)
  }
  // An exported symbol never carries a boundary, whatever is configured.
  invariant ExportedNeverFires { exported => not boundaryFires() }
  // A reference from inside the namespace never crosses a boundary.
  invariant SameNamespaceNeverCrosses { refs == SameNs => not boundaryFires() }
  invariant NoRefsNeverCrosses        { refs == NoRefs => not boundaryFires() }
}
