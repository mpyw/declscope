// Every configuration key and every directive level must demonstrably change an
// outcome, and every restriction must be witnessed by behaviour rather than by
// an invariant that re-spells the definition it guards.
//
// Scope is two-valued: declscope's subject is a package's unexported surface, so
// `public` would name a distinction the analysis cannot make.
//
// A member's exportedness is its own AND its owner type's: an exported field of
// an unexported type is reachable from nobody outside the package, so it stays
// in the subject.
//
// A FIELD is written inside its type's declaration, so the type's directive
// contains it, the way a `var (...)` block contains its specs. A METHOD is an
// ordinary top-level declaration: the file it is written in supplies its
// namespace and its file level, and nothing above it reaches it.
//
// Resolution order: declaration > containing type (fields only) > file > config.
spec Knobs {
  enum Scope { Package, Private }
  enum Kind  { Pkg, Field, Method }
  enum Dir   { NoDir, DirPackage, DirPrivate }
  enum Refs  { NoRefs, SameNs, CrossNs }

  state {
    configured: Bool, cfgUnexported: Scope,
    kind: Kind, exported: Bool, ownerExported: Bool,
    declDir: Dir, blockDir: Dir, typeDir: Dir, fileDir: Dir,
    refs: Refs,
    // reported records that the boundary check fired. Without it every
    // invariant here would be a tautology over the defs: a spec whose only
    // action assigns the whole state at once cannot say anything about
    // reachability. Recording the report makes the guards that produce it
    // load-bearing, which is what an invariant is for.
    reported: Bool
  }
  init {
    configured = false  cfgUnexported = Private
    kind = Pkg  exported = false  ownerExported = false
    declDir = NoDir  blockDir = NoDir  typeDir = NoDir  fileDir = NoDir
    refs = NoRefs  reported = false
  }
  action configure(u: Scope, k: Kind, x: Bool, ox: Bool,
                   dd: Dir, bd: Dir, td: Dir, fd: Dir, r: Refs) {
    requires not configured
    configured = true  cfgUnexported = u
    kind = k  exported = x  ownerExported = ox
    declDir = dd  blockDir = bd  typeDir = td  fileDir = fd
    refs = r
  }

  // Reachable from outside the package: a member needs its owner exported too.
  def reachableOutside() = exported and (kind == Pkg or ownerExported)
  def subject() = not reachableOutside()

  // The type's directive contains its fields, and nothing else.
  def contained() = if kind == Field then typeDir else NoDir

  // A parenthesized var/const/type block reaches only the specs it holds, so
  // only a package-level declaration has one: a field is not a spec of a block,
  // and a method is never in one. Decl.Merge lets a spec's own scope replace the
  // block's, which puts the block directly under the declaration.
  def blockOf() = if kind == Pkg then blockDir else NoDir

  def effScope() =
    if declDir == DirPackage then Package
    else if declDir == DirPrivate then Private
    else if blockOf() == DirPackage then Package
    else if blockOf() == DirPrivate then Private
    else if contained() == DirPackage then Package
    else if contained() == DirPrivate then Private
    else if fileDir == DirPackage then Package
    else if fileDir == DirPrivate then Private
    else cfgUnexported

  def boundaryFires() = subject() and effScope() == Private and refs == CrossNs

  // The three guards internal/report.go applies before a boundary is reported:
  // the subject test, the scope test, and a reference from another namespace.
  // Each invariant below fails if its guard is dropped.
  action reportBoundary() {
    requires configured
    requires subject()
    requires effScope() == Private
    requires refs == CrossNs
    reported = true
  }
  invariant ReportImpliesConfigured    { reported => configured }
  invariant ReachableOutsideNeverFires { reported => not reachableOutside() }
  invariant SameNamespaceNeverCrosses  { reported => refs != SameNs }
  invariant NoRefsNeverCrosses         { reported => refs != NoRefs }
  invariant PackageScopeNeverFires     { reported => effScope() == Private }
  reachable BoundaryReported { reported }

  // --- defaults.unexported bites, per kind, in both directions ---------------
  // The kind is pinned in each: a semantics that resolved one kind differently
  // would still satisfy a reachable that left it free.
  reachable ConfigBitesOnPkg {
    configured and kind == Pkg and cfgUnexported == Private
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable ConfigBitesOnField {
    configured and kind == Field and cfgUnexported == Private
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable ConfigBitesOnMethod {
    configured and kind == Method and cfgUnexported == Private
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable ConfigSilencesPkg {
    configured and kind == Pkg and cfgUnexported == Package
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and not boundaryFires()
  }
  reachable ConfigSilencesField {
    configured and kind == Field and cfgUnexported == Package
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and not exported and refs == CrossNs and not boundaryFires()
  }

  // --- the levels beat one another, each witnessed by a conflict -------------
  reachable DeclDirBeatsFileDir {
    configured and kind == Pkg and declDir == DirPrivate and fileDir == DirPackage
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable DeclDirBeatsTypeDir {
    configured and kind == Field and declDir == DirPrivate and typeDir == DirPackage
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable TypeDirBeatsFileDir {
    configured and kind == Field and declDir == NoDir
    and typeDir == DirPackage and fileDir == DirPrivate
    and not exported and refs == CrossNs and not boundaryFires()
  }
  reachable FileDirBeatsConfig {
    configured and kind == Pkg and declDir == NoDir and typeDir == NoDir
    and fileDir == DirPrivate and cfgUnexported == Package
    and not exported and refs == CrossNs and boundaryFires()
  }

  // --- the type's directive reaches fields and nothing else -----------------
  // Behavioural, not a restatement: the declaration still fires, so a semantics
  // that let the type's directive through would be caught here.
  reachable DeclDirBeatsBlockDir {
    configured and kind == Pkg and declDir == DirPrivate and blockDir == DirPackage
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable BlockDirBeatsFileDir {
    configured and kind == Pkg and declDir == NoDir
    and blockDir == DirPackage and fileDir == DirPrivate
    and not exported and refs == CrossNs and not boundaryFires()
  }
  reachable BlockDirInertOnField {
    configured and kind == Field and blockDir == DirPackage
    and declDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and cfgUnexported == Private and not exported
    and refs == CrossNs and boundaryFires()
  }
  reachable BlockDirInertOnMethod {
    configured and kind == Method and blockDir == DirPackage
    and declDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and cfgUnexported == Private and not exported
    and refs == CrossNs and boundaryFires()
  }
  reachable TypeDirInertOnPkg {
    configured and kind == Pkg and typeDir == DirPackage
    and declDir == NoDir and blockDir == NoDir and fileDir == NoDir and cfgUnexported == Private
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable TypeDirInertOnMethod {
    configured and kind == Method and typeDir == DirPackage
    and declDir == NoDir and blockDir == NoDir and fileDir == NoDir and cfgUnexported == Private
    and not exported and refs == CrossNs and boundaryFires()
  }

  // --- exportedness --------------------------------------------------------
  // An exported declaration is silent even when a directive says private.
  reachable ExportedSilentUnderPrivate {
    configured and kind == Pkg and exported and declDir == DirPrivate
    and refs == CrossNs and not boundaryFires()
  }
  // ... but an exported member of an UNEXPORTED type stays in the subject.
  reachable UnexportedOwnerKeepsExportedField {
    configured and kind == Field and exported and not ownerExported
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir and fileDir == NoDir
    and cfgUnexported == Private and refs == CrossNs and boundaryFires()
  }
  reachable ExportedFieldOfExportedTypeIsSilent {
    configured and kind == Field and exported and ownerExported
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir
    and fileDir == NoDir and cfgUnexported == Private
    and refs == CrossNs and not boundaryFires()
  }
  reachable ExportedMethodOfExportedTypeIsSilent {
    configured and kind == Method and exported and ownerExported
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir
    and fileDir == NoDir and cfgUnexported == Private
    and refs == CrossNs and not boundaryFires()
  }
  reachable UnexportedOwnerKeepsExportedMethod {
    configured and kind == Method and exported and not ownerExported
    and declDir == NoDir and blockDir == NoDir and typeDir == NoDir
    and fileDir == NoDir and cfgUnexported == Private
    and refs == CrossNs and boundaryFires()
  }

}
