// Every configuration key and every directive level must change an outcome.
// The spec must show it. Every restriction must be witnessed by behaviour. An
// invariant that re-spells the definition it guards does not count.
//
// Scope has two values. The default subject of a scope is the unexported
// surface of a package. A `public` scope would name a distinction the
// analysis cannot make.
//
// A MEMBER is written inside the declaration of its type. So the directive of
// the type contains it, the way a `var (...)` block contains its specs. A
// struct field is one kind of member. The method name of an interface is the
// other. A METHOD is an ordinary top-level declaration. The file it is written
// in supplies its namespace and its file level. Nothing above it reaches it.
//
// Resolution order, nearest first:
//
//   1. the declaration
//   2. the var/const/type block (package-level specs only)
//   3. the containing type, and through it the block the type is in (members
//      only)
//   4. the file
//   5. exportedness
//   6. defaults.unexported
fsl 5
spec Knobs {
  enum Scope { Shared, Private }
  // Member is anything written inside the declaration of a type: a struct
  // field, or the method name of an interface. Method is a method with a
  // receiver. It is an ordinary top-level declaration, even though it reads
  // like a member.
  enum Kind  { PackageLevel, Member, Method }
  enum Directive { NoDirective, SharedDirective, PrivateDirective }
  enum ReferencedFrom { Nowhere, SameNamespace, OtherNamespace }

  state {
    configured: Bool = false,
    unexportedDefault: Scope = Private,
    kind: Kind = PackageLevel,
    exported: Bool = false,
    declDirective: Directive = NoDirective,
    blockDirective: Directive = NoDirective,
    typeDirective: Directive = NoDirective,
    fileDirective: Directive = NoDirective,
    referencedFrom: ReferencedFrom = Nowhere,
    // reported records that the boundary check fired. The only other action
    // assigns the whole state at once. Without reported, every invariant here
    // would be a tautology over the defs, and the spec could say nothing about
    // reachability. Recording the report makes its guards load-bearing. That
    // is what an invariant is for.
    reported: Bool = false
  }
  action configure(newUnexportedDefault: Scope, newKind: Kind, newExported: Bool,
                   newDeclDirective: Directive, newBlockDirective: Directive,
                   newTypeDirective: Directive, newFileDirective: Directive,
                   newReferencedFrom: ReferencedFrom) {
    requires not configured
    configured = true
    unexportedDefault = newUnexportedDefault
    kind = newKind
    exported = newExported
    declDirective = newDeclDirective
    blockDirective = newBlockDirective
    typeDirective = newTypeDirective
    fileDirective = newFileDirective
    referencedFrom = newReferencedFrom
  }

  // Exportedness decides the default and nothing else. An exported
  // declaration has no boundary unless a directive gives it one. The
  // rejected alternative asks whether it is reachable from outside the
  // package. A single-package analysis cannot answer that. A type escapes
  // through an exported signature, an embedding, an alias or an interface it
  // satisfies. Guessing produced boundary reports on API that every importer
  // reaches.
  def defaultScope() = if exported then Shared else unexportedDefault

  // The nearer directive if it states a scope. Otherwise the farther one.
  def directiveOr(nearer: Directive, farther: Directive) =
    if nearer != NoDirective then nearer else farther

  // What contains a member: its type, and through the type the var/const/type
  // block the type is declared in. addGenDeclToCollection merges the block
  // into the own directive of the spec. It passes the result as the container
  // of the members. So a block reaches a member. It never reaches a method
  // with a receiver.
  def containerDirective() =
    if kind == Member then directiveOr(typeDirective, blockDirective) else NoDirective

  // A parenthesized var/const/type block reaches only the specs it holds. So
  // only a package-level declaration has one. A member is not a spec of a
  // block, and a method is never in one. Decl.Merge lets the own scope of a
  // spec replace the scope of the block. That puts the block directly under
  // the declaration.
  def blockDirectiveOfSpec() =
    if kind == PackageLevel then blockDirective else NoDirective

  // The scope a directive states. If it states none, the scope from the next
  // level out.
  def scopeOr(directive: Directive, otherwise: Scope) =
    if directive == SharedDirective then Shared
    else if directive == PrivateDirective then Private
    else otherwise

  // The nearest level that states a scope decides it.
  def effectiveScope() =
    scopeOr(declDirective,
      scopeOr(blockDirectiveOfSpec(),
        scopeOr(containerDirective(),
          scopeOr(fileDirective, defaultScope()))))

  // One line on purpose: spec/verify.sh compares the shared scope model up to
  // the line that names this def.
  def boundaryFires() = effectiveScope() == Private and referencedFrom == OtherNamespace

  // No level states a scope, or no level but the one named.
  def nothingStated() =
    declDirective == NoDirective
    and blockDirective == NoDirective
    and typeDirective == NoDirective
    and fileDirective == NoDirective
  def nothingStatedButDecl() =
    blockDirective == NoDirective
    and typeDirective == NoDirective
    and fileDirective == NoDirective
  def nothingStatedButBlock() =
    declDirective == NoDirective
    and typeDirective == NoDirective
    and fileDirective == NoDirective
  def nothingStatedButType() =
    declDirective == NoDirective
    and blockDirective == NoDirective
    and fileDirective == NoDirective
  def nothingStatedButFile() =
    declDirective == NoDirective
    and blockDirective == NoDirective
    and typeDirective == NoDirective

  // internal/finding.go applies two guards before it reports a boundary.
  // findingsOf tests the scope. boundaryFinding asks for a reference from
  // another namespace. Each invariant below fails if its guard is dropped.
  action reportBoundary() {
    requires configured
    requires effectiveScope() == Private
    requires referencedFrom == OtherNamespace
    reported = true
  }
  invariant ReportImpliesConfigured    { reported => configured }
  // An exported declaration is reported only where a directive narrowed it.
  invariant ExportedFiresOnlyWhenStated {
    reported and exported =>
      declDirective == PrivateDirective
      or blockDirectiveOfSpec() == PrivateDirective
      or containerDirective() == PrivateDirective
      or fileDirective == PrivateDirective
  }
  invariant SameNamespaceNeverCrosses  { reported => referencedFrom != SameNamespace }
  invariant NoRefsNeverCrosses         { reported => referencedFrom != Nowhere }
  invariant SharedScopeNeverFires      { reported => effectiveScope() == Private }
  reachable BoundaryReported { reported }

  // --- defaults.unexported bites, per kind, in both directions ---------------
  // Each one pins the kind. A semantics that resolved one kind differently
  // would still satisfy a reachable that left the kind free.
  reachable ConfigBitesOnPkg {
    configured
    and kind == PackageLevel
    and unexportedDefault == Private
    and nothingStated()
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable ConfigBitesOnMember {
    configured
    and kind == Member
    and unexportedDefault == Private
    and nothingStated()
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable ConfigBitesOnMethod {
    configured
    and kind == Method
    and unexportedDefault == Private
    and nothingStated()
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable ConfigSilencesPkg {
    configured
    and kind == PackageLevel
    and unexportedDefault == Shared
    and nothingStated()
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable ConfigSilencesMember {
    configured
    and kind == Member
    and unexportedDefault == Shared
    and nothingStated()
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable ConfigSilencesMethod {
    configured
    and kind == Method
    and unexportedDefault == Shared
    and nothingStated()
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }

  // --- the directives of the declaration and the file bite, per kind --------
  // In each one, that level is the only level stated. The default says the
  // opposite. So the level is the only thing left that can decide. One of
  // these fails under a semantics where the file reaches only package-level
  // declarations. One fails where a method ignores its own directive.
  reachable DeclDirBitesOnMethod {
    configured
    and kind == Method
    and declDirective == PrivateDirective
    and nothingStatedButDecl()
    and unexportedDefault == Shared
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable DeclDirSilencesMethod {
    configured
    and kind == Method
    and declDirective == SharedDirective
    and nothingStatedButDecl()
    and unexportedDefault == Private
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable FileDirBitesOnMember {
    configured
    and kind == Member
    and fileDirective == PrivateDirective
    and nothingStatedButFile()
    and unexportedDefault == Shared
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable FileDirSilencesMember {
    configured
    and kind == Member
    and fileDirective == SharedDirective
    and nothingStatedButFile()
    and unexportedDefault == Private
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable FileDirBitesOnMethod {
    configured
    and kind == Method
    and fileDirective == PrivateDirective
    and nothingStatedButFile()
    and unexportedDefault == Shared
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable FileDirSilencesMethod {
    configured
    and kind == Method
    and fileDirective == SharedDirective
    and nothingStatedButFile()
    and unexportedDefault == Private
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }

  // --- the levels beat one another, each witnessed by a conflict -------------
  reachable DeclDirBeatsFileDir {
    configured
    and kind == PackageLevel
    and declDirective == PrivateDirective
    and fileDirective == SharedDirective
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable DeclDirBeatsTypeDir {
    configured
    and kind == Member
    and declDirective == PrivateDirective
    and typeDirective == SharedDirective
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable TypeDirBeatsFileDir {
    configured
    and kind == Member
    and declDirective == NoDirective
    and typeDirective == SharedDirective
    and fileDirective == PrivateDirective
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  // The block is pinned too. A private block would otherwise decide it, and
  // the file could go unread on a package-level declaration.
  reachable FileDirBeatsConfig {
    configured
    and kind == PackageLevel
    and declDirective == NoDirective
    and blockDirective == NoDirective
    and typeDirective == NoDirective
    and fileDirective == PrivateDirective
    and unexportedDefault == Shared
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }

  // --- the block directive reaches its specs, and members through a type ----
  // It never reaches a method with a receiver. A method is in no block.
  reachable DeclDirBeatsBlockDir {
    configured
    and kind == PackageLevel
    and declDirective == PrivateDirective
    and blockDirective == SharedDirective
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  // A private block alone decides a package-level spec. The default says
  // shared. So a block private that went unread would leave it silent.
  reachable BlockDirBitesOnPkg {
    configured
    and kind == PackageLevel
    and blockDirective == PrivateDirective
    and nothingStatedButBlock()
    and unexportedDefault == Shared
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable BlockDirBeatsFileDir {
    configured
    and kind == PackageLevel
    and declDirective == NoDirective
    and blockDirective == SharedDirective
    and fileDirective == PrivateDirective
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable BlockDirReachesMemberThroughItsType {
    configured
    and kind == Member
    and blockDirective == SharedDirective
    and nothingStatedButBlock()
    and unexportedDefault == Private
    and not exported
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable TypeDirBeatsBlockDirOnMember {
    configured
    and kind == Member
    and declDirective == NoDirective
    and typeDirective == PrivateDirective
    and blockDirective == SharedDirective
    and fileDirective == NoDirective
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable BlockDirInertOnMethod {
    configured
    and kind == Method
    and blockDirective == SharedDirective
    and nothingStatedButBlock()
    and unexportedDefault == Private
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }

  // --- the type directive reaches members and nothing else -------------------
  // These are behavioural, not restatements. The declaration still fires. So
  // a semantics that let the type directive through fails here.
  reachable TypeDirInertOnPkg {
    configured
    and kind == PackageLevel
    and typeDirective == SharedDirective
    and nothingStatedButType()
    and unexportedDefault == Private
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  reachable TypeDirInertOnMethod {
    configured
    and kind == Method
    and typeDirective == SharedDirective
    and nothingStatedButType()
    and unexportedDefault == Private
    and not exported
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }

  // --- exportedness --------------------------------------------------------
  // An exported declaration is silent by default and narrowed when a
  // directive says so. The pair makes exportedness a default, not an
  // exemption. The author can still say what the analysis will not guess.
  reachable ExportedSilentByDefault {
    configured
    and kind == PackageLevel
    and exported
    and declDirective == NoDirective
    and blockDirective == NoDirective
    and fileDirective == NoDirective
    and unexportedDefault == Private
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable ExportedNarrowedWhenStated {
    configured
    and kind == PackageLevel
    and exported
    and declDirective == PrivateDirective
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
  // An exported declaration carries no boundary by default. Its owner and
  // the configuration do not change that. Take a DTO whose members are
  // capitalized for a serializer. A directive on its type protects it, not a
  // guess.
  reachable ExportedMemberSilentByDefault {
    configured
    and kind == Member
    and exported
    and nothingStated()
    and unexportedDefault == Private
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  reachable ExportedMethodSilentByDefault {
    configured
    and kind == Method
    and exported
    and nothingStated()
    and unexportedDefault == Private
    and referencedFrom == OtherNamespace
    and not boundaryFires()
  }
  // The type directive is what brings an exported member back in.
  reachable TypeDirBindsExportedMember {
    configured
    and kind == Member
    and exported
    and typeDirective == PrivateDirective
    and nothingStatedButType()
    and referencedFrom == OtherNamespace
    and boundaryFires()
  }
}
