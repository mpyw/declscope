// Every configuration key must demonstrably change an outcome.
//
// An unwitnessed reachable means the key does not bite in that direction — a
// dead knob, and a lie in the documentation.
spec Knobs {
  enum Scope { Public, Package, FilePriv }
  enum Kind  { Pkg, Member }
  enum Dir   { NoDir, DirPublic, DirPackage, DirFile }
  enum Refs  { NoRefs, SameNs, CrossNs }

  state {
    configured: Bool, cfgExported: Scope, cfgUnexported: Scope,
    kind: Kind, exported: Bool, dir: Dir, refs: Refs
  }
  init {
    configured = false  cfgExported = Public  cfgUnexported = FilePriv
    kind = Pkg  exported = false  dir = NoDir  refs = NoRefs
  }
  action configure(e: Scope, u: Scope, k: Kind, x: Bool, di: Dir, r: Refs) {
    requires not configured
    configured = true  cfgExported = e  cfgUnexported = u
    kind = k  exported = x  dir = di  refs = r
  }
  def effScope() =
    if dir == DirPublic then Public
    else if dir == DirPackage then Package
    else if dir == DirFile then FilePriv
    else if exported then cfgExported
    else cfgUnexported
  def boundaryFires() = effScope() == FilePriv and refs == CrossNs

  // Does defaults.exported reach members?
  reachable ExportedKnobBitesOnMembers {
    configured and kind == Member and exported and dir == NoDir
    and cfgExported == FilePriv and refs == CrossNs and boundaryFires()
  }
  // Does defaults.unexported reach members?
  reachable UnexportedKnobSilencesMembers {
    configured and kind == Member and not exported and dir == NoDir
    and cfgUnexported == Package and refs == CrossNs and not boundaryFires()
  }
  // Does defaults.exported reach package-level declarations?
  reachable ExportedKnobBitesOnPkg {
    configured and kind == Pkg and exported and dir == NoDir
    and cfgExported == FilePriv and refs == CrossNs and boundaryFires()
  }
  // Does a directive override defaults, in both directions?
  reachable DirectiveOverridesToFile {
    configured and dir == DirFile and cfgUnexported == Public
    and not exported and refs == CrossNs and boundaryFires()
  }
  reachable DirectiveOverridesToPackage {
    configured and dir == DirPackage and cfgUnexported == FilePriv
    and not exported and refs == CrossNs and not boundaryFires()
  }
  // A reference from inside the namespace never crosses a boundary.
  invariant SameNamespaceNeverCrosses { refs == SameNs => not boundaryFires() }
  invariant NoRefsNeverCrosses        { refs == NoRefs => not boundaryFires() }
}
