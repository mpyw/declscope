// The unused rule on an ignore directive. It decides which ignore answers the
// report that another ignore is unused. It also shows why no ignore answers
// its own report.
//
// An ignore is unused when it silenced nothing. The report that says so is
// itself a report of the unused rule. So an ignore that covers that rule
// could answer it. An ignore may answer another ignore's report, but never
// its own. An ignore that could exempt itself would never be called unused.
// And this report is written to catch exactly that ignore.
//
// Which ignore answers another depends on the level:
//
//   Declaration  an ignore in the same comment group, when it NAMES the
//                unused rule. A bare //declscope:ignore does not answer here.
//                It sits on every declaration an author wanted quiet. Reading
//                it as an answer would let a whole group of ignores exempt
//                one another.
//   File         another file-level ignore of the same file, when it covers
//                the unused rule, named or bare. A file-level ignore stands a
//                rule down for the whole file. Its own report is the one
//                exception.
//
// An ignore that answers another's report has done a job, so it is used. The
// answer is taken over the ignores that silenced nothing, before any answer
// is counted. So the result does not depend on which ignore is judged first.
// Two ignores that answer each other are both used.
//
// A file-level ignore that covers the unused rule also answers another
// report. That is the report of an ignore on a declaration in its file (F
// below). That report is made and then silenced, so it does not surface.
//
// Out of scope:
//
//   - A second ignore that names the same set of rules as one before it, on
//     one binding or one file. An example is two bare //declscope:ignore at
//     the top of a file. That is a duplicate, the directive rule's report
//     (#211, #242). It is dropped and registers no ignore to judge. So the
//     first is judged as if it were alone. Two bare ignores always name the
//     same set. So configure never puts two bare ignores at one level. Two
//     that name other rules, or that both name unused, stand for two
//     different sets.
//   - An ignore that names a module-wide rule, such as overexported. Also an
//     ignore that may answer its unused report: one beside it that names
//     unused, or one at the file level that covers unused. One pass cannot
//     tell whether such an ignore does its job. So declscope shrink judges it
//     (spec/shrink_ignore.fsl). Every claim here is about the other ignores.
//     NeverExemptsItself is one of those claims.
//
// ASSUME-1: two ignores at one level are enough. A third changes which one
//   answers. It never changes whether an ignore can answer itself (modelling
//   assumption)
// ASSUME-2: F is modelled only beside declaration-level ignores, and only
//   when it covers unused. One that does not cover unused answers nothing. It
//   is judged as the lone file-level ignore is (modelling assumption)
fsl 5
spec UnusedIgnore {
  enum Mode  { Off, Loose, Strict }
  enum Level { Declaration, File }
  // What an ignore's rule list says about the unused rule. It names only
  // other rules, or it names unused, or it is bare and covers every rule.
  enum Names { OtherRules, Unused, Bare }

  state {
    phase: 0..2 = 0,
    mode: Mode = Loose,
    level: Level = Declaration,
    // I is the ignore judged (ignore*). ignoreSilenced: it silenced some
    // finding that is not an unused-ignore report.
    ignoreNames: Names = OtherRules,
    ignoreSilenced: Bool = false,
    // J is another ignore at the same level (other*). That is the same
    // comment group for Declaration, and the same file for File.
    otherPresent: Bool = false,
    otherNames: Names = OtherRules,
    otherSilenced: Bool = false,
    // F is a file-level ignore that covers unused (fileIgnore*). It is in the
    // file of the declaration-level ignores I and J.
    fileIgnorePresent: Bool = false,
    fileIgnoreSilenced: Bool = false,
    ignoreReported: Bool = false,
    otherReported: Bool = false,
    fileIgnoreReported: Bool = false
  }

  action configure(givenMode: Mode,
                   givenLevel: Level,
                   givenIgnoreNames: Names,
                   givenIgnoreSilenced: Bool,
                   givenOtherPresent: Bool,
                   givenOtherNames: Names,
                   givenOtherSilenced: Bool,
                   givenFileIgnorePresent: Bool,
                   givenFileIgnoreSilenced: Bool) {
    requires phase == 0
    // A second bare ignore at one level repeats the first. It is a duplicate.
    requires not (givenOtherPresent and givenIgnoreNames == Bare and givenOtherNames == Bare)
    requires givenFileIgnorePresent => givenLevel == Declaration
    phase = 1
    mode = givenMode
    level = givenLevel
    ignoreNames = givenIgnoreNames
    ignoreSilenced = givenIgnoreSilenced
    otherPresent = givenOtherPresent
    otherNames = givenOtherNames
    otherSilenced = givenOtherSilenced
    fileIgnorePresent = givenFileIgnorePresent
    fileIgnoreSilenced = givenFileIgnoreSilenced
  }

  // Whether an ignore whose rule list says `says` answers another ignore's
  // unused report at this level.
  def answersAt(says: Names) = if level == File then says != OtherRules else says == Unused
  // I answers J's report. That report exists only when J silenced nothing.
  def ignoreAnswersOther() = otherPresent and not otherSilenced and answersAt(ignoreNames)
  def otherAnswersIgnore() = otherPresent and not ignoreSilenced and answersAt(otherNames)
  // F answers every report of I or J. Like the answers between I and J, this
  // is taken over the ignores that silenced nothing.
  def fileIgnoreAnswers() =
    fileIgnorePresent
    and (not ignoreSilenced or (otherPresent and not otherSilenced))

  fair action judge() {
    requires phase == 1
    phase = 2
    ignoreReported =
      mode != Off
      and not ignoreSilenced
      and not ignoreAnswersOther()
      and not otherAnswersIgnore()
      and not fileIgnorePresent
    otherReported =
      mode != Off
      and otherPresent
      and not otherSilenced
      and not otherAnswersIgnore()
      and not ignoreAnswersOther()
      and not fileIgnorePresent
    fileIgnoreReported =
      mode != Off
      and fileIgnorePresent
      and not fileIgnoreSilenced
      and not fileIgnoreAnswers()
  }

  // --- off says nothing ----------------------------------------------------------
  invariant OffReportsNothing {
    mode == Off => not ignoreReported and not otherReported and not fileIgnoreReported
  }

  // --- no ignore exempts itself --------------------------------------------------
  // Alone, an ignore is reported exactly when it silenced nothing. What it
  // names does not matter: unused, or nothing at all. An ignore that names a
  // module-wide rule is left to declscope shrink (see the header).
  invariant NeverExemptsItself {
    (phase == 2 and not otherPresent and not fileIgnorePresent)
    => (ignoreReported == (mode != Off and not ignoreSilenced))
  }
  // F alone, with nothing to answer, is reported like any lone ignore.
  invariant FileNeverExemptsItself {
    (phase == 2 and fileIgnorePresent and ignoreSilenced and not otherPresent)
    => (fileIgnoreReported == (mode != Off and not fileIgnoreSilenced))
  }
  // Silencing something is always a use.
  invariant SilencingIsUse { ignoreSilenced => not ignoreReported }

  // --- answering another is a use, and the answered report is gone -------------
  invariant AnsweringIsUse  { (phase == 2 and ignoreAnswersOther()) => not ignoreReported }
  invariant AnsweredIsQuiet { (phase == 2 and ignoreAnswersOther()) => not otherReported }
  // On a declaration, only an ignore that names unused answers.
  invariant DeclAnswersByName {
    (level == Declaration and ignoreAnswersOther()) => ignoreNames == Unused
  }
  // A file-level ignore that covers unused answers a declaration's ignore.
  invariant FileAnswersDecl {
    (phase == 2 and fileIgnorePresent) => (not ignoreReported and not otherReported)
  }
  invariant FileAnsweringIsUse {
    (phase == 2 and fileIgnorePresent and not ignoreSilenced) => not fileIgnoreReported
  }
  // Two ignores at one level never both name the bare set.
  invariant NoBarePair { (otherPresent and ignoreNames == Bare) => otherNames != Bare }

  // Auxiliary.
  invariant JudgedLast   { (ignoreReported or otherReported or fileIgnoreReported) => phase == 2 }
  invariant JOnlyWhenPresent { otherReported => otherPresent }
  invariant FOnlyWhenPresent { fileIgnoreReported => fileIgnorePresent }
  invariant FOnlyBesideDecl  { fileIgnorePresent => level == Declaration }

  // --- witnesses -------------------------------------------------------------------
  reachable LoneUnusedIgnoreReported {
    phase == 2
    and mode == Loose
    and level == Declaration
    and ignoreNames == Unused
    and not ignoreSilenced
    and not otherPresent
    and ignoreReported
  }
  reachable LoneBareFileIgnoreReported {
    phase == 2
    and mode == Loose
    and level == File
    and ignoreNames == Bare
    and not ignoreSilenced
    and not otherPresent
    and ignoreReported
  }
  // A leftover ignore for another rule, such as directive. It silenced
  // nothing.
  reachable LeftoverIgnoreReported {
    phase == 2
    and mode == Strict
    and ignoreNames == OtherRules
    and not ignoreSilenced
    and not otherPresent
    and ignoreReported
  }
  reachable SiblingNamingUnusedAnswers {
    phase == 2
    and mode == Loose
    and level == Declaration
    and ignoreNames == OtherRules
    and not ignoreSilenced
    and otherPresent
    and otherNames == Unused
    and otherSilenced
    and not ignoreReported
    and not otherReported
  }
  // J silenced something, so it has no report for I to answer. I names
  // unused and silenced nothing. So I is reported.
  reachable NothingToAnswerLeavesIgnoreReported {
    phase == 2
    and mode == Loose
    and level == Declaration
    and ignoreNames == Unused
    and not ignoreSilenced
    and otherPresent
    and otherNames == OtherRules
    and otherSilenced
    and not fileIgnorePresent
    and ignoreReported
  }
  reachable BareSiblingDoesNotAnswer {
    phase == 2
    and mode == Loose
    and level == Declaration
    and ignoreNames == OtherRules
    and not ignoreSilenced
    and otherPresent
    and otherNames == Bare
    and otherSilenced
    and ignoreReported
    and not otherReported
  }
  reachable BareFileIgnoreAnswers {
    phase == 2
    and mode == Loose
    and level == File
    and ignoreNames == OtherRules
    and not ignoreSilenced
    and otherPresent
    and otherNames == Bare
    and not otherSilenced
    and not ignoreReported
    and not otherReported
  }
  reachable FileIgnoreAnswersDecl {
    phase == 2
    and mode == Loose
    and level == Declaration
    and ignoreNames == OtherRules
    and not ignoreSilenced
    and not otherPresent
    and fileIgnorePresent
    and not fileIgnoreSilenced
    and not ignoreReported
    and not fileIgnoreReported
  }
  reachable FileIgnoreWithNothingToAnswerReported {
    phase == 2
    and mode == Loose
    and level == Declaration
    and ignoreSilenced
    and not otherPresent
    and fileIgnorePresent
    and not fileIgnoreSilenced
    and fileIgnoreReported
  }
  reachable OffIsSilent {
    phase == 2
    and mode == Off
    and not ignoreSilenced
    and not otherPresent
    and not ignoreReported
  }
}
