// The unused rule on a scope directive, under each mode of rules.unused.
//
//   off     reports nothing and offers no fix.
//   loose   reports a directive that binds nothing. A directive binds a
//           declaration when it names a scope that the declaration could not
//           have had under ANY configuration.
//   strict  is the default. It also reports a directive that names the scope
//           the declaration would have without it under THIS configuration.
//           An example is //declscope:private on an unexported field of a
//           type that states nothing, while defaults.unexported is private.
//
// The principle is the same as for an unused ignore. A directive that decides
// nothing should not sit in the source and claim to decide something.
//
// The binding test of loose is quantified two ways.
//
//   - Over configurations, so that the report does not read the current
//     configuration. Then a change of defaults.unexported changes no report.
//     A directive that records a deliberate `private` is kept, even when
//     today's default also gives private. LooseIgnoresTheDefault states it.
//     strict gives this up on purpose (StrictReadsTheDefault). So under
//     strict, one line of YAML changes what it reports.
//   - Over enclosing directives, not only exportedness. Suppose the test asked
//     only whether the name is exported. Then it would call
//     //declscope:shared under an enclosing `private` inert. But that
//     directive is the one thing that widens an exported declaration back. So
//     a codebase could narrow and never widen again.
//
// "The next level out" is the level that a deletion would fall through to.
// Take a spec that states its own scope. The first such level is the block's
// directive that the spec overrides. Then comes the type's, for a field. Then
// comes the file's. Skipping the block would judge a spec's private under a
// shared block against the file. It would call that private inert, where
// deleting it widens the spec. outerDirective is the nearest of these levels,
// whichever level that is.
//
// So the scope from the next level out is FIXED in two cases. An outer level
// states one. Or nothing does, and the declaration is exported. (Exported
// carries no boundary under every configuration.) The scope is not fixed when
// defaults.unexported decides, since that may be either scope.
//
// The reach is the declaration the directive sits on (the target), if there
// is one, plus what the directive encloses. Under loose, one binding is
// enough. A nearer directive may shadow an enclosed declaration. Then that
// declaration binds nothing to this directive. The model has two enclosed
// declarations. With one, it could not tell "nothing to bind" from "this one
// had nothing to bind".
//
// strict must not give up safety. Its fix deletes the directive. So the
// deletion must leave every declaration with the scope it had. It must also
// leave every other directive judged as it was. The judgment therefore covers
// everything the directive reaches, shadowed or not:
//
//   taker     a declaration that takes its scope from this directive. Without
//             the directive, it takes the next level out, then exportedness,
//             then defaults.unexported. FixKeepsEveryScope checks it.
//   shadowed  a declaration that a nearer directive shadows. Its scope does
//             not move. But the nearer directive is judged against what the
//             declaration would have without it. Today that is this
//             directive's scope. Once this one is gone, it is the next level
//             out. The two must agree. FixKeepsTheNearerJudgment checks it.
//
// Deleting the directive may change another report, though no scope moves.
// The fix is withheld there:
//
//   crossing      boundary reports, the directive is //declscope:private, and
//                 another namespace uses a taker. Then the taker is reported,
//                 and the boundary message names the level that decided. That
//                 level moves. A file the build excludes is read for its names
//                 alone. So a taker's name written there
//                 (takerCrossesExcluded) counts like a crossing the pass sees
//                 (takerCrosses). For a field, a type name an unkeyed literal
//                 fills it through counts as its name. That is its struct, an
//                 alias of it, a type defined over it, or a named pointer to
//                 it. It is also a constraint whose type set holds it, or a
//                 slice, array or map type that holds it, as in Items{{1}}.
//                 unused_ignore_unseen.fsl lists the same names. Under
//                 //declscope:shared, or with boundary off, there is no
//                 boundary report to change. There a crossing withholds
//                 nothing.
//   ownerWidened  a taker is a field, and a boundary fix in the same run
//                 widens its type. The field would take the type's new
//                 directive.
//   surplusHolds  the directive is //declscope:shared, surplus is loose or
//                 strict, and surplus judges something that depends on the
//                 directive (surplusDepends). Either a taker would join the
//                 dependents of an enclosing directive. Or an ignore answers
//                 the directive's own surplus report, and would be left
//                 answering nothing. surplus never judges a
//                 //declscope:private.
//   outerStuck    the next level out is a directive that is itself reported
//                 and keeps its report. A taker would join it, and its report
//                 would change. One that an ignore answers is judged like any
//                 other. If it is redundant, it stays redundant and answered
//                 once it gains a taker. If it is not redundant, it is stuck.
//   testsUnseen   the pass is the ordinary variant of a package with
//                 in-package tests, or cannot read a file of its folder. A
//                 crossing in a test file (takerCrossesInTests) is one the
//                 pass cannot see. The driver applies the fixes of every
//                 variant. So a deletion that one variant offers is made,
//                 whatever the other withholds. This withholds every fix, not
//                 only one with a crossing.
//
// The model holds the after-state of the scopes, of the nearer directives and
// of the boundary report. It does not model the reports that ownerWidened,
// surplusHolds and outerStuck protect. They are inputs, and only the
// witnesses below pin their guards.
//
// The Go code is judgeAtScopeSite and scopesiteRemovals.decide in
// internal/scopesite.go.
//
// ASSUME-1: one target and two enclosed declarations are enough (modelling
//   assumption).
// ASSUME-2: every declaration in the reach falls through to the same next
//   level out. In Go, a field's chain passes its type's directive and then
//   the same block and file as the type (modelling assumption).
// ASSUME-3: a nearer directive reaches only the declaration it shadows here
//   (modelling assumption).
fsl 5
spec UnusedModes {
  enum Scope { Shared, Private }
  enum Directive   { NoDirective, SharedDirective, PrivateDirective }
  enum Mode  { Off, Loose, Strict }

  state {
    phase: 0..4 = 0,
    mode: Mode = Loose,
    // What this directive names, and what the next level out says.
    stated: Scope = Shared,
    outerDirective: Directive = NoDirective,
    unexportedDefault: Scope = Private,
    boundaryOn: Bool = true,
    surplusOn: Bool = true,
    // The declaration the directive is written on, if any.
    targetPresent: Bool = false,
    targetExported: Bool = false,
    // Two declarations within its reach. A nearer directive may shadow each.
    // nearer is the scope that nearer directive names.
    firstPresent: Bool = false,
    firstExported: Bool = false,
    firstShadowed: Bool = false,
    firstNearer: Scope = Shared,
    secondPresent: Bool = false,
    secondExported: Bool = false,
    secondShadowed: Bool = false,
    secondNearer: Scope = Shared,
    takerCrosses: Bool = false,
    takerCrossesExcluded: Bool = false,
    takerCrossesInTests: Bool = false,
    ownerWidened: Bool = false,
    surplusDepends: Bool = false,
    outerStuck: Bool = false,
    testsUnseen: Bool = false,
    reported: Bool = false,
    // fixed means the directive is deleted.
    fixed: Bool = false,
    // What the judge saw, kept to compare with the state after the fix.
    targetScopeBefore: Scope = Shared,
    firstScopeBefore: Scope = Shared,
    secondScopeBefore: Scope = Shared,
    firstNearerReportedBefore: Bool = false,
    secondNearerReportedBefore: Bool = false,
    boundaryReportedBefore: Bool = false
  }

  // One step per concern, not one action for all of them. The instances of
  // an action are the product of its parameters, at every step.
  action configureScope(givenMode: Mode,
                        givenStated: Scope,
                        givenOuterDirective: Directive,
                        givenCfgUnexported: Scope,
                        givenBoundaryOn: Bool,
                        givenSurplusOn: Bool) {
    requires phase == 0
    phase = 1
    mode = givenMode
    stated = givenStated
    outerDirective = givenOuterDirective
    unexportedDefault = givenCfgUnexported
    boundaryOn = givenBoundaryOn
    surplusOn = givenSurplusOn
  }
  action configureReach(givenTargetPresent: Bool,
                        givenTargetExported: Bool,
                        givenFirstPresent: Bool,
                        givenFirstExported: Bool,
                        givenFirstShadowed: Bool,
                        givenSecondPresent: Bool,
                        givenSecondExported: Bool,
                        givenSecondShadowed: Bool) {
    requires phase == 1
    // Only a declaration that is there can be shadowed.
    requires not givenFirstShadowed or givenFirstPresent
    requires not givenSecondShadowed or givenSecondPresent
    phase = 2
    targetPresent = givenTargetPresent
    targetExported = givenTargetExported
    firstPresent = givenFirstPresent
    firstExported = givenFirstExported
    firstShadowed = givenFirstShadowed
    secondPresent = givenSecondPresent
    secondExported = givenSecondExported
    secondShadowed = givenSecondShadowed
  }
  action configureOthers(givenFirstNearer: Scope,
                         givenSecondNearer: Scope,
                         givenCrosses: Bool,
                         givenCrossesExcluded: Bool,
                         givenCrossesInTests: Bool,
                         givenOwnerWidened: Bool,
                         givenSurplusDepends: Bool,
                         givenOuterStuck: Bool,
                         givenTestsUnseen: Bool) {
    requires phase == 2
    // Only a taker that is there is used.
    requires not (givenCrosses or givenCrossesExcluded or givenCrossesInTests) or anyTaker()
    // A crossing in a test file the pass does not read needs such a file.
    requires not givenCrossesInTests or givenTestsUnseen
    phase = 3
    firstNearer = givenFirstNearer
    secondNearer = givenSecondNearer
    takerCrosses = givenCrosses
    takerCrossesExcluded = givenCrossesExcluded
    takerCrossesInTests = givenCrossesInTests
    ownerWidened = givenOwnerWidened
    surplusDepends = givenSurplusDepends
    outerStuck = givenOuterStuck
    testsUnseen = givenTestsUnseen
  }

  def anyTaker() =
    targetPresent
    or (firstPresent and not firstShadowed)
    or (secondPresent and not secondShadowed)

  // --- the judgment ------------------------------------------------------------
  // The scope from the next level out, and whether it is the same under every
  // configuration. The default is a parameter, so that a property can ask
  // whether a verdict reads it.
  def outerFixed(isExported: Bool) = outerDirective != NoDirective or isExported
  def outerScope(isExported: Bool, defaultScope: Scope) =
    if outerDirective == SharedDirective then Shared
    else if outerDirective == PrivateDirective then Private
    else if isExported then Shared
    else defaultScope
  def inert(isExported: Bool, defaultScope: Scope) =
    outerFixed(isExported) and stated == outerScope(isExported, defaultScope)

  // loose: bound when a declaration in the reach takes a scope it could not
  // have had under any configuration. A shadowed declaration binds nothing to
  // this directive. Shadowing is a parameter, so that a property can shadow
  // one more declaration.
  def looseBound(defaultScope: Scope, firstShadowedNow: Bool, secondShadowedNow: Bool) =
    (targetPresent and not inert(targetExported, defaultScope))
    or (firstPresent
        and not firstShadowedNow
        and not inert(firstExported, defaultScope))
    or (secondPresent
        and not secondShadowedNow
        and not inert(secondExported, defaultScope))
  // strict: redundant when everything reached, shadowed or not, agrees with
  // the next level out under this configuration.
  def redundant(defaultScope: Scope) =
    (targetPresent or firstPresent or secondPresent)
    and (not targetPresent or stated == outerScope(targetExported, defaultScope))
    and (not firstPresent or stated == outerScope(firstExported, defaultScope))
    and (not secondPresent or stated == outerScope(secondExported, defaultScope))
  def verdict(modeNow: Mode, defaultScope: Scope, firstShadowedNow: Bool, secondShadowedNow: Bool) =
    modeNow != Off
    and (not looseBound(defaultScope, firstShadowedNow, secondShadowedNow)
         or (modeNow == Strict and redundant(defaultScope)))

  // What the pass can tell: a crossing in a file it reads, or a taker's name
  // in a file the build excludes. A test file it does not read is not here.
  // testsUnseen covers that file.
  def crossingWithholds() =
    boundaryOn
    and stated == Private
    and (takerCrosses or takerCrossesExcluded)
  def surplusHolds() = surplusOn and stated == Shared and surplusDepends
  def fixable() =
    mode == Strict
    and redundant(unexportedDefault)
    and not crossingWithholds()
    and not ownerWidened
    and not surplusHolds()
    and not outerStuck
    and not testsUnseen

  // --- the source before and after the deletion ------------------------------
  // A second resolution, over the levels as written. It reads whether this
  // directive is still there, and does not go through outerScope.
  def directiveOf(scope: Scope) = if scope == Shared then SharedDirective else PrivateDirective
  def thisLevel() = if fixed then NoDirective else directiveOf(stated)
  def nearerLevel(shadowed: Bool, nearer: Scope) = if shadowed then directiveOf(nearer) else NoDirective
  def resolveScope(nearest: Directive, middle: Directive, isExported: Bool) =
    if nearest == SharedDirective then Shared
    else if nearest == PrivateDirective then Private
    else if middle == SharedDirective then Shared
    else if middle == PrivateDirective then Private
    else if outerDirective == SharedDirective then Shared
    else if outerDirective == PrivateDirective then Private
    else if isExported then Shared
    else unexportedDefault
  def targetScope() = resolveScope(NoDirective, thisLevel(), targetExported)
  def firstScope() = resolveScope(nearerLevel(firstShadowed, firstNearer), thisLevel(), firstExported)
  def secondScope() = resolveScope(nearerLevel(secondShadowed, secondNearer), thisLevel(), secondExported)
  // The nearer directive on a shadowed declaration, judged in the mode in
  // force. It is judged against the levels beyond it. Those are this
  // directive while it is there, then the next level out.
  def beyondNearerFixed(isExported: Bool) =
    thisLevel() != NoDirective
    or outerDirective != NoDirective
    or isExported
  def beyondNearerScope(isExported: Bool) = resolveScope(NoDirective, thisLevel(), isExported)
  def nearerReported(shadowed: Bool, nearer: Scope, isExported: Bool) =
    shadowed
    and mode != Off
    and nearer == beyondNearerScope(isExported)
    and (beyondNearerFixed(isExported) or mode == Strict)
  // A boundary report on a taker names the level that decided its scope.
  // Before the fix, that level is this directive. All takers share a scope,
  // so the first one present stands for them.
  def takerScope() =
    if targetPresent then targetScope()
    else if firstPresent and not firstShadowed then firstScope()
    else secondScope()
  def boundaryReported() =
    boundaryOn
    and (takerCrosses or takerCrossesExcluded or takerCrossesInTests)
    and takerScope() == Private

  fair action judge() {
    requires phase == 3
    phase = 4
    reported = verdict(mode, unexportedDefault, firstShadowed, secondShadowed)
    targetScopeBefore = targetScope()
    firstScopeBefore = firstScope()
    secondScopeBefore = secondScope()
    firstNearerReportedBefore = nearerReported(firstShadowed, firstNearer, firstExported)
    secondNearerReportedBefore = nearerReported(secondShadowed, secondNearer, secondExported)
    boundaryReportedBefore = boundaryReported()
  }
  fair action fix() {
    requires phase == 4
    requires reported
    requires fixable()
    requires not fixed
    fixed = true
  }

  // --- how the modes relate ----------------------------------------------------
  // loose does not read defaults.unexported. Both values give one verdict.
  invariant LooseIgnoresTheDefault {
    verdict(Loose, Shared, firstShadowed, secondShadowed)
    == verdict(Loose, Private, firstShadowed, secondShadowed)
  }
  // strict does read it. Some reach gets two verdicts from the two values.
  reachable StrictReadsTheDefault {
    phase == 4
    and verdict(Strict, Shared, firstShadowed, secondShadowed)
        != verdict(Strict, Private, firstShadowed, secondShadowed)
  }
  // strict keeps every report loose makes.
  invariant StrictReportsWhatLooseReports {
    verdict(Loose, unexportedDefault, firstShadowed, secondShadowed)
    => verdict(Strict, unexportedDefault, firstShadowed, secondShadowed)
  }
  // Shadowing one more declaration never turns a reported directive into a
  // used one, in any mode.
  invariant ShadowingNeverMakesItUsed {
    (not firstShadowed
     and verdict(mode, unexportedDefault, false, secondShadowed)
     => verdict(mode, unexportedDefault, true, secondShadowed))
    and (not secondShadowed
         and verdict(mode, unexportedDefault, firstShadowed, false)
         => verdict(mode, unexportedDefault, firstShadowed, true))
  }

  // --- what the fix leaves -----------------------------------------------------
  // Every declaration keeps its scope, resolved over the levels as written.
  invariant FixKeepsEveryScope {
    fixed
    => (not targetPresent or targetScope() == targetScopeBefore)
       and (not firstPresent or firstScope() == firstScopeBefore)
       and (not secondPresent or secondScope() == secondScopeBefore)
  }
  // Every nearer directive is reported after the fix exactly when it was
  // before. So the fix starts no new unused report and settles none.
  invariant FixKeepsTheNearerJudgment {
    fixed
    => nearerReported(firstShadowed, firstNearer, firstExported) == firstNearerReportedBefore
       and nearerReported(secondShadowed, secondNearer, secondExported) == secondNearerReportedBefore
  }
  // The level a boundary report names moves with the fix. So the fix runs
  // only where no taker had a boundary report. This half restates
  // crossingWithholds(), except for the crossing in a test file. The guard
  // reads that one only through testsUnseen.
  invariant FixMovesNoBoundaryReport { fixed => not boundaryReportedBefore }

  // --- auxiliary ---------------------------------------------------------------
  // Lemmas for induction, not claims. The inputs are never assigned once
  // configured, and the judge's record holds until the fix.
  invariant JudgedLast   { (reported or fixed) => phase == 4 }
  invariant TestCrossingIsUnseen { takerCrossesInTests => testsUnseen }
  invariant CrossingNeedsATaker {
    (phase >= 3 and (takerCrosses or takerCrossesExcluded or takerCrossesInTests)) => anyTaker()
  }
  invariant ShadowedIsPresent {
    (not firstShadowed or firstPresent) and (not secondShadowed or secondPresent)
  }
  invariant RecordHoldsUntilTheFix {
    (phase == 4 and not fixed)
    => targetScopeBefore == targetScope()
       and firstScopeBefore == firstScope()
       and secondScopeBefore == secondScope()
       and firstNearerReportedBefore == nearerReported(firstShadowed, firstNearer, firstExported)
       and secondNearerReportedBefore == nearerReported(secondShadowed, secondNearer, secondExported)
       and boundaryReportedBefore == boundaryReported()
  }

  // The directive sits on a declaration and encloses nothing.
  def targetAlone() =
    targetPresent
    and not firstPresent
    and not secondPresent

  // --- loose: the two quantifiers ----------------------------------------------
  // Over configurations. //declscope:private on an unexported declaration
  // binds under the private default too. LooseIgnoresTheDefault gives the
  // shared default the same verdict.
  reachable ImplicitBindsUnderLoose {
    phase == 4
    and mode == Loose
    and targetAlone()
    and not targetExported
    and outerDirective == NoDirective
    and unexportedDefault == Private
    and stated == Private
    and not reported
  }
  // Over enclosing directives. shared on an exported declaration is inert
  // with nothing outside it. It binds under an enclosing private. A test of
  // exportedness alone would have called that one dead too.
  reachable ExportedSharedIsInert {
    phase == 4
    and mode == Loose
    and targetAlone()
    and targetExported
    and outerDirective == NoDirective
    and stated == Shared
    and reported
  }
  reachable ExportedSharedBindsUnderPrivateOuter {
    phase == 4
    and mode == Loose
    and targetAlone()
    and targetExported
    and outerDirective == PrivateDirective
    and stated == Shared
    and not reported
  }
  // A spec's private under a shared block binds, whatever the file says. The
  // block is the level a deletion falls through to.
  reachable SpecNarrowingItsBlockBinds {
    phase == 4
    and mode == Loose
    and targetAlone()
    and not targetExported
    and outerDirective == SharedDirective
    and stated == Private
    and not reported
  }
  // Both modes report a directive that restates the next level out. strict
  // deletes it.
  reachable RestatingReportedUnderLoose {
    phase == 4
    and mode == Loose
    and targetPresent
    and outerDirective == PrivateDirective
    and stated == Private
    and reported
    and not fixed
  }

  // --- loose: the reach --------------------------------------------------------
  // The target is inert, and the first enclosed declaration binds.
  reachable UsedViaFirstEnclosedOnly {
    phase == 4
    and mode == Loose
    and targetPresent
    and targetExported
    and stated == Shared
    and outerDirective == NoDirective
    and firstPresent
    and not firstExported
    and not firstShadowed
    and not secondPresent
    and not reported
  }
  // The first is shadowed, and the second binds.
  reachable UsedViaSecondOnly {
    phase == 4
    and mode == Loose
    and not targetPresent
    and outerDirective == NoDirective
    and firstPresent
    and firstShadowed
    and secondPresent
    and not secondExported
    and not secondShadowed
    and not reported
  }
  // The target binds, and the enclosed declarations after it do not.
  reachable UsedViaTargetOnly {
    phase == 4
    and mode == Loose
    and targetPresent
    and not targetExported
    and outerDirective == NoDirective
    and firstPresent
    and firstExported
    and stated == Shared
    and not firstShadowed
    and secondPresent
    and secondShadowed
    and not reported
  }
  reachable UnusedBecauseAllShadowed {
    phase == 4
    and mode == Loose
    and not targetPresent
    and firstPresent
    and firstShadowed
    and secondPresent
    and secondShadowed
    and reported
  }

  // --- off -----------------------------------------------------------------------
  // A directive that every mode but off reports is silent under off. Here it
  // restates the next level out. loose reports it, and strict would delete
  // it.
  reachable RestatingSilentUnderOff {
    phase == 4
    and mode == Off
    and targetAlone()
    and outerDirective == PrivateDirective
    and stated == Private
    and not reported
    and not fixed
  }

  // --- the case strict exists for ---------------------------------------------
  // //declscope:private on a field of a type that states nothing, under the
  // private default. loose binds it (ImplicitBindsUnderLoose). strict reports
  // it and deletes it.
  reachable ImplicitReportedUnderStrict {
    phase == 4
    and mode == Strict
    and targetAlone()
    and not targetExported
    and outerDirective == NoDirective
    and unexportedDefault == Private
    and stated == Private
    and reported
    and fixed
  }
  // The same comment under the shared default says something, in either mode.
  reachable ImplicitBindsUnderSharedDefault {
    phase == 4
    and mode == Strict
    and targetAlone()
    and not targetExported
    and outerDirective == NoDirective
    and unexportedDefault == Shared
    and stated == Private
    and not reported
  }
  reachable SharedRedundantUnderSharedDefault {
    phase == 4
    and mode == Strict
    and targetAlone()
    and not targetExported
    and outerDirective == NoDirective
    and unexportedDefault == Shared
    and stated == Shared
    and reported
    and fixed
  }
  reachable RestatingFixedUnderStrict {
    phase == 4
    and mode == Strict
    and targetAlone()
    and outerDirective == PrivateDirective
    and stated == Private
    and reported
    and fixed
  }
  // A nearer directive shadows a declaration that would take another scope
  // without this one. Nothing takes this directive's scope, so strict reports
  // it, as loose does. But it is not redundant, so strict does not delete it.
  reachable ShadowedDisagreementKeepsIt {
    phase == 4
    and mode == Strict
    and not targetPresent
    and firstPresent
    and firstShadowed
    and not firstExported
    and not secondPresent
    and outerDirective == NoDirective
    and unexportedDefault == Private
    and stated == Shared
    and reported
    and not redundant(unexportedDefault)
    and not fixed
  }
  reachable ShadowedAgreementDeletes {
    phase == 4
    and mode == Strict
    and not targetPresent
    and firstPresent
    and firstShadowed
    and not firstExported
    and not secondPresent
    and outerDirective == NoDirective
    and unexportedDefault == Private
    and stated == Private
    and fixed
  }
  // An exported declaration takes shared, whatever the default says. So
  // //declscope:private on it binds in both modes.
  reachable ExportedNarrowedBinds {
    phase == 4
    and mode == Strict
    and targetAlone()
    and targetExported
    and outerDirective == NoDirective
    and stated == Private
    and not reported
  }

  // --- why the fix is withheld -------------------------------------------------
  // Each withholding reason is witnessed with the others off. The witnesses
  // ask "not fixable()", not "not fixed". In every run the judged state comes
  // before the fix. So only the guard can make "not fixable()" fail.
  def noOtherReason() =
    not ownerWidened
    and not surplusDepends
    and not outerStuck
    and not testsUnseen
  def noCrossing() = not takerCrosses and not takerCrossesExcluded
  reachable CrossingWithholds {
    phase == 4
    and mode == Strict
    and reported
    and redundant(unexportedDefault)
    and stated == Private
    and boundaryOn
    and takerCrosses
    and not takerCrossesExcluded
    and noOtherReason()
    and not fixable()
  }
  // The name in an excluded file withholds as a crossing does, and no more.
  reachable ExcludedNameWithholds {
    phase == 4
    and mode == Strict
    and reported
    and redundant(unexportedDefault)
    and stated == Private
    and boundaryOn
    and takerCrossesExcluded
    and not takerCrosses
    and noOtherReason()
    and not fixable()
  }
  reachable ExcludedNameUnderSharedFixes {
    phase == 4
    and mode == Strict
    and stated == Shared
    and boundaryOn
    and takerCrossesExcluded
    and not takerCrosses
    and noOtherReason()
    and fixed
  }
  // There is no boundary report to change in these two. One is a redundant
  // //declscope:shared on an exported declaration that another namespace
  // uses. The other is a crossing with boundary off.
  reachable CrossingUnderSharedFixes {
    phase == 4
    and mode == Strict
    and stated == Shared
    and targetPresent
    and targetExported
    and outerDirective == NoDirective
    and boundaryOn
    and takerCrosses
    and noOtherReason()
    and fixed
  }
  reachable CrossingWithBoundaryOffFixes {
    phase == 4
    and mode == Strict
    and stated == Private
    and not boundaryOn
    and takerCrosses
    and takerCrossesExcluded
    and noOtherReason()
    and fixed
  }
  reachable OwnerWidenedWithholds {
    phase == 4
    and mode == Strict
    and reported
    and redundant(unexportedDefault)
    and ownerWidened
    and noCrossing()
    and not surplusDepends
    and not outerStuck
    and not testsUnseen
    and not fixable()
  }
  reachable SurplusWithholds {
    phase == 4
    and mode == Strict
    and reported
    and redundant(unexportedDefault)
    and stated == Shared
    and surplusOn
    and surplusDepends
    and noCrossing()
    and not ownerWidened
    and not outerStuck
    and not testsUnseen
    and not fixable()
  }
  // surplus does not judge a //declscope:private, and judges nothing when
  // off.
  reachable SurplusIgnoresPrivate {
    phase == 4
    and mode == Strict
    and stated == Private
    and surplusOn
    and surplusDepends
    and noCrossing()
    and not ownerWidened
    and not outerStuck
    and not testsUnseen
    and fixed
  }
  reachable SurplusOffFixes {
    phase == 4
    and mode == Strict
    and stated == Shared
    and not surplusOn
    and surplusDepends
    and noCrossing()
    and not ownerWidened
    and not outerStuck
    and not testsUnseen
    and fixed
  }
  reachable OuterStuckWithholds {
    phase == 4
    and mode == Strict
    and reported
    and redundant(unexportedDefault)
    and outerStuck
    and noCrossing()
    and not ownerWidened
    and not surplusDepends
    and not testsUnseen
    and not fixable()
  }
  // Unread tests withhold every fix. That includes one under
  // //declscope:shared with nothing crossing.
  reachable TestsUnseenWithholds {
    phase == 4
    and mode == Strict
    and reported
    and redundant(unexportedDefault)
    and stated == Shared
    and testsUnseen
    and noCrossing()
    and not takerCrossesInTests
    and not ownerWidened
    and not surplusDepends
    and not outerStuck
    and not fixable()
  }
  // The case testsUnseen exists for: a crossing that only the test variant
  // sees.
  reachable TestCrossingWithholds {
    phase == 4
    and mode == Strict
    and reported
    and redundant(unexportedDefault)
    and stated == Private
    and boundaryOn
    and takerCrossesInTests
    and noCrossing()
    and not ownerWidened
    and not surplusDepends
    and not outerStuck
    and not fixable()
  }
}
