// A config file states some keys and leaves the rest alone. The keys it
// states win for the packages below it. The keys it does not state come from
// the file above. When no file states a key, it comes from the built-in
// default.
//
// The rejected design was a lookup that stopped at the first file it found.
// Then a nested config that set one key silently dropped every other key the
// root had set. baseline already works the way this spec describes. It has
// its own upward search. So this rule makes one key's behaviour the rule for
// every key.
//
// Three levels are the fewest that tell apart two readings: "the nearest file
// wins" and "the nearest file that states this key wins". With two levels,
// the two readings agree. Outer is the repository root. Near is the file
// beside the package. Mid is a directory between them.
//
// filter is not modelled here. only and omit are path sets, not values. They
// compose by union and intersection, not by overriding. filter_chain.fsl
// proves that.
fsl 5
spec ConfigInherit {
  // MODEL: qualify takes three values in the config and two here. The third
  // adds another value to choose between. It adds nothing to the question
  // this spec asks: which level the value comes from.
  enum Mode   { Never, Always }
  // What one level says about a value key: nothing, or one of the values.
  enum Stated { Unset, AsNever, AsAlways }
  // What one level says about one namespace's vocabulary entry. An empty
  // list or null in the config is NoWord here, since it states nothing. Both
  // namespaces take the same type. So a rule that let one namespace take the
  // other's word could be written, and NamespaceANeverReadsB can catch it.
  enum Word   { NoWord, FirstWord, SecondWord }
  // Which level supplied the value that took effect.
  enum Level  { Builtin, Outer, Mid, Near }

  state {
    configured: Bool = false,
    // rules.naming.qualify, stated or not at each of the three levels.
    qualifyAtOuter: Stated = Unset,
    qualifyAtMid: Stated = Unset,
    qualifyAtNear: Stated = Unset,
    // rules.naming.vocabulary, two namespaces over two levels. Two namespaces
    // tell "the maps merge" apart from "the nearer map replaces the other".
    // Two levels are enough to see it.
    vocabularyAAtOuter: Word = NoWord,
    vocabularyAAtNear: Word = NoWord,
    vocabularyBAtOuter: Word = NoWord,
    vocabularyBAtNear: Word = NoWord,
    // The resolution is recorded. Each property compares this record with
    // the rule evaluated on other inputs.
    resolved: Bool = false,
    resolvedQualify: Mode = Never,
    resolvedQualifyFrom: Level = Builtin,
    resolvedVocabularyA: Word = NoWord,
    resolvedVocabularyB: Word = NoWord
  }

  action configure(givenQualifyAtOuter: Stated,
                   givenQualifyAtMid: Stated,
                   givenQualifyAtNear: Stated,
                   givenVocabularyAAtOuter: Word,
                   givenVocabularyAAtNear: Word,
                   givenVocabularyBAtOuter: Word,
                   givenVocabularyBAtNear: Word) {
    requires not configured
    configured = true
    qualifyAtOuter = givenQualifyAtOuter
    qualifyAtMid = givenQualifyAtMid
    qualifyAtNear = givenQualifyAtNear
    vocabularyAAtOuter = givenVocabularyAAtOuter
    vocabularyAAtNear = givenVocabularyAAtNear
    vocabularyBAtOuter = givenVocabularyBAtOuter
    vocabularyBAtNear = givenVocabularyBAtNear
  }

  def modeOf(stated: Stated) = if stated == AsAlways then Always else Never

  // One step of the lookup. A level that states the key decides it. A level
  // that does not state it passes the question to the level above.
  def modeOr(stated: Stated, otherwise: Mode) =
    if stated != Unset then modeOf(stated) else otherwise
  def sourceOr(stated: Stated, here: Level, otherwise: Level) =
    if stated != Unset then here else otherwise

  // The nearest level that states the key wins. No level nearer than that
  // states it. The built-in default is Never. The levels are parameters, so
  // a property can ask what the rule gives for other inputs.
  def qualifyOf(outer: Stated, mid: Stated, near: Stated) =
    modeOr(near,
           modeOr(mid,
                  modeOr(outer, Never)))
  def qualifySourceOf(outer: Stated, mid: Stated, near: Stated) =
    sourceOr(near, Near,
             sourceOr(mid, Mid,
                      sourceOr(outer, Outer, Builtin)))

  // What a level states, read by its name. Only the properties read it.
  def statedAt(level: Level) =
    if level == Near then qualifyAtNear
    else if level == Mid then qualifyAtMid
    else if level == Outer then qualifyAtOuter
    else Unset

  // A map merges per key. The nearer file wins the keys it states. The keys
  // it does not state keep the value from above. If the whole map were
  // replaced, adding one word would mean restating every other word. Each
  // def takes both namespaces' inputs, so a rule that reads the other
  // namespace can be written and caught.
  def vocabularyAOf(aOuter: Word, aNear: Word, bOuter: Word, bNear: Word) =
    if aNear != NoWord then aNear else aOuter
  def vocabularyBOf(aOuter: Word, aNear: Word, bOuter: Word, bNear: Word) =
    if bNear != NoWord then bNear else bOuter

  action resolve() {
    requires configured
    requires not resolved
    resolved = true
    resolvedQualify = qualifyOf(qualifyAtOuter, qualifyAtMid, qualifyAtNear)
    resolvedQualifyFrom = qualifySourceOf(qualifyAtOuter, qualifyAtMid, qualifyAtNear)
    resolvedVocabularyA = vocabularyAOf(vocabularyAAtOuter, vocabularyAAtNear, vocabularyBAtOuter, vocabularyBAtNear)
    resolvedVocabularyB = vocabularyBOf(vocabularyAAtOuter, vocabularyAAtNear, vocabularyBAtOuter, vocabularyBAtNear)
  }

  // --- the value and its source agree ------------------------------------------
  // The value and the source come from two separate defs. The level named as
  // the source states the key, and the value is what that level states. With
  // no level stating it, the source is the builtin and the value is Never.
  invariant ValueComesFromItsSource {
    resolved
      => (if resolvedQualifyFrom == Builtin
          then resolvedQualify == Never
          else statedAt(resolvedQualifyFrom) != Unset
               and resolvedQualify == modeOf(statedAt(resolvedQualifyFrom)))
  }

  // --- a silent level is transparent ---------------------------------------------
  // The claim the rejected lookup got wrong. A file that does not state the
  // key changes nothing. So the result is the same as for the stack with that
  // level removed. The model has three levels, so removing one leaves two.
  // Those two are put at Mid and Near, with Outer silent.
  invariant SilentLevelIsTransparent {
    resolved
      => (qualifyAtNear == Unset
          => resolvedQualify == qualifyOf(Unset, qualifyAtOuter, qualifyAtMid))
         and (qualifyAtMid == Unset
              => resolvedQualify == qualifyOf(Unset, qualifyAtOuter, qualifyAtNear))
  }

  // --- a stated key wins over everything above it -------------------------------
  // When Near states the key, the result does not read Mid or Outer.
  invariant StatedNearIgnoresTheLevelsAbove {
    resolved and qualifyAtNear != Unset
      => (forall otherOuter: Stated {
            forall otherMid: Stated {
              resolvedQualify == qualifyOf(otherOuter, otherMid, qualifyAtNear)
            }
          })
  }

  // Each level is witnessed supplying the value while the others differ. So
  // a resolution that read only one of them would be caught.
  reachable NearSupplies {
    resolved
    and resolvedQualifyFrom == Near
    and qualifyAtNear == AsAlways
    and qualifyAtMid == AsNever
    and qualifyAtOuter == AsNever
    and resolvedQualify == Always
  }
  reachable MidSupplies {
    resolved
    and resolvedQualifyFrom == Mid
    and qualifyAtNear == Unset
    and qualifyAtMid == AsAlways
    and qualifyAtOuter == AsNever
    and resolvedQualify == Always
  }
  reachable OuterSupplies {
    resolved
    and resolvedQualifyFrom == Outer
    and qualifyAtNear == Unset
    and qualifyAtMid == Unset
    and qualifyAtOuter == AsAlways
    and resolvedQualify == Always
  }
  reachable BuiltinSupplies {
    resolved and resolvedQualifyFrom == Builtin and resolvedQualify == Never
  }
  // A nearer file may relax as well as tighten. The README says a subtree can
  // do either. This makes that sentence checkable.
  reachable NearerRelaxes {
    resolved
    and qualifyAtOuter == AsAlways
    and qualifyAtNear == AsNever
    and resolvedQualify == Never
  }

  // --- the map merges and is not replaced ------------------------------------
  // A namespace's result does not read the other namespace's inputs. So
  // neither namespace can take the other's word. A nearer map that replaced
  // the whole map would also fail here: whether Near states B would decide A.
  invariant NamespaceANeverReadsB {
    resolved
      => (forall otherOuter: Word {
            forall otherNear: Word {
              resolvedVocabularyA == vocabularyAOf(vocabularyAAtOuter, vocabularyAAtNear, otherOuter, otherNear)
            }
          })
  }
  invariant NamespaceBNeverReadsA {
    resolved
      => (forall otherOuter: Word {
            forall otherNear: Word {
              resolvedVocabularyB == vocabularyBOf(otherOuter, otherNear, vocabularyBAtOuter, vocabularyBAtNear)
            }
          })
  }
  // A namespace a nearer file leaves unstated keeps the value from above. As
  // for qualify, the result is the same with the silent level removed.
  invariant SilentVocabularyLevelIsTransparent {
    resolved
      => (vocabularyAAtNear == NoWord
          => resolvedVocabularyA == vocabularyAOf(NoWord, vocabularyAAtOuter, vocabularyBAtOuter, vocabularyBAtNear))
         and (vocabularyBAtNear == NoWord
              => resolvedVocabularyB == vocabularyBOf(vocabularyAAtOuter, vocabularyAAtNear, NoWord, vocabularyBAtOuter))
  }

  // The case that matters. The root states namespace A, and the nested file
  // states namespace B. Both survive. A map that was replaced would lose A.
  reachable BothNamespacesSurvive {
    resolved
    and vocabularyAAtOuter == FirstWord
    and vocabularyAAtNear == NoWord
    and vocabularyBAtOuter == NoWord
    and vocabularyBAtNear == SecondWord
    and resolvedVocabularyA == FirstWord
    and resolvedVocabularyB == SecondWord
  }
  // On the one key both files state, the nearer file wins.
  reachable NearerWinsTheSharedKey {
    resolved
    and vocabularyAAtOuter == FirstWord
    and vocabularyAAtNear == SecondWord
    and resolvedVocabularyA == SecondWord
  }
  // The root states B, the nested file does not, and B survives.
  reachable NamespaceBInheritedFromOuter {
    resolved
    and vocabularyBAtOuter == FirstWord
    and vocabularyBAtNear == NoWord
    and resolvedVocabularyB == FirstWord
  }

  // --- auxiliary ---
  invariant ResolutionNeedsConfig { resolved => configured }
}
