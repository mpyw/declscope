// A config file states some keys and leaves the rest alone. The keys it
// states win for the packages below it. The keys it does not state come from
// the file above. When no file states a key, it comes from the built-in
// default.
//
// The rejected design was a lookup that stopped at the first file it found.
// Then a nested config that set one key silently dropped every other key the
// root had set. baseline already works the way this spec describes. It has
// its own upward search. So this rule makes one key's behaviour the rule for
// every key.
//
// Three levels are the fewest that tell apart two readings: "the nearest file
// wins" and "the nearest file that states this key wins". With two levels,
// the two readings agree. Outer is the repository root. Near is the file
// beside the package. Mid is a directory between them.
//
// filter is not modelled here. only and omit are path sets, not values. They
// compose by union and intersection, not by overriding. filter_chain.fsl
// proves that.
fsl 5
spec ConfigInherit {
  // MODEL: qualify takes three values in the config and two here. The third
  // adds another value to choose between. It adds nothing to the question
  // this spec asks: which level the value comes from.
  enum Mode   { Never, Always }
  // What one level says about a value key: nothing, or one of the values.
  enum Stated { Unset, AsNever, AsAlways }
  // What one level says about one namespace's vocabulary entry. Namespace A
  // needs two words, so the two levels can disagree. Namespace B only has to
  // be present or absent.
  enum Word     { NoWord, FirstWord, SecondWord }
  enum Presence { Absent, Present }
  // Which level supplied the value that took effect.
  enum Level  { Builtin, Outer, Mid, Near }

  state {
    configured: Bool = false,
    // rules.naming.qualify, stated or not at each of the three levels.
    qualifyAtOuter: Stated = Unset,
    qualifyAtMid: Stated = Unset,
    qualifyAtNear: Stated = Unset,
    // rules.naming.vocabulary, two namespaces over two levels. Two namespaces
    // tell "the maps merge" apart from "the nearer map replaces the other".
    // Two levels are enough to see it.
    vocabularyAAtOuter: Word = NoWord,
    vocabularyAAtNear: Word = NoWord,
    vocabularyBAtOuter: Presence = Absent,
    vocabularyBAtNear: Presence = Absent,
    // The resolution is recorded, and that keeps the chain load-bearing. An
    // invariant over the defs alone would hold however resolve() was written.
    resolved: Bool = false,
    resolvedQualify: Mode = Never,
    resolvedQualifyFrom: Level = Builtin,
    resolvedVocabularyA: Word = NoWord,
    resolvedVocabularyB: Presence = Absent
  }

  action configure(givenQualifyAtOuter: Stated,
                   givenQualifyAtMid: Stated,
                   givenQualifyAtNear: Stated,
                   givenVocabularyAAtOuter: Word,
                   givenVocabularyAAtNear: Word,
                   givenVocabularyBAtOuter: Presence,
                   givenVocabularyBAtNear: Presence) {
    requires not configured
    configured = true
    qualifyAtOuter = givenQualifyAtOuter
    qualifyAtMid = givenQualifyAtMid
    qualifyAtNear = givenQualifyAtNear
    vocabularyAAtOuter = givenVocabularyAAtOuter
    vocabularyAAtNear = givenVocabularyAAtNear
    vocabularyBAtOuter = givenVocabularyBAtOuter
    vocabularyBAtNear = givenVocabularyBAtNear
  }

  def modeOf(stated: Stated) = if stated == AsAlways then Always else Never

  // One step of the lookup. A level that states the key decides it. A level
  // that does not state it passes the question to the level above.
  def modeOr(stated: Stated, otherwise: Mode) =
    if stated != Unset then modeOf(stated) else otherwise
  def sourceOr(stated: Stated, here: Level, otherwise: Level) =
    if stated != Unset then here else otherwise

  // The nearest level that states the key wins. No level nearer than that
  // states it. The built-in default is Never.
  def effectiveQualify() =
    modeOr(qualifyAtNear,
           modeOr(qualifyAtMid,
                  modeOr(qualifyAtOuter, Never)))
  def effectiveQualifySource() =
    sourceOr(qualifyAtNear, Near,
             sourceOr(qualifyAtMid, Mid,
                      sourceOr(qualifyAtOuter, Outer, Builtin)))

  // A map merges per key. The nearer file wins the keys it states. The keys
  // it does not state keep the value from above. If the whole map were
  // replaced, adding one word would mean restating every other word.
  def mergedVocabularyA() =
    if vocabularyAAtNear != NoWord then vocabularyAAtNear else vocabularyAAtOuter
  def mergedVocabularyB() =
    if vocabularyBAtNear != Absent then vocabularyBAtNear else vocabularyBAtOuter

  action resolve() {
    requires configured
    requires not resolved
    resolved = true
    resolvedQualify = effectiveQualify()
    resolvedQualifyFrom = effectiveQualifySource()
    resolvedVocabularyA = mergedVocabularyA()
    resolvedVocabularyB = mergedVocabularyB()
  }

  invariant ResolutionNeedsConfig { resolved => configured }

  // --- a stated key wins over everything above it ---------------------------
  invariant NearestStatedWins {
    resolved and qualifyAtNear != Unset
      => resolvedQualify == modeOf(qualifyAtNear)
         and resolvedQualifyFrom == Near
  }
  invariant MidWinsWhenNearIsSilent {
    resolved and qualifyAtNear == Unset and qualifyAtMid != Unset
      => resolvedQualify == modeOf(qualifyAtMid)
         and resolvedQualifyFrom == Mid
  }
  // The claim the rejected lookup got wrong. The two nearer files do not
  // state a key. The key still comes from the root. It is not dropped just
  // because a nearer file exists.
  invariant OuterSurvivesTwoSilentLevels {
    resolved
    and qualifyAtNear == Unset
    and qualifyAtMid == Unset
    and qualifyAtOuter != Unset
      => resolvedQualify == modeOf(qualifyAtOuter)
         and resolvedQualifyFrom == Outer
  }
  invariant AllSilentTakesTheBuiltin {
    resolved
    and qualifyAtNear == Unset
    and qualifyAtMid == Unset
    and qualifyAtOuter == Unset
      => resolvedQualify == Never
         and resolvedQualifyFrom == Builtin
  }

  // Each level is witnessed supplying the value while the others differ. So
  // a resolution that read only one of them would be caught.
  reachable NearSupplies {
    resolved
    and resolvedQualifyFrom == Near
    and qualifyAtNear == AsAlways
    and qualifyAtMid == AsNever
    and qualifyAtOuter == AsNever
    and resolvedQualify == Always
  }
  reachable MidSupplies {
    resolved
    and resolvedQualifyFrom == Mid
    and qualifyAtNear == Unset
    and qualifyAtMid == AsAlways
    and qualifyAtOuter == AsNever
    and resolvedQualify == Always
  }
  reachable OuterSupplies {
    resolved
    and resolvedQualifyFrom == Outer
    and qualifyAtNear == Unset
    and qualifyAtMid == Unset
    and qualifyAtOuter == AsAlways
    and resolvedQualify == Always
  }
  reachable BuiltinSupplies {
    resolved and resolvedQualifyFrom == Builtin and resolvedQualify == Never
  }
  // A nearer file may relax as well as tighten. The README says a subtree can
  // do either. This makes that sentence checkable.
  reachable NearerRelaxes {
    resolved
    and qualifyAtOuter == AsAlways
    and qualifyAtNear == AsNever
    and resolvedQualify == Never
  }

  // --- the map merges and is not replaced ------------------------------------
  // The case that matters. The root states namespace A, and the nested file
  // states namespace B. Both survive. A map that was replaced would lose A.
  reachable BothNamespacesSurvive {
    resolved
    and vocabularyAAtOuter == FirstWord
    and vocabularyAAtNear == NoWord
    and vocabularyBAtOuter == Absent
    and vocabularyBAtNear == Present
    and resolvedVocabularyA == FirstWord
    and resolvedVocabularyB == Present
  }
  // On the one key both files state, the nearer file wins.
  reachable NearerWinsTheSharedKey {
    resolved
    and vocabularyAAtOuter == FirstWord
    and vocabularyAAtNear == SecondWord
    and resolvedVocabularyA == SecondWord
  }
  invariant StatedNearOwnsItsKey {
    resolved and vocabularyAAtNear != NoWord
      => resolvedVocabularyA == vocabularyAAtNear
  }
  invariant UnstatedNearInheritsItsKey {
    resolved and vocabularyAAtNear == NoWord
      => resolvedVocabularyA == vocabularyAAtOuter
  }
  // Neither namespace can take the other's value. A merge written over one
  // shared slot would allow that.
  invariant NamespacesDoNotBleed {
    resolved
      => (resolvedVocabularyA == vocabularyAAtNear
          or resolvedVocabularyA == vocabularyAAtOuter)
         and (resolvedVocabularyB == vocabularyBAtNear
              or resolvedVocabularyB == vocabularyBAtOuter)
  }
}
