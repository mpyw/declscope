// A scope directive whose reach holds nothing it can bind is reported, on the
// same principle as an unused ignore: a directive that decides nothing should
// not sit in the source claiming to.
//
// The test is STRUCTURAL. It asks what the directive can bind, never whether the
// scope it names differs from the one already in force — that comparison would
// flip with a config key two directories up, and would make writing down an
// intent that happens to match the default an error.
//
// The reach is a disjunction: the declaration the directive sits on, when there
// is one, plus what it encloses. One binding is enough. Two enclosed declarations
// are modelled because one cannot distinguish "nothing to bind" from "this one
// had nothing to bind" — a file directive is used when ANY of what it covers
// needed it.
//
// The subject is the unexported surface, so an exported declaration counts only
// through what it encloses: an exported type with an unexported field has a
// subject beneath it, an exported func has none.
spec DirectiveEffect {
  state {
    configured: Bool,
    // the declaration the directive is written on, if any (a file-level
    // directive has none)
    hasTarget: Bool, targetSubject: Bool,
    // bound records that some level took its scope from the directive.
    bound: Bool,
    // two declarations within its reach: in the subject, and whether a nearer
    // directive of their own shadows this one
    aSubject: Bool, aShadowed: Bool,
    bSubject: Bool, bShadowed: Bool
  }
  init {
    configured = false
    hasTarget = false  targetSubject = false  bound = false
    aSubject = false  aShadowed = false
    bSubject = false  bShadowed = false
  }
  action configure(ht: Bool, ts: Bool, as_: Bool, ash: Bool, bs: Bool, bsh: Bool) {
    requires not configured
    configured = true
    hasTarget = ht  targetSubject = ts
    aSubject = as_  aShadowed = ash
    bSubject = bs   bShadowed = bsh
  }

  // One action per level, mirroring the guards collection.bind applies. Written
  // as a def over the whole state instead, every invariant below would be a
  // tautology: a spec whose only action assigns the state at once can say
  // nothing about reachability, only restate its own definitions.
  action bindTarget() {
    requires configured  requires hasTarget  requires targetSubject
    bound = true
  }
  action bindA() {
    requires configured  requires aSubject  requires not aShadowed
    bound = true
  }
  action bindB() {
    requires configured  requires bSubject  requires not bShadowed
    bound = true
  }
  def used()     = bound
  def reported() = configured and not bound

  invariant BoundImpliesConfigured { bound => configured }
  // Nothing in the subject anywhere in the reach: never bound.
  invariant NoSubjectNeverUsed {
    bound => (hasTarget and targetSubject) or aSubject or bSubject
  }
  // Every enclosed subject shadowed and no bindable target: never bound.
  invariant AllShadowedNeverUsed {
    bound => (hasTarget and targetSubject)
             or (aSubject and not aShadowed) or (bSubject and not bShadowed)
  }

  // The directive binds the declaration it sits on.
  reachable UsedViaTarget {
    configured and hasTarget and targetSubject
    and not aSubject and not bSubject and bound
  }
  // The carve-out: an exported type is not itself a subject, but its unexported
  // field is, and that is what keeps the directive alive.
  reachable UsedViaEnclosedOnly {
    configured and hasTarget and not targetSubject
    and aSubject and not aShadowed and bound
  }
  // The disjunction: the first enclosed declaration is shadowed, the second is
  // what the directive binds. A model with one enclosed declaration would miss
  // this and would accept a structural test that stopped at the first.
  reachable UsedViaSecondOnly {
    configured and not hasTarget
    and aSubject and aShadowed and bSubject and not bShadowed and bound
  }
  // An exported leaf: a directive on an exported func, with nothing beneath it.
  reachable UnusedOnExportedLeaf {
    configured and hasTarget and not targetSubject
    and not aSubject and not bSubject and reported()
  }
  // A file of declarations that all state their own scope already.
  reachable UnusedBecauseAllShadowed {
    configured and not hasTarget
    and aSubject and aShadowed and bSubject and bShadowed and reported()
  }
}
