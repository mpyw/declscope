// When a scope directive binds, under rules.unused: loose. A
// directive that binds nothing is reported by the unused rule, on the same
// principle as an unused ignore: a directive that decides nothing should not
// sit in the source claiming to.
//
// A directive binds a declaration when the scope it names is one that
// declaration could not have had anyway: under ANY configuration, and given
// whatever the levels outside this directive already say. Both quantifiers
// matter for loose:
//
//   - Over configurations, so that the report does not read the current one.
//     A change of defaults.unexported then changes no report, and a directive
//     recording a deliberate `private` that today's default also gives is
//     kept. rules.unused: strict is the default and reads the current
//     configuration. It also reports a directive naming the
//     scope the declaration would have without it today, and one line of YAML
//     changes what it reports. unused_modes.fsl models strict and off beside
//     loose, and its loose is this spec's.
//   - Over enclosing directives, not only exportedness. Asking only whether
//     the name is exported would call //declscope:shared under an enclosing
//     `private` inert, although it is the one thing that widens an exported
//     declaration back, so a codebase could narrow and never widen again.
//
// "The levels outside" are every level a deletion would fall through to. For a
// spec that states its own scope, the first of them is the block's directive
// the spec overrides, then the type's for a field, then the file's. Skipping
// the block judges a spec's private under a shared block against the file,
// and calls it inert where deleting it widens the spec. outerDir is the
// nearest of them, whichever level that is.
//
// So: the scope outside this directive is FIXED when an outer level states one,
// or when the declaration is exported and nothing does (exported carries no
// boundary under every configuration). It is not fixed when defaults.unexported
// decides, since that may be either scope.
//
// The reach is a disjunction: the declaration the directive sits on, when there
// is one, plus what it encloses. One binding is enough. Two enclosed
// declarations are modelled because one cannot distinguish "nothing to bind"
// from "this one had nothing to bind".
//
// The judgment is one deterministic step, and UsedExactlyWhenSomethingBinds
// pins both directions. A binding that is only allowed to happen would prove
// that nothing bindable is never called used, and nothing about the reverse:
// a design in which an enclosed declaration never binds would still verify,
// and that design reports a directive that decides something.
spec UnusedBind {
  enum Scope { Shared, Private }
  enum Dir   { NoDir, DirShared, DirPrivate }

  state {
    configured: Bool = false,
    // what this directive names, and what the levels outside it say
    stated: Scope = Shared, outerDir: Dir = NoDir, cfgUnexported: Scope = Private,
    // the declaration the directive is written on, if any
    hasTarget: Bool = false, targetExported: Bool = false,
    // two declarations within its reach, each possibly shadowed by a nearer one
    aPresent: Bool = false, aExported: Bool = false, aShadowed: Bool = false,
    bPresent: Bool = false, bExported: Bool = false, bShadowed: Bool = false,
    judged: Bool = false, bound: Bool = false
  }
  action configure(st: Scope, od: Dir, cu: Scope,
                   ht: Bool, tx: Bool,
                   ap: Bool, ax: Bool, ash: Bool,
                   bp: Bool, bx: Bool, bsh: Bool) {
    requires not configured
    configured = true
    stated = st  outerDir = od  cfgUnexported = cu
    hasTarget = ht  targetExported = tx
    aPresent = ap  aExported = ax  aShadowed = ash
    bPresent = bp  bExported = bx  bShadowed = bsh
  }

  def outerFixed(x: Bool) = outerDir != NoDir or x
  def outerScope(x: Bool) =
    if outerDir == DirShared then Shared
    else if outerDir == DirPrivate then Private
    else if x then Shared
    else cfgUnexported
  def inert(x: Bool) = outerFixed(x) and stated == outerScope(x)

  // What binds: the declaration the directive sits on, or an enclosed one that
  // no nearer directive shadows, whose scope the directive decides.
  def targetBinds() = hasTarget and not inert(targetExported)
  def aBinds() = aPresent and not aShadowed and not inert(aExported)
  def bBinds() = bPresent and not bShadowed and not inert(bExported)

  action judge() {
    requires configured  requires not judged
    judged = true
    bound = targetBinds() or aBinds() or bBinds()
  }
  def reported() = judged and not bound

  invariant JudgedOnlyOnceConfigured { judged => configured }
  invariant BoundOnlyOnceJudged { bound => judged }
  // Expanded rather than routed through the defs above, so that mutating inert
  // or a reach moves only one side and the invariant can actually fail. Both
  // directions: a directive is used when anything in its reach binds, and
  // reported when nothing does, a shadowed declaration included.
  invariant UsedExactlyWhenSomethingBinds {
    judged => bound ==
      ((hasTarget and not (outerFixed(targetExported) and stated == outerScope(targetExported)))
       or (aPresent and not aShadowed
           and not (outerFixed(aExported) and stated == outerScope(aExported)))
       or (bPresent and not bShadowed
           and not (outerFixed(bExported) and stated == outerScope(bExported))))
  }

  // --- the two quantifiers -------------------------------------------------
  // Over configurations: an unexported declaration takes defaults.unexported,
  // which may be either scope, so neither spelling is ever inert on one.
  reachable UnexportedBindsSharedUnderSharedDefault {
    configured and hasTarget and not targetExported and outerDir == NoDir
    and cfgUnexported == Shared and stated == Shared
    and not aPresent and not bPresent and bound
  }
  reachable UnexportedBindsPrivateUnderPrivateDefault {
    configured and hasTarget and not targetExported and outerDir == NoDir
    and cfgUnexported == Private and stated == Private
    and not aPresent and not bPresent and bound
  }
  // Over enclosing directives: shared on an exported declaration is inert with
  // nothing outside it, and binds under an enclosing private — the surplus
  // that an exportedness-only test would have called dead.
  reachable ExportedSharedIsInert {
    configured and hasTarget and targetExported and outerDir == NoDir
    and stated == Shared and not aPresent and not bPresent and reported()
  }
  reachable ExportedSharedBindsUnderPrivateOuter {
    configured and hasTarget and targetExported and outerDir == DirPrivate
    and stated == Shared and not aPresent and not bPresent and bound
  }
  reachable ExportedNarrowedByPrivateBinds {
    configured and hasTarget and targetExported and outerDir == NoDir
    and stated == Private and not aPresent and not bPresent and bound
  }
  // A spec's private under a shared block binds, whatever the file says:
  // the block is the level a deletion falls through to.
  reachable SpecNarrowingItsBlockBinds {
    configured and hasTarget and not targetExported and outerDir == DirShared
    and stated == Private and not aPresent and not bPresent and bound
  }
  // Restating what the enclosing level already said decides nothing either.
  reachable RestatingOuterIsInert {
    configured and hasTarget and not targetExported and outerDir == DirPrivate
    and stated == Private and not aPresent and not bPresent and reported()
  }

  // --- the reach ------------------------------------------------------------
  reachable UsedViaFirstEnclosedOnly {
    configured and hasTarget and targetExported and stated == Shared
    and outerDir == NoDir
    and aPresent and not aExported and not aShadowed and not bPresent and bound
  }
  reachable UsedViaSecondOnly {
    configured and not hasTarget and outerDir == NoDir
    and aPresent and aShadowed and bPresent and not bExported and not bShadowed
    and bound
  }
  reachable UnusedOnExportedLeaf {
    configured and hasTarget and targetExported and stated == Shared
    and outerDir == NoDir and not aPresent and not bPresent and reported()
  }
  reachable UnusedBecauseAllShadowed {
    configured and not hasTarget and aPresent and aShadowed
    and bPresent and bShadowed and reported()
  }
}
