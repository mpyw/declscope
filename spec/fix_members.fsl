// Two directive insertions in one run must not converge.
//
// Every fix in a run is generated from the same pre-fix state. So no fix sees
// what another is about to write. rename_siblings.fsl already holds this shape
// for renames. The insertions converge in their own way. A directive written
// on a type reaches the members of the type. A member fixed in the same run
// is left with a directive that binds nothing. The `unused` rule then reports
// what -fix has just written. That rule carries no fix, so a second -fix does
// not clear it.
//
// The guard: the wider insertion subsumes the narrower one. The fix of the
// member is dropped whenever the type is about to carry a directive of its
// own. "About to" is narrower than "crosses and states no scope". The fix of
// the type is written only if its finding is reported. internal/report.go
// marks the type widened only after the ignores and the baseline let the
// finding through. See finding.widens, then subsumedByReport. A type whose
// finding the baseline absorbs carries no fix. So its member is fixed on its
// own.
//
// An ignore needs no input of its own. The ignores of a type contain its
// members, the way its scope directive does (silencedByIgnore). So an ignore
// that silences the boundary finding of the type silences the finding of the
// member as well. Neither carries a fix.
//
// The diagnostic of the member is not dropped. The crossing is real until the
// directive of the type lands. That is why nothing here says the member stops
// being reported.
//
// Only configure assigns the authored directives. No fix does. They are the
// pre-fix source that every guard reads. What a fix wrote is recorded beside them, in typeFixed
// and memberFixed. The "after" defs put the two together. The rejected
// alternative writes the insertion into typeDirective. Then each fix could
// read the edit of the other. That is the one thing -fix cannot do.
//
// ASSUME-1: one type and one of its members are enough. This convergence
//   needs exactly a container and something it contains (modelling
//   assumption).
// ASSUME-2: scope resolution here is a reduced copy of the one in knobs.fsl.
//   It has no var/const/type block level (modelling assumption). In the code
//   the block of a type reaches its members through container.BeneathScope()
//   in bindAtScopeSite. typeDirective does the same here. A block directive
//   is a stated scope like typeDirective. It withholds both fixes the same
//   way. So it adds no case to the convergence this spec is about.
fsl 5
spec FixMembers {
  enum Scope { Shared, Private }
  enum Directive { NoDirective, SharedDirective, PrivateDirective }
  enum ReferencedFrom { Nowhere, SameNamespace, OtherNamespace }

  state {
    configured: Bool = false,
    unexportedDefault: Scope = Private,
    typeExported: Bool = false,
    memberExported: Bool = false,
    // What the author wrote. A fix never assigns these.
    typeDirective: Directive = NoDirective,
    memberDirective: Directive = NoDirective,
    fileDirective: Directive = NoDirective,
    typeReferencedFrom: ReferencedFrom = Nowhere,
    memberReferencedFrom: ReferencedFrom = Nowhere,
    // The boundary finding of the type matches a baseline entry. So it is not
    // reported and carries no fix. The baseline keys each declaration
    // separately. So it can absorb the finding of the type and leave the
    // finding of the member.
    typeBaselined: Bool = false,
    // What this run inserted.
    typeFixed: Bool = false,
    memberFixed: Bool = false,
    // A pass that reported and did not fix. Either -fix is off, or the fix is
    // withheld. It lets a run go on with a crossing pending. That makes `fair`
    // on the two fix actions a claim, not decoration.
    stalled: Bool = false
  }
  action configure(newUnexportedDefault: Scope,
                   newTypeExported: Bool, newMemberExported: Bool,
                   newTypeDirective: Directive, newMemberDirective: Directive,
                   newFileDirective: Directive,
                   newTypeReferencedFrom: ReferencedFrom,
                   newMemberReferencedFrom: ReferencedFrom,
                   newTypeBaselined: Bool) {
    requires not configured
    configured = true
    unexportedDefault = newUnexportedDefault
    typeExported = newTypeExported
    memberExported = newMemberExported
    typeDirective = newTypeDirective
    memberDirective = newMemberDirective
    fileDirective = newFileDirective
    typeReferencedFrom = newTypeReferencedFrom
    memberReferencedFrom = newMemberReferencedFrom
    typeBaselined = newTypeBaselined
  }

  // Exportedness decides the default and nothing else, as in every spec.
  def defaultScope(isExported: Bool) = if isExported then Shared else unexportedDefault

  // The scope a directive states. If it states none, the scope from the next
  // level out.
  def scopeOr(directive: Directive, otherwise: Scope) =
    if directive == SharedDirective then Shared
    else if directive == PrivateDirective then Private
    else otherwise

  // The nearer directive if it states a scope. Otherwise the farther one.
  def directiveOr(nearer: Directive, farther: Directive) =
    if nearer != NoDirective then nearer else farther

  def fileOrDefault(isExported: Bool) = scopeOr(fileDirective, defaultScope(isExported))

  // --- the pre-fix source, which every guard reads -------------------------
  def typeScope() = scopeOr(typeDirective, fileOrDefault(typeExported))
  // The chain of the member has the containing type in it. That is the whole
  // reason the two fixes can converge.
  def memberScope() =
    scopeOr(memberDirective,
      scopeOr(typeDirective, fileOrDefault(memberExported)))

  def typeCrosses() =
    typeScope() == Private
    and typeReferencedFrom == OtherNamespace
  def memberCrosses() =
    memberScope() == Private
    and memberReferencedFrom == OtherNamespace

  // The directive of the nearest level that stated the scope, if any. A fix
  // is withheld for every such level. That is the subject of
  // boundary_fix.fsl. It is restated here only to guard the two fixes the way
  // the implementation guards them.
  def typeStatedDirective() = directiveOr(typeDirective, fileDirective)
  def memberStatedDirective() = directiveOr(memberDirective, typeStatedDirective())
  // The type carries the insertion. It crosses, nothing stated its scope, and
  // its finding survived the baseline. So the finding is reported with its
  // fix.
  def typeWidens() =
    typeCrosses()
    and typeStatedDirective() == NoDirective
    and not typeBaselined

  action reportWithoutFix() {
    requires configured
    stalled = true
  }

  fair action fixType() {
    requires configured
    requires not typeFixed
    requires typeCrosses()
    requires typeStatedDirective() == NoDirective
    requires not typeBaselined
    typeFixed = true
  }

  fair action fixMember() {
    requires configured
    requires not memberFixed
    requires memberCrosses()
    requires memberStatedDirective() == NoDirective
    // The guard this spec exists for. Deleting this line is the defect. Both
    // fixes then fire, and the member is left with an inert directive.
    requires not typeWidens()
    memberFixed = true
  }

  // --- what the source says once the run has finished ----------------------
  def typeDirectiveAfter() = if typeFixed then SharedDirective else typeDirective
  def memberDirectiveAfter() = if memberFixed then SharedDirective else memberDirective

  // The scope the member takes from the levels outside its own directive. And
  // whether that scope is the same under every configuration. It is not when
  // defaults.unexported decides it. This is the binding test of
  // unused_bind.fsl. It reads the source the run leaves behind, not the
  // source the run read.
  def memberOuterScopeIsConfigIndependent() =
    typeDirectiveAfter() != NoDirective
    or fileDirective != NoDirective
    or memberExported
  def memberOuterScope() = scopeOr(typeDirectiveAfter(), fileOrDefault(memberExported))

  def typeOuterScopeIsConfigIndependent() =
    fileDirective != NoDirective
    or typeExported
  def typeOuterScope() = fileOrDefault(typeExported)

  // --- what the run leaves ---------------------------------------------------
  def memberScopeAfter() = scopeOr(memberDirectiveAfter(), memberOuterScope())
  def typeScopeAfter() = scopeOr(typeDirectiveAfter(), typeOuterScope())
  def memberCrossesAfter() =
    memberScopeAfter() == Private
    and memberReferencedFrom == OtherNamespace
  def typeCrossesAfter() =
    typeScopeAfter() == Private
    and typeReferencedFrom == OtherNamespace

  invariant FixImpliesConfigured { (typeFixed or memberFixed) => configured }

  // Auxiliary: no fix assigns the authored directives. So each guard still
  // holds of the state it fired in. Without these, induction would have to
  // consider a run that inserted a directive where nothing crossed. The claims
  // below are not true of such a run.
  invariant TypeFixRecordsItsGuard {
    typeFixed =>
      typeCrosses()
      and typeStatedDirective() == NoDirective
      and not typeBaselined
  }
  invariant MemberFixRecordsItsGuard {
    memberFixed =>
      memberCrosses()
      and memberStatedDirective() == NoDirective
      and not typeWidens()
  }

  // The claim: no directive this run inserted binds nothing. The binding test
  // is expanded here, not routed through a def. So a mutation of the binding
  // test moves only one side of the implication, and the invariant can
  // actually fail.
  invariant InsertedMemberDirectiveBinds {
    memberFixed =>
      not (memberOuterScopeIsConfigIndependent() and Shared == memberOuterScope())
  }
  invariant InsertedTypeDirectiveBinds {
    typeFixed =>
      not (typeOuterScopeIsConfigIndependent() and Shared == typeOuterScope())
  }

  // And the fixes still do their job. What each one writes settles the
  // crossing it was written for.
  invariant TypeFixSettles   { typeFixed   => not typeCrossesAfter() }
  invariant MemberFixSettles { memberFixed => not memberCrossesAfter() }

  // The guards are load-bearing. Without these, two defects would go
  // unnoticed: a spurious insertion, and one written over the own directive of
  // the author.
  trans FixTypeOnlyWhereNeeded {
    not old(typeFixed) and typeFixed => old(typeCrosses())
  }
  trans FixMemberOnlyWhereNeeded {
    not old(memberFixed) and memberFixed => old(memberCrosses())
  }
  trans FixNeverClobbersDirective {
    (not old(typeFixed) and typeFixed => old(typeStatedDirective()) == NoDirective)
    and (not old(memberFixed) and memberFixed => old(memberStatedDirective()) == NoDirective)
  }

  // The convergence itself. The guard has to survive this state. Both cross,
  // neither states a scope, and only the wider directive is written.
  reachable BothCross {
    configured
    and typeCrosses()
    and memberCrosses()
    and typeStatedDirective() == NoDirective
    and memberStatedDirective() == NoDirective
  }
  // memberCrosses reads the authored source, and no fix assigns that. So it
  // still says what the member did before the run. The member crossed,
  // nothing was written on it, and the directive of the type settled it.
  reachable OnlyTheWiderFixIsWritten {
    typeFixed
    and not memberFixed
    and memberCrosses()
    and memberStatedDirective() == NoDirective
    and not memberCrossesAfter()
  }

  // The narrower fix is not disabled, only subsumed. Where the type does not
  // cross, the member carries its own directive, and that directive binds.
  reachable MemberFixedWhereTypeDoesNotCross {
    memberFixed
    and not typeFixed
    and not typeCrosses()
    and memberReferencedFrom == OtherNamespace
    and not memberCrossesAfter()
  }
  // Nor is it disabled where the type crosses but the baseline absorbs the
  // finding of the type. No fix is written on the type. So the member
  // carries its own fix. It binds and settles the crossing of the member.
  reachable MemberFixedWhereTypeIsBaselined {
    memberFixed
    and not typeFixed
    and typeBaselined
    and typeCrosses()
    and typeStatedDirective() == NoDirective
    and not memberCrossesAfter()
  }
  // A member whose type states its own scope is already withheld, by the rule
  // that boundary_fix.fsl proves. This witness shows such a state is
  // reachable. It is reachable even without that guard, so it does not pin
  // it. FixNeverClobbersDirective does.
  reachable MemberWithheldUnderTypeDirective {
    configured
    and typeDirective == PrivateDirective
    and memberDirective == NoDirective
    and memberCrosses()
    and not memberFixed
    and stalled
  }

  // The stall itself. Without it, nothing reads `stalled`. The assignment
  // that records it could then be deleted with no verdict moving.
  reachable CrossingSurvivesAPassWithoutFix {
    stalled
    and memberCrosses()
    and memberStatedDirective() == NoDirective
  }

  // Whichever of the two fixes applies, the member stops crossing. The
  // directive of the type reaches it when the type is fixed. Otherwise its
  // own directive does.
  leadsTo MemberEventuallySettled {
    configured and memberCrosses() and memberStatedDirective() == NoDirective
      ~> not memberCrossesAfter()
    helpful fixType()
    helpful fixMember()
    decreases if memberCrossesAfter() then 1 else 0
  }
  leadsTo TypeEventuallySettled {
    configured and typeCrosses() and typeStatedDirective() == NoDirective and not typeBaselined
      ~> not typeCrossesAfter()
    helpful fixType()
    decreases if typeCrossesAfter() then 1 else 0
  }
}
