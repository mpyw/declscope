// filter composes down the chain of config files. It composes differently
// from every other key. only and omit are path sets, not values. So a nested
// file adds to them and does not replace them:
//
//   only  intersects: each level may narrow further, never widen
//   omit  unions:     each level may subtract more, never put back
//
// Together those give one useful property. A config file can only ever shrink
// what the analysis reads. An omit at the repository root holds everywhere
// below it. No nested file can quietly undo it. MonotoneDown states this.
//
// A .gitignore is not monotone, because ! lets a deeper file undo a shallower
// one. filter has no negation. So union and intersection give monotonicity
// for free, and no extra rule has to enforce it.
//
// Each level's patterns are anchored to that level's own directory. So
// "gen/**" in the root and "gen/**" in a nested file name different
// directories. That is why each level's match result is a separate input
// here. A file may match the outer pattern, the nearer one, both, or neither.
// The spelling rules out no combination.
//
// Whether a pattern matches a path is the subject of filter.go. The set
// algebra within one level is the subject of filter.fsl. This spec is the
// chain.
//
// MODEL: two levels. The warning below is about the nearest config that
// states an only. The code takes the last config in the chain that states
// one (Options.NearestOnly). With two levels, a nearer level that states no
// only leaves the outer one, and nothing is above it to cancel it. So "the
// nearest config" and "the nearest config that states an only" give the same
// verdicts here. Telling them apart takes a third level, which this spec does
// not model.
fsl 5
spec FilterChain {
  state {
    configured: Bool = false,
    // Which lists each level states. An empty list places no restriction.
    // For only, that is a rule, not a consequence (filter.fsl).
    outerOnlyEmpty: Bool = true,
    outerOmitEmpty: Bool = true,
    nearerOnlyEmpty: Bool = true,
    nearerOmitEmpty: Bool = true,
    // Two files, because the warning below is about no file being left.
    // For each file: does it match the outer only, the outer omit, the nearer
    // only, and the nearer omit?
    file1MatchesOuterOnly: Bool = false,
    file1MatchesOuterOmit: Bool = false,
    file1MatchesNearerOnly: Bool = false,
    file1MatchesNearerOmit: Bool = false,
    file2MatchesOuterOnly: Bool = false,
    file2MatchesOuterOmit: Bool = false,
    file2MatchesNearerOnly: Bool = false,
    file2MatchesNearerOmit: Bool = false,
    // The outcome is recorded, and that keeps the guards load-bearing.
    decided: Bool = false,
    file1Kept: Bool = false,
    file2Kept: Bool = false,
    warned: Bool = false
  }

  action configure(givenOuterOnlyEmpty: Bool,
                   givenOuterOmitEmpty: Bool,
                   givenNearerOnlyEmpty: Bool,
                   givenNearerOmitEmpty: Bool,
                   givenFile1MatchesOuterOnly: Bool,
                   givenFile1MatchesOuterOmit: Bool,
                   givenFile1MatchesNearerOnly: Bool,
                   givenFile1MatchesNearerOmit: Bool,
                   givenFile2MatchesOuterOnly: Bool,
                   givenFile2MatchesOuterOmit: Bool,
                   givenFile2MatchesNearerOnly: Bool,
                   givenFile2MatchesNearerOmit: Bool) {
    requires not configured
    // Nothing matches an empty list. Without these guards the model would
    // hold states no config can produce. An invariant could then fail on a
    // state that cannot occur. A witness could be found only in such a state.
    requires givenOuterOnlyEmpty
      => (not givenFile1MatchesOuterOnly and not givenFile2MatchesOuterOnly)
    requires givenOuterOmitEmpty
      => (not givenFile1MatchesOuterOmit and not givenFile2MatchesOuterOmit)
    requires givenNearerOnlyEmpty
      => (not givenFile1MatchesNearerOnly and not givenFile2MatchesNearerOnly)
    requires givenNearerOmitEmpty
      => (not givenFile1MatchesNearerOmit and not givenFile2MatchesNearerOmit)
    configured = true
    outerOnlyEmpty = givenOuterOnlyEmpty
    outerOmitEmpty = givenOuterOmitEmpty
    nearerOnlyEmpty = givenNearerOnlyEmpty
    nearerOmitEmpty = givenNearerOmitEmpty
    file1MatchesOuterOnly = givenFile1MatchesOuterOnly
    file1MatchesOuterOmit = givenFile1MatchesOuterOmit
    file1MatchesNearerOnly = givenFile1MatchesNearerOnly
    file1MatchesNearerOmit = givenFile1MatchesNearerOmit
    file2MatchesOuterOnly = givenFile2MatchesOuterOnly
    file2MatchesOuterOmit = givenFile2MatchesOuterOmit
    file2MatchesNearerOnly = givenFile2MatchesNearerOnly
    file2MatchesNearerOmit = givenFile2MatchesNearerOmit
  }

  // Each def below takes one file's four match results. They are its match
  // against the outer only, the outer omit, the nearer only and the nearer
  // omit. The forms ending in 1 and 2 apply it to the two files.

  // One level's verdict on one file. This is the rule of filter.fsl.
  def outerKeeps(outerOnly: Bool, outerOmit: Bool) =
    (outerOnlyEmpty or outerOnly) and not outerOmit
  def outerKeeps1() = outerKeeps(file1MatchesOuterOnly, file1MatchesOuterOmit)
  def outerKeeps2() = outerKeeps(file2MatchesOuterOnly, file2MatchesOuterOmit)

  // The chain: only intersects, omit unions.
  def chainPassesOnly(outerOnly: Bool, nearerOnly: Bool) =
    (outerOnlyEmpty or outerOnly) and (nearerOnlyEmpty or nearerOnly)
  def chainOmits(outerOmit: Bool, nearerOmit: Bool) = outerOmit or nearerOmit
  def chainKeeps(outerOnly: Bool, outerOmit: Bool,
                 nearerOnly: Bool, nearerOmit: Bool) =
    chainPassesOnly(outerOnly, nearerOnly)
    and not chainOmits(outerOmit, nearerOmit)
  def chainKeeps1() =
    chainKeeps(file1MatchesOuterOnly, file1MatchesOuterOmit,
               file1MatchesNearerOnly, file1MatchesNearerOmit)
  def chainKeeps2() =
    chainKeeps(file2MatchesOuterOnly, file2MatchesOuterOmit,
               file2MatchesNearerOnly, file2MatchesNearerOmit)

  // The nearest config that states an only admits the file, and no omit
  // removes it. The chain drops it anyway. Only an only above can have done
  // that. A file an omit removes does not count. The omit is the author's own
  // choice, and the report names an only above as the cause
  // (Options.CancelledAbove).
  def cancelled(outerOnly: Bool, outerOmit: Bool,
                nearerOnly: Bool, nearerOmit: Bool) =
    not nearerOnlyEmpty
    and nearerOnly
    and not chainOmits(outerOmit, nearerOmit)
    and not chainPassesOnly(outerOnly, nearerOnly)
  def cancelled1() =
    cancelled(file1MatchesOuterOnly, file1MatchesOuterOmit,
              file1MatchesNearerOnly, file1MatchesNearerOmit)
  def cancelled2() =
    cancelled(file2MatchesOuterOnly, file2MatchesOuterOmit,
              file2MatchesNearerOnly, file2MatchesNearerOmit)

  // The cause the report names, spelled from the inputs and not through
  // cancelled(). The nearer only admits the file, the outer only does not,
  // and neither omit removes it.
  def removedByTheOnlyAbove(outerOnly: Bool, outerOmit: Bool,
                            nearerOnly: Bool, nearerOmit: Bool) =
    nearerOnly
    and not outerOnly
    and not outerOmit
    and not nearerOmit

  action decide() {
    requires configured
    requires not decided
    decided = true
    file1Kept = chainKeeps1()
    file2Kept = chainKeeps2()
    // A package with nothing to read is usually the point. A root only that
    // names one subtree excludes every package outside it. The case worth
    // reporting is narrower. Take the nearest config that states an only. An
    // only above it removes every file that only matches and its omit leaves.
    // So that config can never take effect. Nobody writes a filter for a subtree they
    // meant to exclude.
    warned = not chainKeeps1()
             and not chainKeeps2()
             and (cancelled1() or cancelled2())
  }

  invariant DecisionNeedsConfig { decided => configured }

  // --- the property the whole design is for ---------------------------------
  // A nested config cannot widen. Take a file the outer level alone would
  // drop. It stays dropped, whatever the nearer file says.
  invariant MonotoneDown {
    decided
      => (file1Kept => outerKeeps1()) and (file2Kept => outerKeeps2())
  }
  // MonotoneDown, stated for each of the two ways it can break. Then a repair
  // to one is not mistaken for a repair to both.
  invariant OuterOmitIsFinal { decided and file1MatchesOuterOmit => not file1Kept }
  invariant OuterOnlyIsAnUpperBound {
    decided and not outerOnlyEmpty and not file1MatchesOuterOnly
      => not file1Kept
  }

  // --- and the nearer file still does its job -------------------------------
  reachable NearerOmitSubtractsFurther {
    decided
    and outerKeeps1()
    and file1MatchesNearerOmit
    and not file1Kept
  }
  reachable NearerOnlyNarrowsFurther {
    decided
    and outerKeeps1()
    and not nearerOnlyEmpty
    and not file1MatchesNearerOnly
    and not file1Kept
  }
  reachable NearerStatingNothingChangesNothing {
    decided
    and nearerOnlyEmpty
    and nearerOmitEmpty
    and outerKeeps1()
    and file1Kept
  }
  reachable BothLevelsAdmit {
    decided
    and not outerOnlyEmpty
    and file1MatchesOuterOnly
    and not nearerOnlyEmpty
    and file1MatchesNearerOnly
    and file1Kept
  }

  // --- the two levels are anchored separately -------------------------------
  // The same line in two files names two directories. So matching one says
  // nothing about the other. Both asymmetries are reachable.
  reachable MatchesOuterPatternOnly {
    decided and file1MatchesOuterOnly and not file1MatchesNearerOnly
  }
  reachable MatchesNearerPatternOnly {
    decided and file1MatchesNearerOnly and not file1MatchesOuterOnly
  }

  // --- the warning ----------------------------------------------------------
  // Intersecting two only lists that do not overlap leaves nothing to read.
  invariant WarnedExactlyWhenTheNearestOnlyIsCancelled {
    decided => (warned == (not file1Kept
                           and not file2Kept
                           and (cancelled1() or cancelled2())))
  }
  // The report's message is true. Where it fires, an only above the nearest
  // config that states an only removed a file. That config's only admits the
  // file, and no omit removes it.
  invariant WarnedOnlyWhereAnOnlyAboveRemoves {
    decided and warned => not outerOnlyEmpty and (
      removedByTheOnlyAbove(file1MatchesOuterOnly, file1MatchesOuterOmit,
                            file1MatchesNearerOnly, file1MatchesNearerOmit) or
      removedByTheOnlyAbove(file2MatchesOuterOnly, file2MatchesOuterOmit,
                            file2MatchesNearerOnly, file2MatchesNearerOmit))
  }
  invariant ReadingSomethingNeverWarns {
    decided and (file1Kept or file2Kept) => not warned
  }
  reachable NearestOnlyCancelledByTheOneAbove {
    decided
    and not outerOnlyEmpty
    and not nearerOnlyEmpty
    and file1MatchesNearerOnly
    and not file1MatchesOuterOnly
    and file2MatchesNearerOnly
    and not file2MatchesOuterOnly
    and warned
  }
  // The cases that must stay quiet. They keep the report rare. A root only
  // can exclude a subtree with no config of its own. That is the setting
  // working, not a mistake.
  reachable NothingReadAndNoNearestOnlyStaysQuiet {
    decided
    and not outerOnlyEmpty
    and nearerOnlyEmpty
    and not file1MatchesOuterOnly
    and not file2MatchesOuterOnly
    and not file1Kept
    and not file2Kept
    and not warned
  }
  // An omit that empties a package is equally deliberate.
  reachable OmitEmptiedThePackageQuietly {
    decided
    and outerOnlyEmpty
    and nearerOnlyEmpty
    and not outerOmitEmpty
    and file1MatchesOuterOmit
    and file2MatchesOuterOmit
    and not warned
  }
  reachable ReadsSomethingAndDoesNotWarn { decided and file1Kept and not warned }
  // The nearest config that states an only has an omit. That omit removes
  // what its only matches. No only above is the cause, so nothing is
  // reported. This holds even where an only above would also have removed
  // the files.
  reachable NearestOmitEmptiedItsOnlyQuietly {
    decided
    and not nearerOnlyEmpty
    and file1MatchesNearerOnly
    and file2MatchesNearerOnly
    and file1MatchesNearerOmit
    and file2MatchesNearerOmit
    and not outerOnlyEmpty
    and not file1MatchesOuterOnly
    and not file2MatchesOuterOnly
    and not warned
  }
  // An omit removes one file, and the only above removes the other. The
  // report fires, and its cause is the only above.
  reachable CancelledBesideAnOmit {
    decided
    and not outerOnlyEmpty
    and not nearerOnlyEmpty
    and file1MatchesNearerOnly
    and not file1MatchesOuterOnly
    and not file1MatchesNearerOmit
    and not file1MatchesOuterOmit
    and file2MatchesNearerOnly
    and file2MatchesNearerOmit
    and warned
  }
}
