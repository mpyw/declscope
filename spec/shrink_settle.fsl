// shrink_settle models how declscope shrink settles which types of one
// package keep their names. That is step 2 of run.judge in
// internal/shrink/shrink.go.
//
// Each declaration is first judged on its own. fixable0 says the judgment
// would unexport it. A declaration that keeps its name holds every type it
// carries. It carries a type by returning it, taking it, or holding it in
// an exported field or method. Unexporting such a type would leave that
// declaration handing out a type its callers cannot name. carries is that
// relation, one step at a time. A type kept this way keeps its name too,
// and carries further on the next step.
//
// settle takes one type out of the fix set when a declaration outside the
// set carries it. That declaration is never the type itself. settle is the
// only move, so the fix set only shrinks, and the loop ends (Settles). Once
// no move is enabled, the judgment is done, and two properties hold:
//
//   Sound  No fixed declaration is carried by one that keeps its name. So
//          no exported declaration is left handing out an unexported type.
//   Tight  Every declaration judged fixable but not fixed has a carrier that
//          keeps its name. A second run, after the fixes, finds the same
//          carrier and holds the type again. So one run of -fix settles the
//          package.
//
// A carrier is never fixable. So a type that carries itself keeps nothing,
// and the model needs no rule against it (SelfCarryKeepsNothing).
//
// A const set (#179) adds two moves. inSet marks the values of one const
// block of one type. typeUsed says that type was found used.
//
//   drop  It takes a value of a used type out, since that value is not
//         reported at all.
//   hold  It takes a value out when another value of its set keeps its name.
//
// Both only take fixes away, like settle. So the loop still ends, and one
// more property holds:
//
//   Whole  A set is fixed whole or kept whole. It is never split between
//          exported and unexported values.
//
// Tight widens to the two new reasons. The next run holds a value for its
// sibling again, since the sibling still keeps its name. Whether the type is
// used comes from the evidence. This model takes it as given: typeUsed is
// configured, not derived.
//
// Rename clashes are left out. They belong to shrink_claim.fsl. Names are
// claimed only once this settles. A clash or a released loser starts it
// again from the judgment, with the losers left out.
fsl 5
spec ShrinkSettle {
  type Decl = 0..2

  state {
    phase: 0..2 = 0,
    fixable0: Map<Decl, Bool>,
    carries: relation Decl -> Decl = Set {},
    inSet: Map<Decl, Bool>,
    typeUsed: Bool = false,
    fixable: Map<Decl, Bool>
  }

  init {
    forall d: Decl { fixable0[d] = false }
    forall d: Decl { fixable[d] = false }
    forall d: Decl { inSet[d] = false }
  }

  // The judgment of each declaration on its own, and what carries what. A
  // self-edge is allowed, since a method of T can return T.
  action configure(d: Decl, f: Bool) {
    requires phase == 0
    fixable0[d] = f
    fixable[d] = f
  }
  action carry(a: Decl, b: Decl) {
    requires phase == 0
    carries = carries.add(a, b)
  }
  action configureSet(d: Decl, s: Bool) {
    requires phase == 0
    inSet[d] = s
  }
  action configureTypeUsed(u: Bool) {
    requires phase == 0
    typeUsed = u
  }
  action start() {
    requires phase == 0
    phase = 1
  }

  def carriedByAKeeper(e: Decl) =
    exists d: Decl { carries.contains(d, e) and not fixable[d] }

  def heldBySibling(e: Decl) =
    inSet[e] and exists d: Decl { inSet[d] and not fixable[d] }
  def droppedWithType(e: Decl) = inSet[e] and typeUsed
  def takenOut(e: Decl) = carriedByAKeeper(e) or heldBySibling(e) or droppedWithType(e)

  fair action settle(e: Decl) {
    requires phase == 1
    requires fixable[e]
    requires carriedByAKeeper(e)
    fixable[e] = false
  }
  fair action hold(e: Decl) {
    requires phase == 1
    requires fixable[e]
    requires heldBySibling(e)
    fixable[e] = false
  }
  fair action drop(e: Decl) {
    requires phase == 1
    requires fixable[e]
    requires droppedWithType(e)
    fixable[e] = false
  }
  fair action finish() {
    requires phase == 1
    requires not (exists e: Decl { fixable[e] and takenOut(e) })
    phase = 2
  }

  terminal { phase == 2 }

  invariant FixedOnlyWhenJudged { forall d: Decl { fixable[d] => fixable0[d] } }
  // Before settling starts, the fix set is the judgment itself.
  invariant UnsettledBeforeStart {
    phase == 0 => forall d: Decl { fixable[d] == fixable0[d] }
  }

  // Once settling starts, the fix set only shrinks.
  trans FixesOnlyShrink {
    old(phase) >= 1 => forall d: Decl { fixable[d] => old(fixable[d]) }
  }
  trans SetFrozen {
    old(phase) >= 1 => typeUsed == old(typeUsed)
                       and forall d: Decl { inSet[d] == old(inSet[d]) }
  }
  trans CarriesFrozen {
    old(phase) >= 1 => forall a: Decl { forall b: Decl {
      carries.contains(a, b) == old(carries.contains(a, b))
    } }
  }

  invariant Sound {
    phase == 2 => forall e: Decl { fixable[e] => forall d: Decl {
      carries.contains(d, e) => fixable[d]
    } }
  }
  invariant Tight {
    phase >= 1 => forall e: Decl {
      (fixable0[e] and not fixable[e]) => takenOut(e)
    }
  }
  invariant Whole {
    phase == 2 => forall a: Decl { forall b: Decl {
      (inSet[a] and inSet[b]) => fixable[a] == fixable[b]
    } }
  }

  // The fix set counts down, and finish ends it.
  leadsTo Settles {
    phase == 1 ~> phase == 2
    decreases count(d: Decl where fixable[d])
  }

  // A type kept through another kept type. The chain settles in two steps.
  reachable ChainKept {
    phase == 2
    and not fixable0[0]
    and fixable0[1]
    and fixable0[2]
    and carries.contains(0, 1)
    and carries.contains(1, 2)
    and not fixable[1]
    and not fixable[2]
  }
  // A declaration and the type it returns go together. Nothing that keeps
  // its name carries either of them.
  reachable FixedTogether {
    phase == 2
    and fixable0[0]
    and fixable0[1]
    and carries.contains(0, 1)
    and fixable[0]
    and fixable[1]
  }
  // One value of a set keeps its name, so the other does too.
  reachable SetKeptWhole {
    phase == 2
    and inSet[0]
    and inSet[1]
    and not fixable0[0]
    and fixable0[1]
    and not typeUsed
    and not carries.contains(0, 1)
    and not carries.contains(2, 1)
    and not fixable[1]
  }
  // A set nothing keeps is fixed whole.
  reachable SetFixedWhole {
    phase == 2
    and inSet[0]
    and inSet[1]
    and fixable[0]
    and fixable[1]
  }
  // The values of a used type go with it.
  reachable SetDroppedWithType {
    phase == 2
    and inSet[0]
    and inSet[1]
    and fixable0[0]
    and typeUsed
    and not fixable[0]
  }
  // A type that returns itself keeps nothing.
  reachable SelfCarryKeepsNothing {
    phase == 2
    and fixable0[0]
    and carries.contains(0, 0)
    and fixable[0]
  }
}
