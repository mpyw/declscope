// shrink_settle models how declscope shrink settles which types of one
// package keep their names. That is step 2 of run.judge in
// internal/shrink/shrink.go.
//
// Each declaration is first judged on its own. judgedFixable says the
// judgment would unexport it. A declaration that keeps its name holds every type it
// carries. It carries a type by returning it, taking it, or holding it in
// an exported field or method. Unexporting such a type would leave that
// declaration handing out a type its callers cannot name. carries is that
// relation, one step at a time. A type kept this way keeps its name too,
// and carries further on the next step.
//
// keepForCarrier takes one type out of the fix set when a declaration
// outside the set carries it. That declaration is never the type itself.
// keepForCarrier is the only move, so the fix set only shrinks, and the
// loop ends (Settles). Once no move is enabled, the judgment is done. Then
// no fixed declaration is carried by one that keeps its name. So no
// exported declaration is left handing out an unexported type. That is
// the guard of finish read back, so it is not stated as a claim. The
// claims are these:
//
//   Tight                  Every declaration judged fixable but not fixed
//                          has a carrier that keeps its name.
//   SecondRunFixesNothing  applyFixes unexports what the first run fixed,
//                          and settling runs again. The second run finds
//                          the same carriers and holds the same types. It
//                          fixes nothing. So one run of -fix settles the
//                          package.
//
// A carrier is never fixable. So a type that carries itself keeps nothing,
// and the model needs no rule against it (SelfCarryKeepsNothing).
//
// A const set (#179) adds two moves. inConstSet marks the values of one
// const block of one type. setTypeUsed says that type was found used.
//
//   dropWithUsedType  It takes a value of a used type out, since that value
//                     is not reported at all.
//   holdForSibling    It takes a value out when another value of its set
//                     keeps its name.
//
// Both only take fixes away, like keepForCarrier. So the loop still ends.
// A set is then fixed whole or kept whole. That too is the guard of finish
// read back.
//
// Tight widens to the two new reasons. The next run holds a value for its
// sibling again, since the sibling still keeps its name. Whether the type is
// used comes from the evidence. This model takes it as given: setTypeUsed is
// configured, not derived.
//
// Rename clashes are left out. They belong to shrink_claim.fsl. Names are
// claimed only once this settles. A clash or a released loser starts it
// again from the judgment, with the losers left out.
fsl 5
spec ShrinkSettle {
  type Decl = 0..2
  type Order = 0..3

  state {
    phase: 0..2 = 0,
    judgedFixable: Map<Decl, Bool>,
    carries: relation Decl -> Decl = Set {},
    inConstSet: Map<Decl, Bool>,
    setTypeUsed: Bool = false,
    fixable: Map<Decl, Bool>,
    // false once applyFixes unexports the declaration.
    exported: Map<Decl, Bool>,
    secondRun: Bool = false,
    // Ghosts for induction. The first run numbers each declaration it
    // takes out, from 1. 0 means not taken out.
    withheldOrder: Map<Decl, Order>,
    removals: Order = 0
  }

  init {
    forall d: Decl { judgedFixable[d] = false }
    forall d: Decl { fixable[d] = false }
    forall d: Decl { inConstSet[d] = false }
    forall d: Decl { exported[d] = true }
    forall d: Decl { withheldOrder[d] = 0 }
  }

  // The judgment of each declaration on its own, and what carries what. A
  // self-edge is allowed, since a method of T can return T.
  action configureJudgment(d: Decl, fixableAlone: Bool) {
    requires phase == 0
    judgedFixable[d] = fixableAlone
    fixable[d] = fixableAlone
  }
  action carry(a: Decl, b: Decl) {
    requires phase == 0
    carries = carries.add(a, b)
  }
  action configureSet(d: Decl, isInSet: Bool) {
    requires phase == 0
    inConstSet[d] = isInSet
  }
  action configureTypeUsed(used: Bool) {
    requires phase == 0
    setTypeUsed = used
  }
  action start() {
    requires phase == 0
    phase = 1
  }

  // An unexported declaration hands out nothing, so it keeps nothing.
  def keepsItsName(d: Decl) = exported[d] and not fixable[d]
  def carriedByAKeeper(candidate: Decl) =
    exists d: Decl { carries.contains(d, candidate) and keepsItsName(d) }

  def heldBySibling(candidate: Decl) =
    inConstSet[candidate] and exists d: Decl { inConstSet[d] and keepsItsName(d) }
  def droppedWithType(candidate: Decl) = inConstSet[candidate] and setTypeUsed
  def takenOut(candidate: Decl) = carriedByAKeeper(candidate) or heldBySibling(candidate) or droppedWithType(candidate)

  fair action keepForCarrier(candidate: Decl) {
    requires phase == 1
    requires fixable[candidate]
    requires carriedByAKeeper(candidate)
    fixable[candidate] = false
    withheldOrder[candidate] = if secondRun then withheldOrder[candidate] else removals + 1
    removals = if secondRun then removals else removals + 1
  }
  fair action holdForSibling(candidate: Decl) {
    requires phase == 1
    requires fixable[candidate]
    requires heldBySibling(candidate)
    fixable[candidate] = false
    withheldOrder[candidate] = if secondRun then withheldOrder[candidate] else removals + 1
    removals = if secondRun then removals else removals + 1
  }
  fair action dropWithUsedType(candidate: Decl) {
    requires phase == 1
    requires fixable[candidate]
    requires droppedWithType(candidate)
    fixable[candidate] = false
    withheldOrder[candidate] = if secondRun then withheldOrder[candidate] else removals + 1
    removals = if secondRun then removals else removals + 1
  }
  fair action finish() {
    requires phase == 1
    requires not (exists candidate: Decl { fixable[candidate] and takenOut(candidate) })
    phase = 2
  }

  // The second run. The first run's fixes are applied, so each fixed
  // declaration is unexported and leaves the rule. A declaration the first
  // run withheld is judged fixable on its own again. Nothing else changes.
  // A fix changes no reference (ASSUME-1 of shrink.fsl).
  action applyFixes() {
    requires phase == 2
    requires not secondRun
    forall d: Decl { exported[d] = exported[d] and not fixable[d] }
    forall d: Decl { judgedFixable[d] = judgedFixable[d] and not fixable[d] }
    forall d: Decl { fixable[d] = judgedFixable[d] and not fixable[d] }
    secondRun = true
    phase = 1
  }

  terminal { phase == 2 and secondRun }

  // The second run fixes nothing. The guard of finish checks only that
  // nothing fixable is taken out. So this is not that guard again.
  invariant SecondRunFixesNothing {
    (secondRun and phase == 2) => forall d: Decl { not fixable[d] }
  }

  invariant Tight {
    phase >= 1 => forall candidate: Decl {
      (judgedFixable[candidate] and not fixable[candidate]) => takenOut(candidate)
    }
  }

  // The fix set counts down, and finish ends it.
  leadsTo Settles {
    phase == 1 ~> phase == 2
    decreases count(d: Decl where fixable[d])
  }

  // A type kept through another kept type. The chain settles in two steps.
  reachable ChainKept {
    phase == 2
    and not judgedFixable[0]
    and judgedFixable[1]
    and judgedFixable[2]
    and carries.contains(0, 1)
    and carries.contains(1, 2)
    and not fixable[1]
    and not fixable[2]
  }
  // A declaration and the type it returns go together. Nothing that keeps
  // its name carries either of them.
  reachable FixedTogether {
    phase == 2
    and judgedFixable[0]
    and judgedFixable[1]
    and carries.contains(0, 1)
    and fixable[0]
    and fixable[1]
  }
  // One value of a set keeps its name, so the other does too.
  reachable SetKeptWhole {
    phase == 2
    and inConstSet[0]
    and inConstSet[1]
    and not judgedFixable[0]
    and judgedFixable[1]
    and not setTypeUsed
    and not carries.contains(0, 1)
    and not carries.contains(2, 1)
    and not fixable[1]
  }
  // A set nothing keeps is fixed whole.
  reachable SetFixedWhole {
    phase == 2
    and inConstSet[0]
    and inConstSet[1]
    and fixable[0]
    and fixable[1]
  }
  // The values of a used type go with it. Nothing else holds value 0 here.
  // A declaration outside the set stays fixable.
  reachable SetDroppedWithType {
    phase == 2
    and inConstSet[0]
    and not inConstSet[1]
    and judgedFixable[0]
    and not carries.contains(1, 0)
    and setTypeUsed
    and not fixable[0]
    and not inConstSet[2]
    and judgedFixable[2]
    and fixable[2]
  }
  // A type that returns itself keeps nothing.
  reachable SelfCarryKeepsNothing {
    phase == 2
    and judgedFixable[0]
    and carries.contains(0, 0)
    and fixable[0]
  }
  // The first run withholds a type, and the second holds it again.
  reachable SecondRunHoldsTheType {
    secondRun
    and phase == 2
    and judgedFixable[1]
    and not fixable[1]
  }

  // --- auxiliary ----------------------------------------------------------
  invariant FixedOnlyWhenJudged { forall d: Decl { fixable[d] => judgedFixable[d] } }
  // Before settling starts, the fix set is the judgment itself.
  invariant UnsettledBeforeStart {
    phase == 0 => forall d: Decl { fixable[d] == judgedFixable[d] }
  }
  // Within one run, the fix set only shrinks.
  trans FixesOnlyShrink {
    (old(phase) >= 1 and secondRun == old(secondRun)) => forall d: Decl { fixable[d] => old(fixable[d]) }
  }
  trans SetFrozen {
    old(phase) >= 1 => setTypeUsed == old(setTypeUsed)
                       and forall d: Decl { inConstSet[d] == old(inConstSet[d]) }
  }
  trans CarriesFrozen {
    old(phase) >= 1 => forall a: Decl { forall b: Decl {
      carries.contains(a, b) == old(carries.contains(a, b))
    } }
  }
  // Lemmas for SecondRunFixesNothing, not claims. The first run numbers
  // what it takes out. Each one has a reason that comes earlier: a used
  // type, or a keeper that was never fixable or was taken out before it.
  // That order is why the second run takes everything out again.
  invariant OrderedBeforeTheCount { forall d: Decl { withheldOrder[d] <= removals } }
  invariant CountsEachOnce { removals == count(d: Decl where withheldOrder[d] > 0) }
  invariant NothingBeforeStart { phase == 0 => removals == 0 and not secondRun }
  invariant FirstRunNumbersWhatItTakesOut {
    (phase >= 1 and not secondRun) => forall d: Decl {
      (withheldOrder[d] > 0) == (judgedFixable[d] and not fixable[d])
    }
  }
  invariant EveryoneExportedInTheFirstRun {
    not secondRun => forall d: Decl { exported[d] }
  }
  // An earlier keeper of a candidate: one that keeps its name and was never
  // judged fixable, or one taken out before the candidate.
  def earlierKeeper(keeper: Decl, candidate: Decl) =
    exported[keeper]
    and (
      (withheldOrder[keeper] == 0 and not judgedFixable[keeper])
      or (withheldOrder[keeper] > 0 and withheldOrder[keeper] < withheldOrder[candidate])
    )
  invariant TakenOutForAnEarlierReason {
    forall candidate: Decl {
      withheldOrder[candidate] > 0 => (
        droppedWithType(candidate)
        or exists keeper: Decl {
          earlierKeeper(keeper, candidate)
          and (carries.contains(keeper, candidate) or (inConstSet[keeper] and inConstSet[candidate]))
        }
      )
    }
  }
  invariant SecondRunJudgesWhatTheFirstTookOut {
    secondRun => forall d: Decl { judgedFixable[d] == (withheldOrder[d] > 0) }
  }
}
