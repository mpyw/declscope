// The rename guard against sibling fixes, as implemented, and that it is sound.
//
// rename_siblings.fsl is the negative control: it models fixes that check
// their target against the pre-fix names only, and shows two of them
// converging on one name. A control with no positive counterpart proves
// nothing about the code that exists: internal/rename.go could lose the
// reserved check and no spec would change verdict.
//
// This is that counterpart. Each fix also checks its target against the names
// fixes emitted earlier in the pass have claimed (renameState.reserved), and
// claims its own target when it is emitted (reserveForRename). Dropping either turns this
// spec violated.
//
// ASSUME-1: two declarations are enough — a collision needs exactly two
//   (modelling assumption)
// ASSUME-2: a fix is emitted and applied in one step. The other fix cannot see
//   the applied name either way, since it checks the pre-fix state, so only
//   the order of emission matters (modelling assumption)
fsl 5
spec RenameReserved {
  // NameA and NameB are the two declarations' names before any fix. The free
  // names are held by nothing in the package.
  enum Name { NameA, NameB, FreeName1, FreeName2 }

  state {
    configured: Bool = false,
    // Current names
    nameA: Name = NameA,
    nameB: Name = NameB,
    // Names in the state the fixes were generated from
    originalA: Name = NameA,
    originalB: Name = NameB,
    // What each fix renames to
    targetA: Name = NameA,
    targetB: Name = NameB,
    // The names fixes emitted so far have claimed
    reserved: Set<Name> = Set {},
    appliedA: Bool = false,
    appliedB: Bool = false
  }

  action configure(targetForA: Name, targetForB: Name) {
    requires not configured
    configured = true
    targetA = targetForA
    targetB = targetForB
  }

  // Pkg.Scope().Lookup: the target is not a name in the pre-fix state.
  def freeInOriginalState(name: Name) = name != originalA and name != originalB

  // The guard as implemented: free before the fixes, and claimed by none.
  def guardAsImplemented(name: Name) =
    freeInOriginalState(name)
    and not reserved.contains(name)

  fair action fixA() {
    requires configured
    requires not appliedA
    requires targetA != originalA
    requires guardAsImplemented(targetA)
    nameA = targetA
    appliedA = true
    reserved = reserved.add(targetA)
  }
  fair action fixB() {
    requires configured
    requires not appliedB
    requires targetB != originalB
    requires guardAsImplemented(targetB)
    nameB = targetB
    appliedB = true
    reserved = reserved.add(targetB)
  }

  // Two declarations in one package may never share a name.
  invariant NamesStayDistinct { nameA != nameB }

  // What the guard relies on: a renamed declaration's name is claimed, and an
  // unrenamed one keeps its pre-fix name.
  invariant RenamedNameIsReserved {
    (appliedA => reserved.contains(nameA))
      and (appliedB => reserved.contains(nameB))
  }
  invariant UnrenamedKeepsItsName {
    (not appliedA => nameA == originalA)
      and (not appliedB => nameB == originalB)
  }
  invariant OriginalNamesNeverReserved {
    not reserved.contains(originalA)
      and not reserved.contains(originalB)
  }

  // Both fixes apply when their targets differ: the guard is no broader than
  // it needs to be.
  reachable BothApplied { appliedA and appliedB }
  // Two fixes aiming at one name: the first claims it, and the second is
  // withheld, its declaration keeping its name.
  reachable SecondWithheld {
    configured
      and targetA == targetB
      and freeInOriginalState(targetA)
      and appliedA
      and not appliedB
      and not guardAsImplemented(targetB)
  }
}
