// Two renames in one run must not converge on the same name.
//
// The guard modelled here checks a target against the pre-fix names only.
// Every fix in a run is generated from the same pre-fix state, so under that
// guard neither fix sees the name the other is about to take.
//
// ASSUME-1: two declarations are enough — a collision needs exactly two
//   (modelling assumption)
spec RenameSiblings {
  enum Name { NameA, NameB, NameT }

  state {
    configured: Bool,
    nameA: Name, nameB: Name,     // Current names
    origA: Name, origB: Name,     // Names in the state the fixes were generated from
    tgtA:  Name, tgtB:  Name,     // What each fix renames to
    appliedA: Bool, appliedB: Bool
  }

  init {
    configured = false
    nameA = NameA  nameB = NameB  origA = NameA  origB = NameB
    tgtA = NameA   tgtB = NameB
    appliedA = false  appliedB = false
  }

  action configure(ta: Name, tb: Name) {
    requires not configured
    configured = true  tgtA = ta  tgtB = tb
  }

  // The guard modelled here: the target must not already be a package-scope
  // name. "Already" means in the state the fixes were generated from, which
  // is why a sibling's target is invisible.
  def freeInOriginalState(n: Name) = n != origA and n != origB

  action fixA() {
    requires configured  requires not appliedA
    requires tgtA != origA
    requires freeInOriginalState(tgtA)
    nameA = tgtA  appliedA = true
  }
  action fixB() {
    requires configured  requires not appliedB
    requires tgtB != origB
    requires freeInOriginalState(tgtB)
    nameB = tgtB  appliedB = true
  }

  // Two declarations in one package may never share a name.
  invariant NamesStayDistinct { nameA != nameB }

  reachable BothApplied { appliedA and appliedB }
}
