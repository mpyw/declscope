// Two renames in one run must not converge on the same name.
//
// The guard modeled here checks a target against the pre-fix names only.
// Every fix in a run is generated from the same pre-fix state. So under this
// guard, neither fix sees the name the other is about to take.
//
// ASSUME-1: two declarations are enough. A collision needs exactly two
//   (modelling assumption).
fsl 5
spec RenameSiblings {
  // NameA and NameB are the two declarations' names before any fix. FreeName
  // is held by nothing in the package.
  enum Name { NameA, NameB, FreeName }

  state {
    configured: Bool = false,
    // The current names
    nameA: Name = NameA,
    nameB: Name = NameB,
    // Names in the state the fixes were generated from
    originalA: Name = NameA,
    originalB: Name = NameB,
    // The name each fix renames to
    targetA: Name = NameA,
    targetB: Name = NameB,
    appliedA: Bool = false,
    appliedB: Bool = false
  }

  action configure(targetForA: Name, targetForB: Name) {
    requires not configured
    configured = true
    targetA = targetForA
    targetB = targetForB
  }

  // The guard modeled here: the target must not already be a package-scope
  // name. "Already" means in the state the fixes were generated from. That is
  // why a sibling's target is invisible to it.
  def freeInOriginalState(name: Name) = name != originalA and name != originalB

  action fixA() {
    requires configured
    requires not appliedA
    requires targetA != originalA
    requires freeInOriginalState(targetA)
    nameA = targetA
    appliedA = true
  }
  action fixB() {
    requires configured
    requires not appliedB
    requires targetB != originalB
    requires freeInOriginalState(targetB)
    nameB = targetB
    appliedB = true
  }

  // Two declarations in one package may never share a name.
  invariant NamesStayDistinct { nameA != nameB }

  reachable BothApplied { appliedA and appliedB }
}
