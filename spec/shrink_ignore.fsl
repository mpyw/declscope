// This models declscope shrink's unused report on
// //declscope:ignore overexported. A repository runs shrink under two build
// configurations, and the model covers both (#165, #171).
//
// One declaration carries the ignore. These are the uses of it from
// outside its package:
//
//   spelledFree          A name spelled in a file under no build
//                        constraint, or a linkname. Every configuration
//                        reads it, and the run knows that
//                        (evidence.everywhere).
//   spelledConstrained   A name spelled in a file behind a build
//                        constraint. The configuration In reads the file.
//                        The configuration Out leaves it out and reads it
//                        for names only.
//   otherUseFree         A use made by code that every configuration
//                        reads. It is a static interface satisfaction, an
//                        escape into an interface, an exposure through the
//                        API of an importable package, or a struct pairing.
//   otherUseConstrained  One of those four uses, made by code behind the
//                        constraint. Only In sees it. None of the four
//                        records where it was found. So In cannot tell it
//                        from otherUseFree.
//   carrierSpelledConstrained
//                        A file behind the constraint writes pkg.Name for
//                        another exported declaration that hands this one
//                        out, such as a function returning the type. In sees
//                        the carrier used, so the type is held outside
//                        (run.typesCarried). Out reads the carrier's name
//                        too (carrierRoots, exclusions.writes), so the same
//                        holds there.
//
// One more kind of name is no use from outside at all:
//
//   extTestSpelledConstrained
//                        A file behind the constraint is an external test of
//                        the package (package pkg_test in its directory),
//                        and it writes pkg.Name. In reads it as an external
//                        test, and reports the declaration as used only by
//                        external tests. Out reads it the same way
//                        (exclusions.extTestWrites). It once read the file
//                        as another package, which is a use for Other. Then
//                        In needed the ignore and Out called it unused.
//
// One more input says whether the files behind the constraint reach the
// declaration:
//
//   constrainedReaches  A constrained file is in its package, or it
//                       imports a path that reaches the package
//                       (module.Reaches).
//
// What a run reports without the ignore:
//
//   In   It sees any use. So it reports the declaration only when there is
//        no use.
//   Out  A member is a field, a method, or a type some struct embeds. For a
//        member, a name in an excluded file is not enough. Go uses members
//        without writing their names. So the report stays, with its fix
//        withheld. Any other declaration is used from the excluded file by
//        writing pkg.Name, and that is a use.
//
// The ignore silences the report where there is one. Where it silences
// nothing, the tool calls it unused. There is one exception. In keeps the
// ignore for a member that no free use reaches, when a constrained file
// reaches the declaration (run.neededWithoutConstrained). That is exactly
// where Out may report the member. How In uses the member does not enter.
// A use behind the constraint, spelled or not, is gone in Out. And a use
// that Out sees anyway keeps Out from reporting the member. Then Out
// reports the stale ignore itself. Out cannot keep an ignore this way. In
// Out the constrained file is not loaded, so it shows no use.
//
// One ignore must pass both runs wherever either run needs it. A stale
// ignore is still reported by Out, which keeps nothing. Where the
// constrained file cannot change what a run sees, the runs judge the ignore
// alike. That is for a declaration other than a member, for one an
// unconstrained file spells, and where no constrained file reaches the
// package. An external test's name is no use in either run.
//
// ASSUME-1: one constrained file is enough, read by In and left out by Out.
//   More constraints make more configurations. Each one is In or Out for
//   that file (modelling assumption).
// ASSUME-2: a constrained file that uses the declaration reaches its
//   package, whether it uses it by name or not. So does an external test. A use is made through an
//   import (modelling assumption, a requirement of configure).
// ASSUME-3: a constrained file uses a declaration other than a member by
//   writing pkg.Name, either its own or a carrier's. So Out reads that use
//   (exclusions.qualifies, exclusions.writes).
//
// An embedded type sits between the two kinds. It is a Member here, as
// run.usedImplicitly makes it. But exclusions.qualifies asks only that it
// is not a field or a method. So Out reads pkg.T in the constrained file as
// a use, as it does for Other. A use as x.T stays unread, as for a Member.
// Where the file writes pkg.T, In sees that use too. Then neither run
// reports the type, and Out calls the ignore unused. The properties still
// hold. The model's Member reports in Out where the tool does not, and
// never the reverse.
fsl 5
spec ShrinkIgnore {
  enum Kind { Member, Other }

  state {
    phase: 0..3 = 0,
    kind: Kind = Member,
    spelledFree: Bool = false,
    spelledConstrained: Bool = false,
    otherUseFree: Bool = false,
    otherUseConstrained: Bool = false,
    carrierSpelledConstrained: Bool = false,
    extTestSpelledConstrained: Bool = false,
    constrainedReaches: Bool = false,
    // wouldReportIn and wouldReportOut: the run would report the
    // declaration without the ignore.
    // ignoreUnusedIn and ignoreUnusedOut: the run reports the ignore unused.
    wouldReportIn: Bool = false,
    wouldReportOut: Bool = false,
    ignoreUnusedIn: Bool = false,
    ignoreUnusedOut: Bool = false
  }

  action configure(
    newKind: Kind,
    newSpelledFree: Bool,
    newSpelledConstrained: Bool,
    newOtherUseFree: Bool,
    newOtherUseConstrained: Bool,
    newCarrierSpelledConstrained: Bool,
    newExtTestSpelledConstrained: Bool,
    newConstrainedReaches: Bool
  ) {
    requires phase == 0
    // ASSUME-2.
    requires not (newSpelledConstrained or newOtherUseConstrained or newCarrierSpelledConstrained or newExtTestSpelledConstrained)
             or newConstrainedReaches
    phase = 1
    kind = newKind
    spelledFree = newSpelledFree
    spelledConstrained = newSpelledConstrained
    otherUseFree = newOtherUseFree
    otherUseConstrained = newOtherUseConstrained
    carrierSpelledConstrained = newCarrierSpelledConstrained
    extTestSpelledConstrained = newExtTestSpelledConstrained
    constrainedReaches = newConstrainedReaches
  }

  // What each run sees as a use. A name an external test writes is not one
  // in either run. The two kinds of constrained use are parameters of In's
  // verdict, so that a property can ask whether it tells them apart.
  def seenInWith(spelled: Bool, other: Bool) =
    spelledFree
    or spelled
    or otherUseFree
    or other
    or carrierSpelledConstrained
  def seenIn() = seenInWith(spelledConstrained, otherUseConstrained)
  def seenOut() =
    spelledFree
    or otherUseFree
    or (kind == Other and (spelledConstrained or otherUseConstrained or carrierSpelledConstrained))
  // In keeps the ignore (run.neededWithoutConstrained).
  def inKeepsWith(spelled: Bool, other: Bool) = kind == Member and not spelledFree and constrainedReaches
  def inUnusedWith(spelled: Bool, other: Bool) =
    seenInWith(spelled, other) and not inKeepsWith(spelled, other)

  fair action judgeIn() {
    requires phase == 1
    phase = 2
    wouldReportIn = not seenIn()
    ignoreUnusedIn = inUnusedWith(spelledConstrained, otherUseConstrained)
  }
  fair action judgeOut() {
    requires phase == 2
    phase = 3
    wouldReportOut = not seenOut()
    ignoreUnusedOut = seenOut()
  }

  // What a run reports is what the ignore silences in that run. An ignore
  // is unused in a run only where that run gives it nothing to silence.
  def ignoreNeeded() = wouldReportIn or wouldReportOut

  // --- properties -----------------------------------------------------------------
  // One ignore passes every configuration where any of them needs it.
  invariant OnePassesEvery {
    (phase == 3 and ignoreNeeded()) => not ignoreUnusedIn and not ignoreUnusedOut
  }
  // How a constrained file uses the declaration does not enter In's verdict
  // on the ignore. A name it spells and an escape, satisfaction, exposure or
  // pairing it makes are judged alike (#171).
  invariant InIgnoresHowTheConstrainedFileUses {
    (phase >= 1 and constrainedReaches)
    => (inUnusedWith(true, false) == inUnusedWith(false, true)
        and inUnusedWith(true, false) == inUnusedWith(true, true))
  }
  // A name an external test writes is no use in either run. So where the
  // constrained file holds nothing else, both runs find the same.
  invariant ExternalTestNameIsNoUseInEither {
    (phase == 3
     and not spelledConstrained
     and not otherUseConstrained
     and not carrierSpelledConstrained)
    => wouldReportIn == wouldReportOut
  }
  // Out reads pkg.Name in the constrained file. So a declaration other than
  // a member is judged alike in both runs.
  invariant NonMemberJudgedAlike {
    (phase == 3 and kind == Other) => ignoreUnusedIn == ignoreUnusedOut
  }
  // A name an unconstrained file spells is a use that both runs see. Then
  // neither needs the ignore, and both report it.
  invariant FreeSpellingJudgedAlike {
    (phase == 3 and spelledFree) => ignoreUnusedIn == ignoreUnusedOut
  }
  // Where no constrained file reaches the package, both runs see the same.
  invariant UnreachedJudgedAlike {
    (phase == 3 and not constrainedReaches) => ignoreUnusedIn == ignoreUnusedOut
  }

  // --- auxiliary ------------------------------------------------------------------
  // Lemmas for induction, not claims. Each run records its judgment. The
  // inputs of that judgment are never assigned again.
  invariant ConstrainedUseReaches {
    (spelledConstrained or otherUseConstrained or carrierSpelledConstrained or extTestSpelledConstrained) => constrainedReaches
  }
  invariant InRecordsItsJudgment {
    phase >= 2 => (wouldReportIn == not seenIn()
                   and ignoreUnusedIn == inUnusedWith(spelledConstrained, otherUseConstrained))
  }
  invariant OutRecordsItsJudgment {
    phase == 3 => (wouldReportOut == not seenOut()
                   and ignoreUnusedOut == seenOut())
  }
  invariant JudgedInFirst { (ignoreUnusedIn or wouldReportIn) => phase >= 2 }
  invariant JudgedOutLast { (ignoreUnusedOut or wouldReportOut) => phase == 3 }

  // --- witnesses ------------------------------------------------------------------
  // #165: a field set only behind a tag. Out reports it. In sees the use.
  // The ignore passes both.
  reachable ConstrainedMemberKept {
    phase == 3
    and kind == Member
    and spelledConstrained
    and not spelledFree
    and not otherUseFree
    and not otherUseConstrained
    and not carrierSpelledConstrained
    and not wouldReportIn
    and wouldReportOut
    and not ignoreUnusedIn
    and not ignoreUnusedOut
  }
  // #171: the code behind the tag only passes a value to an interface. In
  // sees an escape. Out sees nothing. The ignore passes both.
  reachable EscapeBehindConstraintKept {
    phase == 3
    and kind == Member
    and not spelledConstrained
    and not spelledFree
    and not otherUseFree
    and otherUseConstrained
    and not wouldReportIn
    and wouldReportOut
    and not ignoreUnusedIn
    and not ignoreUnusedOut
  }
  // suve's SplitSpec: named and escaped behind the tag alike.
  reachable SpelledAndEscapedBehindConstraintKept {
    phase == 3
    and kind == Member
    and spelledConstrained
    and otherUseConstrained
    and not spelledFree
    and not otherUseFree
    and wouldReportOut
    and not ignoreUnusedIn
    and not ignoreUnusedOut
  }
  // An unconstrained file spells it too. No run needs the ignore, and In
  // says so.
  reachable FreeUseCaughtIn {
    phase == 3
    and kind == Member
    and spelledConstrained
    and spelledFree
    and ignoreUnusedIn
    and ignoreUnusedOut
  }
  // An escape that every configuration reads, beside a use behind the tag.
  // In cannot tell where the escape comes from, and keeps the ignore. Out
  // sees the escape and has nothing to silence. It reports the stale ignore.
  reachable OtherFreeUseCaughtOut {
    phase == 3
    and kind == Member
    and spelledConstrained
    and not spelledFree
    and otherUseFree
    and not wouldReportOut
    and not ignoreUnusedIn
    and ignoreUnusedOut
  }
  // A function used only behind a tag. Out reads the qualified name, so no
  // run needs the ignore.
  reachable ConstrainedNonMemberCaught {
    phase == 3
    and kind == Other
    and spelledConstrained
    and not spelledFree
    and not otherUseFree
    and not otherUseConstrained
    and not carrierSpelledConstrained
    and not wouldReportOut
    and ignoreUnusedIn
    and ignoreUnusedOut
  }
  // A type that only a function called behind a tag returns. Out reads the
  // function's name, and so reads the type as held outside. No run needs the
  // ignore. Before carrierRoots read excluded files, Out reported the type,
  // and no ignore passed both runs.
  reachable ConstrainedCarrierCaught {
    phase == 3
    and kind == Other
    and carrierSpelledConstrained
    and not spelledFree
    and not spelledConstrained
    and not otherUseFree
    and not otherUseConstrained
    and not wouldReportOut
    and ignoreUnusedIn
    and ignoreUnusedOut
  }
  // A function only a tagged external test calls. Both runs report it as
  // used only by external tests, and the ignore silences both.
  reachable ConstrainedExtTestKept {
    phase == 3
    and kind == Other
    and extTestSpelledConstrained
    and not spelledFree
    and not spelledConstrained
    and not otherUseFree
    and not otherUseConstrained
    and not carrierSpelledConstrained
    and wouldReportIn
    and wouldReportOut
    and not ignoreUnusedIn
    and not ignoreUnusedOut
  }
  // Nothing uses it. Both runs report it, and the ignore silences both.
  reachable UnusedDeclarationSilenced {
    phase == 3
    and not spelledFree
    and not spelledConstrained
    and not otherUseFree
    and not otherUseConstrained
    and not carrierSpelledConstrained
    and wouldReportIn
    and wouldReportOut
    and not ignoreUnusedIn
    and not ignoreUnusedOut
  }

  leadsTo BothRunsJudge {
    phase >= 1 ~> phase == 3
    decreases 3 - phase
  }
}
