// qualify and unqualify are mutually exclusive, and each fix removes the
// violation it addresses.
//
// The scope settings are not read by these rules, so they are left out: 288
// action instances.
spec LabelRules {
  enum Qualify { Always, OnDemand, Never }
  enum Kind    { Pkg, Member }
  enum Label   { NoLabel, Prefixed, Equal }
  enum Fix     { NoFix, FixedQualify, FixedUnqualify }

  state {
    configured: Bool, cfgQualify: Qualify, cfgUnqualify: Bool, manyNs: Bool,
    kind: Kind, exported: Bool, hasNs: Bool, label: Label, lastFix: Fix
  }
  init {
    configured = false  cfgQualify = OnDemand  cfgUnqualify = false  manyNs = false
    kind = Pkg  exported = false  hasNs = true  label = NoLabel  lastFix = NoFix
  }
  action configure(p: Qualify, d: Bool, m: Bool, k: Kind, x: Bool, h: Bool, l: Label) {
    requires not configured
    configured = true  cfgQualify = p  cfgUnqualify = d  manyNs = m
    kind = k  exported = x  hasNs = h  label = l
  }
  def qualifyRequired() = cfgQualify == Always or (cfgQualify == OnDemand and manyNs)
  def qualifyFires() = qualifyRequired() and kind == Pkg and hasNs and not exported and label == NoLabel
  def unqualifyFires() = cfgUnqualify and kind == Pkg and hasNs and not qualifyRequired()
                         and not exported and label == Prefixed

  fair action fixQualify()   { requires configured  requires qualifyFires()    label = Prefixed  lastFix = FixedQualify }
  fair action fixUnqualify() { requires configured  requires unqualifyFires()  label = NoLabel   lastFix = FixedUnqualify }

  invariant Exclusive           { not (qualifyFires() and unqualifyFires()) }
  invariant QualifyFixSettles   { lastFix == FixedQualify   => not qualifyFires() }
  invariant UnqualifyFixSettles { lastFix == FixedUnqualify => not unqualifyFires() }
  reachable QualifyCanFire   { configured and qualifyFires() }
  reachable UnqualifyCanFire { configured and unqualifyFires() }
}
