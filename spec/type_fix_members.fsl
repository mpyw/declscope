// What the boundary fix of a type does to the members of the type. And that
// the run still converges.
//
// The fix writes //declscope:shared on a type that crosses and took its
// private scope from defaults.unexported. The directive reaches every member
// that states no scope of its own. So the one edit decides three rules at
// once:
//
//   boundary  A member that another namespace spells crossed with the type.
//             The same directive settles it. fix_members.fsl proves that the
//             own fix of the member is then dropped, not written beside the
//             fix of the type.
//   surplus   Under strict, a member that no other namespace reaches would
//             come out widened for nothing. Strict reports exactly that. The
//             fix narrows the member with //declscope:private in the same
//             edit (surplusNarrowedByTypeFix).
//   unused    The own //declscope:shared of a member binds only while the
//             type states no scope. Once the type is widened, it gives the
//             member that scope anyway. The unused rule then reports the
//             directive of the author, and no fix may delete it. So the fix
//             is withheld there, and the report is not. The member that
//             crosses takes its own fix (unboundAtScopeSite).
//
// One member is judged. A sibling stands for every other member. A sibling
// matters only through the directive it states. The //declscope:shared of a
// sibling withholds the fix of the type, just as the member's own does. The
// member then takes its own fix where it crosses.
//
// memberReach is the set of reach paths from surplus_strict.fsl. The three
// paths that spell nothing are folded into ReachedUnspelled. The boundary
// rule reads only a spelled use. Every other path keeps the member wide all
// the same. Strict would otherwise judge the member. Two reasons are left
// that stop it:
//   - lineHasReachedOrExportedName: another name on its line is reached or
//     exported.
//   - hasSurplusIgnore: an ignore the member already carries answers the rule.
//
// No action assigns the authored source after configuration. What the run
// wrote is recorded in typeFixed, memberNarrowed and memberFixed. The "after"
// defs put the two together, as in fix_members.fsl.
//
// Where the fix of the type is withheld, its boundary report is kept
// (ReportKeptWhereFixWithheld). The report does not read the guard of the fix.
//
// Some duties hold by a guard alone, so no property states them. Any property
// would restate the guard. Witnesses show them instead. The fix never writes
// over a member's own directive. It is withheld where it would leave an
// authored directive binding nothing. It narrows the member that strict would
// report.
//
// ASSUME-1: the type is unexported. No directive is written on it or on its
//   file. defaults.unexported is private. Another namespace spells the type.
//   That is the only case where the fix is offered. boundary_fix.fsl
//   withholds it everywhere else. Spelled, the type keeps its new directive
//   in use. So surplus loose never condemns it (modelling assumption).
// ASSUME-2: one member and one sibling are enough. Every member is judged
//   alone, except through the fix of the type. The sibling stands for that
//   (modelling assumption).
fsl 5
spec TypeFixMembers {
  enum Scope { Shared, Private }
  enum Directive { NoDirective, SharedDirective, PrivateDirective }
  enum RuleMode { Off, Loose, Strict }
  enum Reach { Unreached, SpelledElsewhere, ReachedUnspelled }

  state {
    phase: 0..2 = 0,
    unusedMode: RuleMode = Strict,
    surplusMode: RuleMode = Strict,
    seesAllFiles: Bool = true,
    // An ignore or the baseline answers the boundary report of the type. So
    // the run writes no fix on it and subsumes nothing.
    typeAnswered: Bool = false,
    // The boundary report of the type. ASSUME-1 says the type crosses.
    typeReported: Bool = false,
    memberExported: Bool = false,
    memberDirective: Directive = NoDirective,
    memberReach: Reach = Unreached,
    lineHasReachedOrExportedName: Bool = false,
    hasSurplusIgnore: Bool = false,
    siblingExported: Bool = false,
    siblingDirective: Directive = NoDirective,
    // What the run wrote.
    typeFixed: Bool = false,
    memberNarrowed: Bool = false,
    memberFixed: Bool = false,
    stalled: Bool = false
  }

  // Configuration takes two steps, not one. So no one action carries the
  // product of every parameter.
  action configureRules(newUnusedMode: RuleMode, newSurplusMode: RuleMode,
                        newSeesAllFiles: Bool, newTypeAnswered: Bool) {
    requires phase == 0
    phase = 1
    unusedMode = newUnusedMode
    surplusMode = newSurplusMode
    seesAllFiles = newSeesAllFiles
    typeAnswered = newTypeAnswered
  }
  action configureMembers(newMemberExported: Bool, newMemberDirective: Directive,
                          newMemberReach: Reach,
                          newLineHasReachedOrExportedName: Bool,
                          newHasSurplusIgnore: Bool,
                          newSiblingExported: Bool,
                          newSiblingDirective: Directive) {
    requires phase == 1
    phase = 2
    memberExported = newMemberExported
    memberDirective = newMemberDirective
    memberReach = newMemberReach
    lineHasReachedOrExportedName = newLineHasReachedOrExportedName
    hasSurplusIgnore = newHasSurplusIgnore
    siblingExported = newSiblingExported
    siblingDirective = newSiblingDirective
  }
  def configured() = phase == 2

  // --- scope resolution, for a member -------------------------------------
  // The order is: its own directive, the directive of its type, exportedness,
  // then the default. ASSUME-1 fixes the default at private. No file
  // directive is written.
  def scopeStatedBy(directive: Directive) =
    if directive == SharedDirective then Shared else Private
  def scopeOf(own: Directive, onType: Directive, isExported: Bool) =
    if own != NoDirective then scopeStatedBy(own)
    else if onType != NoDirective then scopeStatedBy(onType)
    else if isExported then Shared
    else Private
  // The scope a member would take without its own directive, under the
  // configuration in force. And whether that scope is the same under every
  // configuration. It is not when only defaults.unexported decides it.
  def outerScopeIsConfigIndependent(onType: Directive, isExported: Bool) =
    onType != NoDirective or isExported
  def outerScope(onType: Directive, isExported: Bool) =
    scopeOf(NoDirective, onType, isExported)
  // The two judgments of one directive in unused_modes.fsl. Loose reports a
  // directive that binds nothing under any configuration. Strict also
  // reports one that restates the scope in force. This is a hand copy of
  // that rule. Nothing links the two, so change both together.
  def unusedReports(own: Directive, onType: Directive, isExported: Bool) =
    own != NoDirective
    and (
      (unusedMode == Loose
        and outerScopeIsConfigIndependent(onType, isExported)
        and scopeStatedBy(own) == outerScope(onType, isExported))
      or (unusedMode == Strict
        and scopeStatedBy(own) == outerScope(onType, isExported))
    )

  // --- the pre-fix source, which every guard reads -------------------------
  def memberCrossesBefore() =
    scopeOf(memberDirective, NoDirective, memberExported) == Private
    and memberReach == SpelledElsewhere

  // A directive of a member that binds today and would bind nothing under the
  // widened type.
  def unbinds(own: Directive, isExported: Bool) =
    unusedReports(own, SharedDirective, isExported)
    and not unusedReports(own, NoDirective, isExported)
  def unbindsAMember() =
    unbinds(memberDirective, memberExported)
    or unbinds(siblingDirective, siblingExported)

  def typeFixable() =
    configured()
    and not typeAnswered
    and not unbindsAMember()

  // What surplus strict asks of the member, apart from where its scope comes
  // from. Strict is on. The pass reads every file. The member is unexported
  // and reached from no other namespace. No name on its line is reached or
  // exported. It carries no surplus ignore.
  def strictAppliesToMember() =
    surplusMode == Strict
    and seesAllFiles
    and not memberExported
    and memberReach == Unreached
    and not lineHasReachedOrExportedName
    and not hasSurplusIgnore

  // surplusNarrowedByTypeFix narrows a member that strict would judge and
  // that states no scope of its own.
  def narrowingWanted() = strictAppliesToMember() and memberDirective == NoDirective

  // A pass that reported and did not fix.
  action reportWithoutFix() {
    requires configured()
    stalled = true
  }

  // The type crosses by ASSUME-1. An ignore or the baseline answers the
  // report, so the run emits none then. Nothing else is read.
  fair action reportType() {
    requires configured()
    requires not typeAnswered
    requires not typeReported
    typeReported = true
  }

  fair action fixType() {
    requires typeFixable()
    requires not typeFixed
    typeFixed = true
    memberNarrowed = narrowingWanted()
  }
  fair action fixMember() {
    requires configured()
    requires not memberFixed
    requires memberCrossesBefore()
    requires memberDirective == NoDirective
    // The subsumption from fix_members.fsl. When the run writes a fix on the
    // type, that fix settles the member. The own fix of the member would then
    // bind nothing.
    requires not typeFixable()
    memberFixed = true
  }

  // --- what the source says once the run has finished ----------------------
  def typeDirectiveAfter() = if typeFixed then SharedDirective else NoDirective
  def memberDirectiveAfter() =
    if memberNarrowed then PrivateDirective
    else if memberFixed then SharedDirective
    else memberDirective
  def memberCrossesAfter() =
    scopeOf(memberDirectiveAfter(), typeDirectiveAfter(), memberExported) == Private
    and memberReach == SpelledElsewhere

  // surplus strict on the member, over the fixed source. The member takes
  // shared scope from the directive of the type alone, and nothing excuses it.
  def strictReportsAfter() =
    strictAppliesToMember()
    and memberDirectiveAfter() == NoDirective
    and typeDirectiveAfter() == SharedDirective

  // --- auxiliary ------------------------------------------------------------
  // Nothing assigns the inputs once they are configured. So each guard still
  // holds of the state it fired in.
  invariant FixImpliesConfigured {
    (typeFixed or memberFixed or stalled or typeReported) => configured()
  }
  invariant TypeFixRecordsItsGuard { typeFixed => typeFixable() }
  invariant NarrowingRecordsItsGuard {
    memberNarrowed == (typeFixed and narrowingWanted())
  }
  invariant MemberFixRecordsItsGuard {
    memberFixed =>
      memberCrossesBefore()
      and memberDirective == NoDirective
      and not typeFixable()
  }

  // --- what the run leaves: boundary ----------------------------------------
  // No boundary report is left on a member a fix was written for.
  invariant MemberCrossingSettled {
    (typeFixed or memberFixed) and memberDirective == NoDirective
      => not memberCrossesAfter()
  }
  // No member that another namespace spells is narrowed. So there is no
  // boundary report the run did not start with.
  invariant NoNewBoundary { memberCrossesAfter() => memberCrossesBefore() }

  // --- what the run leaves: unused ------------------------------------------
  // The own fix of a member binds, under either unused mode. So it is never
  // written beside the fix of the type.
  //
  // Two inserted directives always bind in this model, so no property states
  // them. The directive of the type binds by ASSUME-1: the type takes private
  // from the default, and the fix makes it shared. A narrowed member states
  // private under the new shared directive of the type.
  invariant InsertedMemberDirectiveBinds {
    memberFixed
      => not unusedReports(memberDirectiveAfter(), typeDirectiveAfter(), memberExported)
  }

  // --- what the run leaves: the edits ---------------------------------------
  // The member never carries two insertions.
  invariant OneInsertionPerMember { not (memberNarrowed and memberFixed) }

  // --- witnesses, each with every other reason pinned ---------------------
  reachable NarrowedWithTheType {
    memberNarrowed
    and unusedMode == Strict
    and not strictReportsAfter()
    and not memberCrossesAfter()
  }
  reachable SettledByTheType {
    typeFixed
    and not memberFixed
    and memberDirective == NoDirective
    and not memberExported
    and memberCrossesBefore()
    and not memberCrossesAfter()
  }
  reachable WidenedOverAnUnspelledReach {
    typeFixed
    and surplusMode == Strict
    and seesAllFiles
    and not memberExported
    and memberDirective == NoDirective
    and memberReach == ReachedUnspelled
    and not lineHasReachedOrExportedName
    and not hasSurplusIgnore
    and not memberNarrowed
  }
  reachable WidenedInAMixedEntry {
    typeFixed
    and surplusMode == Strict
    and seesAllFiles
    and not memberExported
    and memberDirective == NoDirective
    and memberReach == Unreached
    and lineHasReachedOrExportedName
    and not hasSurplusIgnore
    and not memberNarrowed
  }
  reachable WidenedUnderAnIgnore {
    typeFixed
    and surplusMode == Strict
    and seesAllFiles
    and not memberExported
    and memberDirective == NoDirective
    and memberReach == Unreached
    and not lineHasReachedOrExportedName
    and hasSurplusIgnore
    and not memberNarrowed
  }
  reachable WidenedByABlindPass {
    typeFixed
    and surplusMode == Strict
    and not seesAllFiles
    and not memberExported
    and memberDirective == NoDirective
    and memberReach == Unreached
    and not lineHasReachedOrExportedName
    and not hasSurplusIgnore
    and not memberNarrowed
  }
  reachable WidenedUnderLoose {
    typeFixed
    and surplusMode == Loose
    and seesAllFiles
    and not memberExported
    and memberDirective == NoDirective
    and memberReach == Unreached
    and not lineHasReachedOrExportedName
    and not hasSurplusIgnore
    and not memberNarrowed
  }
  reachable ExportedMemberWidened {
    typeFixed
    and surplusMode == Strict
    and seesAllFiles
    and memberExported
    and memberDirective == NoDirective
    and memberReach == Unreached
    and not lineHasReachedOrExportedName
    and not hasSurplusIgnore
    and not memberNarrowed
  }
  reachable OwnPrivateKept {
    typeFixed
    and memberDirective == PrivateDirective
    and not memberExported
    and unusedMode == Strict
    and not unusedReports(memberDirective, typeDirectiveAfter(), memberExported)
  }

  // The guard from unboundAtScopeSite. The fix is withheld over the own
  // shared directive of an unexported member, and the report is kept.
  reachable WithheldOverOwnShared {
    configured()
    and stalled
    and typeReported
    and not typeFixable()
    and not typeAnswered
    and memberDirective == SharedDirective
    and not memberExported
    and siblingDirective == NoDirective
    and unusedMode != Off
  }
  // The sibling withholds the fix, and the member that crosses takes its own.
  reachable SiblingWithholdsAndMemberTakesItsOwn {
    memberFixed
    and not typeAnswered
    and siblingDirective == SharedDirective
    and not siblingExported
    and unusedMode == Loose
    and not memberCrossesAfter()
  }
  // The guard is no wider than it must be. The fix is offered in two cases:
  // with unused off, and over the directive of an exported member that
  // already binds nothing.
  reachable FixedOverOwnSharedWhenUnusedOff {
    typeFixed
    and memberDirective == SharedDirective
    and not memberExported
    and unusedMode == Off
  }
  // The fix of the type keeps the own directive of the author, even where
  // strict would narrow the member without it.
  reachable OwnSharedKeptWhereStrictApplies {
    typeFixed
    and memberDirective == SharedDirective
    and memberDirectiveAfter() == SharedDirective
    and strictAppliesToMember()
  }
  reachable FixedOverAnExportedOwnShared {
    typeFixed
    and memberDirective == SharedDirective
    and memberExported
    and unusedMode == Strict
    and unusedReports(memberDirective, NoDirective, memberExported)
  }
  // An answered type writes nothing. So the fix of the member is not
  // subsumed.
  reachable MemberFixedWhereTypeAnswered {
    memberFixed
    and typeAnswered
    and not unbindsAMember()
    and not memberCrossesAfter()
  }
  reachable PendingSurvivesAPass {
    stalled
    and typeFixable()
    and not typeFixed
  }

  // Where the fix of the type is withheld, its boundary report is still
  // made.
  leadsTo ReportKeptWhereFixWithheld {
    configured() and not typeAnswered and not typeFixable() ~> typeReported
    helpful reportType()
    decreases if typeReported then 0 else 1
  }
  leadsTo MemberEventuallySettled {
    configured() and memberCrossesBefore() and memberDirective == NoDirective
      ~> not memberCrossesAfter()
    helpful fixType()
    helpful fixMember()
    decreases if memberCrossesAfter() then 1 else 0
  }
}
