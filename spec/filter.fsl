// filter decides which files the analysis reads. It replaces exclude, which
// could only subtract.
//
//   filter:
//     only: [ ... ]   # nothing outside these
//     omit: [ ... ]   # and not these
//
// Each list holds patterns. A file matches a list when it matches ANY pattern
// in it. An empty only list does not mean "match nothing". It means "no
// restriction". That is why a file is still read when neither list is set.
//
// Three patterns are enough. The claims here are about which list holds a
// pattern and whether the file matches it. They are not about how many
// patterns there are. "Any of them" needs more than one pattern to mean
// anything. Whether a pattern matches a path is the subject of filter.go, and
// this spec does not model it. It takes the match as an input.
//
// A reader first asks about order. There is no order to get wrong. "Keep only,
// then subtract omit" and "subtract omit from everything, then keep only" name
// the same set. Each stage keeps a subset of what it is handed, and it asks
// only about the one file. Options.Skips narrows first. This spec runs the
// other order as a second pipeline of two stages. Each stage reads what the
// stage before it left. OrderDoesNotMatter compares what the two pipelines
// recorded. Suppose a stage did more than narrow what it was handed. For
// example, an only that admits every file it matches, whatever omit removed.
// Then the two pipelines would disagree.
fsl 5
spec Filter {
  state {
    configured: Bool = false,
    // The only list: which of the three patterns it holds.
    onlyHolds0: Bool = false,
    onlyHolds1: Bool = false,
    onlyHolds2: Bool = false,
    // The omit list, over the same three patterns.
    omitHolds0: Bool = false,
    omitHolds1: Bool = false,
    omitHolds2: Bool = false,
    // Which of the three patterns this file matches.
    fileMatches0: Bool = false,
    fileMatches1: Bool = false,
    fileMatches2: Bool = false,
    // The decision is recorded, and that makes the guards below load-bearing.
    // An invariant over the defs alone would hold however the actions were
    // guarded. Deleting a guard would not break it.
    decided: Bool = false,
    admitted: Bool = false,
    // The other order, subtract then narrow, recorded stage by stage.
    // survivesOmit is what the first stage leaves for the second to narrow.
    omitStageRan: Bool = false,
    survivesOmit: Bool = false,
    narrowStageRan: Bool = false,
    reorderedAdmitted: Bool = false
  }

  action configure(givenOnlyHolds0: Bool,
                   givenOnlyHolds1: Bool,
                   givenOnlyHolds2: Bool,
                   givenOmitHolds0: Bool,
                   givenOmitHolds1: Bool,
                   givenOmitHolds2: Bool,
                   givenFileMatches0: Bool,
                   givenFileMatches1: Bool,
                   givenFileMatches2: Bool) {
    requires not configured
    configured = true
    onlyHolds0 = givenOnlyHolds0
    onlyHolds1 = givenOnlyHolds1
    onlyHolds2 = givenOnlyHolds2
    omitHolds0 = givenOmitHolds0
    omitHolds1 = givenOmitHolds1
    omitHolds2 = givenOmitHolds2
    fileMatches0 = givenFileMatches0
    fileMatches1 = givenFileMatches1
    fileMatches2 = givenFileMatches2
  }

  // An empty only list places no restriction. This is the one asymmetry
  // worth stating. An empty omit list subtracts nothing, and that follows
  // from "any". An empty only list admitting everything does not follow.
  // Each def below takes a list as three flags, one per pattern. Then the
  // monotonicity claims can ask about a list with one more pattern in it.
  def listEmpty(holds0: Bool, holds1: Bool, holds2: Bool) =
    not holds0 and not holds1 and not holds2

  // Any pattern is enough, in both lists.
  def fileMatchesList(holds0: Bool, holds1: Bool, holds2: Bool) =
    (holds0 and fileMatches0)
    or (holds1 and fileMatches1)
    or (holds2 and fileMatches2)

  def passesOnlyList(only0: Bool, only1: Bool, only2: Bool) =
    listEmpty(only0, only1, only2) or fileMatchesList(only0, only1, only2)
  def keeps(only0: Bool, only1: Bool, only2: Bool,
            omit0: Bool, omit1: Bool, omit2: Bool) =
    passesOnlyList(only0, only1, only2)
    and not fileMatchesList(omit0, omit1, omit2)

  // The same rule applied to the configured lists.
  def onlyEmpty() = listEmpty(onlyHolds0, onlyHolds1, onlyHolds2)
  def omitEmpty() = listEmpty(omitHolds0, omitHolds1, omitHolds2)
  def fileMatchesOnly() = fileMatchesList(onlyHolds0, onlyHolds1, onlyHolds2)
  def fileMatchesOmit() = fileMatchesList(omitHolds0, omitHolds1, omitHolds2)
  def passesOnly() = passesOnlyList(onlyHolds0, onlyHolds1, onlyHolds2)
  def filterKeeps() =
    keeps(onlyHolds0, onlyHolds1, onlyHolds2,
          omitHolds0, omitHolds1, omitHolds2)

  // Each stage takes what the stage before it handed on, and asks only about
  // this file.
  def narrowStage(handed: Bool) = handed and passesOnly()
  def subtractStage(handed: Bool) = handed and not fileMatchesOmit()

  // --- the two tests, as the implementation applies them --------------------
  // The two tests are two guards on one action, not one expression. Then
  // dropping either one is a change an invariant can see.
  action admit() {
    requires configured
    requires not decided
    requires passesOnly()
    requires not fileMatchesOmit()
    decided = true
    admitted = true
  }
  action rejectByOnly() {
    requires configured
    requires not decided
    requires not onlyEmpty()
    requires not fileMatchesOnly()
    decided = true
    admitted = false
  }
  action rejectByOmit() {
    requires configured
    requires not decided
    requires fileMatchesOmit()
    decided = true
    admitted = false
  }

  // --- the other order, subtract then narrow --------------------------------
  // Every file starts in. Each stage keeps a subset of what it is handed.
  action subtractFirst() {
    requires configured
    requires not omitStageRan
    omitStageRan = true
    survivesOmit = subtractStage(true)
  }
  // The second stage runs after the implementation's order has decided.
  // Then the step that records it can be compared with that decision.
  action narrowSecond() {
    requires omitStageRan
    requires decided
    requires not narrowStageRan
    narrowStageRan = true
    reorderedAdmitted = narrowStage(survivesOmit)
  }

  // Each stage keeps a subset of what it is handed. A file the stage before
  // dropped stays dropped. A stage that admitted a file it was not handed
  // could undo the other list, and the order would then matter.
  invariant EachStageKeepsASubset {
    configured
      => not narrowStage(false)
         and not subtractStage(false)
  }

  // Order is not a degree of freedom. Two pipelines decide the file alike.
  // One is the implementation's two guards. The other subtracts omit first
  // and then narrows what is left to only. Different actions record the two
  // sides. It is a trans, checked on the step that finishes the second
  // pipeline. By then the first decision is settled.
  //
  // What it shows: the guards on admit and reject compose like the stages.
  // Dropping a guard, or a stage that ignores what it is handed, breaks it.
  // What it does not show: that the per-file rule is right. Both sides call
  // passesOnly() and fileMatchesOmit(). So a wrong match def passes it. The
  // monotonicity claims and the witnesses below check those defs.
  trans OrderDoesNotMatter {
    not old(narrowStageRan) and narrowStageRan => (reorderedAdmitted == admitted)
  }

  // --- adding a pattern moves the decision one way only ---------------------
  // A rejected file stays rejected with any one more omit pattern.
  invariant AnotherOmitPatternNeverAdmits {
    decided and not admitted
      => not keeps(onlyHolds0, onlyHolds1, onlyHolds2,
                   true, omitHolds1, omitHolds2)
         and not keeps(onlyHolds0, onlyHolds1, onlyHolds2,
                       omitHolds0, true, omitHolds2)
         and not keeps(onlyHolds0, onlyHolds1, onlyHolds2,
                       omitHolds0, omitHolds1, true)
  }
  // An admitted file stays admitted with any one more only pattern. This
  // needs a non-empty only. An empty only admits everything, so its first
  // pattern can reject a file.
  invariant AnotherOnlyPatternNeverRejects {
    decided and admitted and not onlyEmpty()
      => keeps(true, onlyHolds1, onlyHolds2,
               omitHolds0, omitHolds1, omitHolds2)
         and keeps(onlyHolds0, true, onlyHolds2,
                   omitHolds0, omitHolds1, omitHolds2)
         and keeps(onlyHolds0, onlyHolds1, true,
                   omitHolds0, omitHolds1, omitHolds2)
  }

  // Both orders run to a decision on files of every kind, so the comparison
  // is not vacuous. One file only admits. Omit removes the other from inside
  // only.
  reachable BothOrdersAdmitWhatSurvivesBoth {
    decided
    and narrowStageRan
    and admitted
    and onlyHolds0
    and fileMatches0
    and omitHolds1
    and not fileMatches1
  }
  reachable BothOrdersRejectWhatOmitRemovesInsideOnly {
    decided
    and narrowStageRan
    and not admitted
    and onlyHolds0
    and fileMatches0
    and omitHolds0
  }

  // --- neither list: everything is read -------------------------------------
  reachable NoListsAdmitsAFileMatchingNothing {
    decided
    and admitted
    and onlyEmpty()
    and omitEmpty()
    and not fileMatches0
    and not fileMatches1
    and not fileMatches2
  }

  // --- only alone narrows ---------------------------------------------------
  reachable OnlyAloneAdmitsAMatch {
    decided
    and admitted
    and omitEmpty()
    and onlyHolds1
    and fileMatches1
  }
  reachable OnlyAloneRejectsANonMatch {
    decided
    and not admitted
    and omitEmpty()
    and onlyHolds0
    and not fileMatches0
    and not fileMatches1
    and not fileMatches2
  }
  // Any of them is enough. The file matches the second pattern and not the
  // first, and it is still in. The third pattern is not listed. So the second
  // pattern is what admits it.
  reachable OnlyMatchesAnyOfSeveral {
    decided
    and admitted
    and omitEmpty()
    and onlyHolds0
    and onlyHolds1
    and not onlyHolds2
    and not fileMatches0
    and fileMatches1
  }
  // The third pattern alone admits the file. Each pattern has a witness where
  // it is the one that decides. So an "any" that skipped one would be caught.
  reachable OnlyPatternTwoAloneAdmits {
    decided
    and admitted
    and omitEmpty()
    and not onlyHolds0
    and not onlyHolds1
    and onlyHolds2
    and fileMatches2
  }
  // A listed pattern the file does not match decides nothing on its own.
  reachable UnmatchedOnlyPatternDoesNotAdmit {
    decided
    and not admitted
    and omitEmpty()
    and onlyHolds0
    and onlyHolds1
    and not fileMatches0
    and not fileMatches1
  }

  // --- omit alone subtracts, which is what exclude did ----------------------
  reachable OmitAloneRejectsAMatch {
    decided
    and not admitted
    and onlyEmpty()
    and not omitHolds0
    and not omitHolds1
    and omitHolds2
    and fileMatches2
  }
  reachable OmitAloneAdmitsANonMatch {
    decided
    and admitted
    and onlyEmpty()
    and omitHolds0
    and not fileMatches0
  }
  reachable OmitMatchesAnyOfSeveral {
    decided
    and not admitted
    and onlyEmpty()
    and omitHolds0
    and omitHolds1
    and not omitHolds2
    and not fileMatches0
    and fileMatches1
  }

  // --- both lists: omit still bites inside only, and only still narrows -----
  // The pair stops one list from swallowing the other. Both lists are set in
  // each. In the first, omit rejects the file. In the second, only is meant to
  // reject it. The patterns that play no part are left out of both lists.
  reachable OmitStillBitesInsideOnly {
    decided
    and not admitted
    and onlyHolds0
    and fileMatches0
    and omitHolds0
    and not omitHolds1
    and not omitHolds2
  }
  reachable OnlyStillNarrowsAlongsideOmit {
    decided
    and not admitted
    and onlyHolds0
    and omitHolds1
    and not onlyHolds2
    and not omitHolds2
    and not fileMatches0
    and not fileMatches1
    and fileMatches2
  }
  // The third pattern is in neither list. So the first pattern is what
  // admits the file.
  reachable BothListsAdmitWhatSurvivesBoth {
    decided
    and admitted
    and onlyHolds0
    and fileMatches0
    and omitHolds1
    and not fileMatches1
    and not onlyHolds2
    and not omitHolds2
  }

  // --- auxiliary ------------------------------------------------------------
  invariant DecisionNeedsConfig { decided => configured }
  // Lemma, not a claim: it restates the guards so that induction can prove
  // the monotonicity claims.
  invariant DecisionFollowsTheRule { decided => (admitted == filterKeeps()) }
  // Lemma, not a claim: it restates subtractFirst so that induction can prove
  // OrderDoesNotMatter.
  invariant OmitStageRecordsOmit {
    omitStageRan
      => configured
         and survivesOmit == subtractStage(true)
  }
}
