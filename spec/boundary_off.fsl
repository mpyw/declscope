// rules.boundary: off switches the boundary rule off. It touches no report of
// another rule.
//
// The key exists for a repository that wants the ownership mark in a name
// without the scope behind it. The "nothing else" is what makes the key
// acceptable. A key that silenced a rule its name does not mention would be
// the shape this project set out to avoid. A later change that tries to be
// helpful is the most likely way to introduce that shape.
//
// With boundary off, surplus still audits //declscope:shared directives. Some
// of them no longer do a job. The README says to set both keys. That is advice
// to a reader, not a coupling in the code. SurplusFiresWhileBoundaryOff below
// fails if someone makes it one.
//
// Boundary off does change one fix that another rule offers. The strict
// `unused` fix deletes a redundant directive. It is withheld while a
// declaration the directive reaches would cross a boundary without it. That
// is scopesiteRemovals.decide in internal/scopesite.go. With boundary off, no
// crossing is reported. So nothing withholds the deletion, and the fix is
// offered. The fix follows the reports it could change. No report is being
// silenced. unused_modes.fsl models the withholding. It takes the crossing as
// its input aCrosses, which is false under boundary off. This spec models
// reports only.
//
// Scope resolution is the subject of knobs.fsl and is not repeated here. This
// spec takes the resolved scope as an input. rules.boundary is a gate on the
// report, not a part of the resolution.
fsl 5
spec BoundaryOff {
  enum Scope { Shared, Private }
  enum ReferencedFrom { Nowhere, SameNamespace, OtherNamespace }
  // The three modes of the naming rule. OnDemand applies only once a package
  // holds a second namespace. That is why the namespace count is an input
  // below.
  enum NamingMode { Never, OnDemand, Always }

  state {
    configured: Bool = false,
    // The two switches: rules.boundary and rules.surplus, each set to off.
    boundaryOff: Bool = false,
    surplusOff: Bool = false,
    // What each rule reads.
    resolvedScope: Scope = Private,
    referencedFrom: ReferencedFrom = Nowhere,
    namingMode: NamingMode = Never,
    nameCarriesNamespace: Bool = false,
    hasTwoNamespaces: Bool = false,
    hasSharedDirective: Bool = false,
    sawEveryFile: Bool = false,
    // Each report is recorded, so the witnesses below see a guard that
    // stops it.
    boundaryReported: Bool = false,
    qualifyReported: Bool = false,
    surplusReported: Bool = false
  }

  action configure(newBoundaryOff: Bool, newSurplusOff: Bool,
                   newResolvedScope: Scope, newReferencedFrom: ReferencedFrom,
                   newNamingMode: NamingMode, newNameCarriesNamespace: Bool,
                   newHasTwoNamespaces: Bool, newHasSharedDirective: Bool,
                   newSawEveryFile: Bool) {
    requires not configured
    configured = true
    boundaryOff = newBoundaryOff
    surplusOff = newSurplusOff
    resolvedScope = newResolvedScope
    referencedFrom = newReferencedFrom
    namingMode = newNamingMode
    nameCarriesNamespace = newNameCarriesNamespace
    hasTwoNamespaces = newHasTwoNamespaces
    hasSharedDirective = newHasSharedDirective
    sawEveryFile = newSawEveryFile
  }

  // The naming rule applies always, never, or once a second namespace exists.
  def qualifyApplies() =
    if namingMode == Always then true
    else if namingMode == OnDemand then hasTwoNamespaces
    else false

  // --- the three gates ---------------------------------------------------------
  // internal/finding.go holds the boundary and naming gates.
  // internal/surplus.go holds the surplus gate. boundaryOff appears in exactly
  // one of them. Each verdict takes both switches as parameters, so the
  // invariants below can compare both values of the switch it must not read.
  def boundaryFiresWith(boundarySwitchOff: Bool, surplusSwitchOff: Bool) =
    not boundarySwitchOff
    and resolvedScope == Private
    and referencedFrom == OtherNamespace
  def qualifyFiresWith(boundarySwitchOff: Bool, surplusSwitchOff: Bool) =
    qualifyApplies()
    and not nameCarriesNamespace
  def surplusFiresWith(boundarySwitchOff: Bool, surplusSwitchOff: Bool) =
    not surplusSwitchOff
    and sawEveryFile
    and hasSharedDirective
    and referencedFrom != OtherNamespace

  action reportBoundary() {
    requires configured
    requires boundaryFiresWith(boundaryOff, surplusOff)
    boundaryReported = true
  }

  action reportQualify() {
    requires configured
    requires qualifyFiresWith(boundaryOff, surplusOff)
    qualifyReported = true
  }

  action reportSurplus() {
    requires configured
    requires surplusFiresWith(boundaryOff, surplusOff)
    surplusReported = true
  }

  // --- the main claim, for all inputs -----------------------------------------
  // rules.boundary: off changes no verdict of another rule.
  invariant QualifyIgnoresBoundaryOff {
    qualifyFiresWith(true, surplusOff) == qualifyFiresWith(false, surplusOff)
  }
  invariant SurplusIgnoresBoundaryOff {
    surplusFiresWith(true, surplusOff) == surplusFiresWith(false, surplusOff)
  }
  // rules.surplus: off changes no verdict of another rule either. So the two
  // keys are independent in both directions.
  invariant BoundaryIgnoresSurplusOff {
    boundaryFiresWith(boundaryOff, true) == boundaryFiresWith(boundaryOff, false)
  }
  invariant QualifyIgnoresSurplusOff {
    qualifyFiresWith(boundaryOff, true) == qualifyFiresWith(boundaryOff, false)
  }

  // --- witnesses --------------------------------------------------------------
  // The boundary rule fires with its switch on.
  reachable BoundaryFiresWhenOn {
    not boundaryOff
    and resolvedScope == Private
    and referencedFrom == OtherNamespace
    and boundaryReported
  }
  // Each of these fails as soon as boundaryOff is added to the guard of
  // another rule.
  reachable QualifyFiresWhileBoundaryOff {
    boundaryOff
    and qualifyApplies()
    and not nameCarriesNamespace
    and qualifyReported
  }
  // The naming rule is off here too. So surplus is shown to need neither
  // the boundary rule nor the naming rule.
  reachable SurplusFiresWhileBoundaryOff {
    boundaryOff
    and namingMode == Never
    and sawEveryFile
    and hasSharedDirective
    and referencedFrom != OtherNamespace
    and surplusReported
  }
  // Boundary is off, boundary is silent, and the naming rule reports. The
  // README describes this state for a repository that takes the naming rule
  // and nothing else. So surplus is off as well.
  reachable NamingRuleAloneStillReports {
    boundaryOff
    and surplusOff
    and not boundaryReported
    and qualifyReported
  }
  // The naming rule also reports with surplus on. So neither value of
  // rules.surplus gates it.
  reachable QualifyFiresWhileSurplusOn {
    not surplusOff
    and qualifyApplies()
    and not nameCarriesNamespace
    and qualifyReported
  }
  reachable BoundaryFiresWhileSurplusOff {
    surplusOff
    and not boundaryOff
    and resolvedScope == Private
    and referencedFrom == OtherNamespace
    and boundaryReported
  }

  // --- auxiliary ---
  invariant ReportsImplyConfigured {
    boundaryReported or qualifyReported or surplusReported => configured
  }
}
