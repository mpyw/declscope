// Where a member's two file-derived properties come from.
//
// A member is bounded by the namespace of the file declaring its TYPE, wherever
// the member is written, while its file-level scope default comes from the file
// the MEMBER is written in. This spec pins the consequences of that split so
// they are recorded rather than discovered.
spec MemberFile {
  enum Scope { Package, Private }
  enum Dir   { NoDir, DirPackage, DirPrivate }
  enum Site  { TypeFile, MemberFile, Other }

  state {
    configured: Bool, cfgUnexported: Scope,
    sameFile: Bool, exported: Bool,
    declDir: Dir, typeDir: Dir, memberFileDir: Dir,
    refFrom: Site
  }
  init {
    configured = false  cfgUnexported = Private
    sameFile = true  exported = false
    declDir = NoDir  typeDir = NoDir  memberFileDir = NoDir
    refFrom = TypeFile
  }
  action configure(u: Scope, s: Bool, x: Bool,
                   dd: Dir, td: Dir, mfd: Dir, r: Site) {
    requires not configured
    configured = true  cfgUnexported = u
    sameFile = s  exported = x
    declDir = dd  typeDir = td  memberFileDir = mfd
    refFrom = r
  }

  // The member's file supplies the file level; the type's file does not.
  def fileLevel() = memberFileDir
  def effScope() =
    if declDir == DirPackage then Package
    else if declDir == DirPrivate then Private
    else if typeDir == DirPackage then Package
    else if typeDir == DirPrivate then Private
    else if fileLevel() == DirPackage then Package
    else if fileLevel() == DirPrivate then Private
    else cfgUnexported

  // The bounding namespace is the type's file's. A reference from the member's
  // own file therefore crosses it whenever the member lives elsewhere.
  def crosses() =
    if refFrom == TypeFile then false
    else if refFrom == MemberFile then not sameFile
    else true
  def fires() = not exported and effScope() == Private and crosses()

  // Already true before any of this: a member written away from its type is
  // unusable from the file that declares it.
  reachable SelfDeniedByConfigAlone {
    configured and not sameFile and declDir == NoDir and typeDir == NoDir
    and memberFileDir == NoDir and refFrom == MemberFile and not exported and fires()
  }
  // New with the file level: a directive written in one file decides the scope
  // of a declaration bounded by another file's namespace.
  reachable FileDirReachesForeignNamespace {
    configured and not sameFile and declDir == NoDir and typeDir == NoDir
    and memberFileDir == DirPrivate and refFrom == MemberFile
    and not exported and fires()
  }
  // The file level is the member's own file, and nothing else: this seals
  // fileLevel() against being repointed at the type's file.
  invariant FileLevelComesFromMemberFile {
    effScope() == (if declDir == DirPackage then Package
                   else if declDir == DirPrivate then Private
                   else if typeDir == DirPackage then Package
                   else if typeDir == DirPrivate then Private
                   else if memberFileDir == DirPackage then Package
                   else if memberFileDir == DirPrivate then Private
                   else cfgUnexported)
  }
  // A member written beside its type is reachable from that file, whatever the
  // config says: the split costs nothing in the ordinary case.
  invariant SameFileNeverSelfDenied {
    sameFile and refFrom == MemberFile => not fires()
  }
  invariant ExportedNeverFires { exported => not fires() }
}
