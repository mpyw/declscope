// shrink reports an exported declaration of an internal package that nothing
// outside its package uses, and fixes it by unexporting it (#112). It is
// surplus one visibility level up: exportedness wider than any use.
//
// Like surplus, it concludes from an absence, and every way a declaration can
// be used unseen is a way for it to be wrong. Here the two outputs are held to
// different standards, and that difference is the point of the model:
//
//   the report may be wrong where a use is possible but not provable: a
//     method or field whose name alone a build-excluded file of another
//     package writes, a field a literal or conversion through a type
//     parameter may write, or a range a nested module's build may read
//     through a copy of other source
//   an escape into an interface is taken as a use and reported not at all,
//     and so is a struct tag, which declares a use through reflection.
//     fmt, encoding/json and reflect find methods and fields at run time,
//     and dogfooding found no such report anyone could act on: nearly all
//     were fields of structs written as JSON or printed with %+v
//   the fix never is. FixNeverBreaks says an unexport is made only where no
//     use exists outside the package by any path, seen or unseen, and nothing
//     inside the package stops the rename
//
// The tool reads only what it can see. What it cannot see is modelled as truth
// the guards never read:
//
//   hiddenUse   a use no loaded package shows: an importer in another module,
//               a plugin looking up a symbol of package main, a module the
//               build reads that this run could not load, a package that
//               failed to load, assembly or cgo naming a Go symbol, or a
//               copy of other source a nested module builds. Each is
//               possible only outside Placement Internal,
//               which is what the range restriction buys, where the
//               declaration is exposed, or where the tool sees the
//               NestedBuild doubt
//   exposed     a method or field of a type the exported API of an importable
//               package reaches. Another module cannot name the type, but it
//               can hold a value of it (pub.Get().Method()), so the internal
//               rule proves nothing about its methods and fields. The tool
//               sees this, the way surplus sees an exported carrier
//   unprovenUse a use the loaded code leaves only a trace of: through
//               reflection or an interface found at run time, from a
//               build-excluded file, or by a literal or conversion through a
//               type parameter whose type set cannot be computed (#309).
//               Possible only where the tool sees a Doubt
//
// ASSUME-1: one exported declaration is enough. A fix renames only
//   identifiers of its own package, and changes no reference, so it cannot
//   change what any other declaration's judgment reads (modelling assumption)
// ASSUME-2: the rename guard itself (scope capture, collisions, sibling
//   targets) is renameUnsafe here. rename_guarded.fsl, rename_reach.fsl and
//   rename_siblings.fsl hold what it must check (modelling assumption)
spec Shrink {
  // Value is a func, var or const, and Type a type name. The two differ only
  // in whether an escape into an empty interface reaches them: a type's name
  // is read by %T, reflect.Type.Name and gob.Register.
  enum Kind { Value, Type, Method, Field }
  // Where the declaration sits. Only Internal is in range, and each other
  // value is one way run.skip or module.Range cannot vouch for every
  // importer, so the package is not judged:
  //   NotInternal   outside internal/, or under an internal/ whose parent
  //                 lies above the module: another module may import it
  //   MainPkg       package main, which a plugin looks symbols up in
  //   NonGoFiles    the package holds non-Go files (assembly for any
  //                 GOARCH, among others) or uses cgo, which name Go
  //                 symbols where go/types never reads
  //   UnreadModule  a nested module that may import it failed to load, the
  //                 main build list could not be read, or the build reads
  //                 a module in the range from elsewhere. A nested module
  //                 that loads is read, and its uses count as Spelled
  //   LoadError     a package failed to load, so an importer is unread
  // A package the patterns name but ./... leaves out is not loaded at all,
  // so it has no declaration to judge here.
  enum Placement { Internal, NotInternal, MainPkg, NonGoFiles, UnreadModule, LoadError }
  // What the loaded code shows about a use from another package.
  //   Spelled            a package in the build spells it, writes it in an
  //                      unkeyed literal, pairs it in a struct conversion,
  //                      passes it as a type argument, or links it by name
  //   ExtTestOnly        only an external test package (package foo_test).
  //                      A declaration of an in-package _test.go file that
  //                      only external tests use is the export_test.go
  //                      idiom, and the tool drops it without a report, so
  //                      ReportedTestOnly is narrower than modelled here
  //   ExcludedQualified  a build-excluded file imports the package and writes
  //                      pkg.Name, which only a package-level name can be
  enum Outside { None, Spelled, ExtTestOnly, ExcludedQualified }
  // What the tool sees short of a spelled use.
  //   Escapes       the type, or its owner, escapes into an empty interface,
  //                 directly or through a field, element, key or pointer. It
  //                 is read as a use (escapes() below), not as a doubt
  //   ExcludedName  a build-excluded file of another package writes the name
  //                 where no import pins it: x.Name, or a dot import
  //   Guessed       a composite literal or a struct conversion in another
  //                 package goes through a type parameter whose type set
  //                 cannot be computed, and may write the field, or the
  //                 embedded field a type names (evidence.guessed, #309)
  //   NestedBuild   a nested module's build compiles a copy of other source
  //                 that imports the range, or its build list cannot be read
  //                 (module.Doubt). Every fix in the range is withheld, and
  //                 the reports stay
  // Every value but Escapes withholds the fix and keeps the report.
  enum Doubt { NoDoubt, Escapes, ExcludedName, Guessed, NestedBuild }

  state {
    phase: 0..3 = 0,
    kind: Kind = Value, placement: Placement = Internal, exposed: Bool = false, hiddenUse: Bool = false,
    outside: Outside = None, doubt: Doubt = NoDoubt, unprovenUse: Bool = false, staticSatisfaction: Bool = false,
    excludedSamePkg: Bool = false, generatedRef: Bool = false, renameUnsafe: Bool = false, kept: Bool = false,
    exported: Bool = true,
    reported: Bool = false, reportedTestOnly: Bool = false, fixed: Bool = false, stalled: Bool = false
  }

  // Three steps rather than one: one action with every parameter is the
  // product of all of them at every step, which is what the checker holds.
  action configurePlacement(k: Kind, p: Placement, ex: Bool, h: Bool) {
    requires phase == 0
    // Only a method or a field is reached through a value.
    requires not (ex and (k == Value or k == Type))
    phase = 1  kind = k  placement = p  exposed = ex  hiddenUse = h
  }
  action configureUse(o: Outside, d: Doubt, dyn: Bool, sat: Bool) {
    requires phase == 1
    // Only a method satisfies an interface.
    requires not (sat and kind != Method)
    // pkg.Name selects a package-level name, never a method or a field.
    requires not (o == ExcludedQualified and (kind == Method or kind == Field))
    // A func, var or const has no method set and no name reflect reads.
    requires not (d == Escapes and kind == Value)
    // An unproven use leaves a trace: an escape, a name in an excluded file,
    // or a guessed write.
    requires not (dyn and d == NoDoubt)
    // Only a field is written by a literal or paired by a conversion, and a
    // type through the embedded field it names.
    requires not (d == Guessed and (kind == Value or kind == Method))
    // Everything that can hide an importer is outside the range, exposes the
    // declaration through a value, or is a nested module's build the tool
    // sees and cannot read through.
    requires not (hiddenUse and placement == Internal and not exposed and d != NestedBuild)
    phase = 2  outside = o  doubt = d  unprovenUse = dyn  staticSatisfaction = sat
  }
  // The four things inside the package that stop a rename. ex is a
  // build-excluded file of the package that writes or linknames the name,
  // or, for a member, may use it. gen is a reference the rename cannot
  // rewrite: a generated file or an example function of the package naming
  // the declaration, or, for a package-level string var, `-ldflags -X`
  // (run.linkerSet). A regeneration would put the old name back, go vet
  // checks that ExampleF still names F, and the linker ignores a -X whose
  // name is gone, so a release silently loses the value. un is the rename
  // guard (ASSUME-2). kp is an exported declaration that
  // keeps its name handing the type out: unexporting it would leave that
  // declaration returning a type its callers cannot name. Which declarations
  // keep their names is settled across the package; shrink_settle.fsl is that
  // model, and here it is one input.
  action configureFix(ex: Bool, gen: Bool, un: Bool, kp: Bool) {
    requires phase == 2
    requires not (kp and kind != Type)
    phase = 3  excludedSamePkg = ex  generatedRef = gen  renameUnsafe = un  kept = kp
  }

  def configured() = phase == 3

  // A pass that ran and neither reported nor fixed, which may repeat forever.
  action pass() { requires configured()  stalled = true }

  // --- what the tool reads ------------------------------------------------
  def inRange() = placement == Internal
  // A static satisfaction is a use, found by refactor/satisfy.
  def satisfied() = kind == Method and staticSatisfaction
  // An escape is a use, like a static satisfaction.
  def escapes() = doubt == Escapes
  def fires() = exported and inRange() and not exposed and outside == None and not satisfied() and not escapes()
  def testOnlyFires() = exported and inRange() and not exposed and outside == ExtTestOnly and not satisfied() and not escapes()
  def fixBlocked() = doubt != NoDoubt or excludedSamePkg or generatedRef or renameUnsafe or kept
  def fixable() = fires() and not fixBlocked()

  // --- the truth the tool never reads -------------------------------------
  def usedOutside() = outside != None or hiddenUse or unprovenUse or satisfied()
  def breaksInside() = excludedSamePkg or generatedRef or renameUnsafe or kept
  def fixBreaks() = usedOutside() or breaksInside()

  fair action report() {
    requires configured()  requires not reported  requires fires()
    reported = true
  }
  fair action reportTestOnly() {
    requires configured()  requires not reportedTestOnly  requires testOnlyFires()
    reportedTestOnly = true
  }
  fair action fix() {
    requires configured()  requires reported  requires not fixed  requires fixable()
    fixed = true  exported = false
  }

  // Nothing is judged before the configuration is complete, and a fix follows
  // its report. Both are what makes the invariants below inductive.
  invariant JudgedOnlyOnceConfigured {
    (reported or reportedTestOnly or fixed or stalled) => configured()
  }
  invariant FixFollowsReport { fixed => reported }
  // The configuration keeps what configure required of it: nothing hides an
  // importer inside the range, and an unproven use leaves a trace.
  invariant PlacementUnsetBeforeItsStep {
    phase == 0 => kind == Value and placement == Internal and not exposed and not hiddenUse
  }
  invariant UseUnsetBeforeItsStep {
    phase <= 1 => outside == None and doubt == NoDoubt
                  and not unprovenUse and not staticSatisfaction
  }
  invariant FixInputsUnsetBeforeTheirStep {
    phase <= 2 => not excludedSamePkg and not generatedRef and not renameUnsafe and not kept
  }
  invariant NothingHiddenInRangeUnlessSeen {
    (phase >= 2 and hiddenUse) => placement != Internal or exposed or doubt == NestedBuild
  }
  invariant OnlyAMemberIsExposed { exposed => kind == Method or kind == Field }
  invariant UnprovenUseLeavesATrace { unprovenUse => doubt != NoDoubt }
  invariant OnlyAFieldOrTypeIsGuessed { doubt == Guessed => kind == Field or kind == Type }
  invariant OnlyAMethodSatisfies { staticSatisfaction => kind == Method }
  invariant UnexportedOnlyByTheFix { not exported => fixed }

  // The property the fix exists to keep. An unexport must never break a build
  // or change what a program does.
  invariant FixNeverBreaks { fixed => not fixBreaks() }

  // The report is never made of a declaration the loaded code shows in use.
  invariant NeverReportsVisibleUse { reported => outside == None and not satisfied() }
  // A value of the type reaches another module, so its methods and fields may
  // be used there, and nothing is said.
  invariant SilentWhenExposed { (reported or reportedTestOnly) => not exposed }
  invariant TestOnlyMeansOnlyTests { reportedTestOnly => outside == ExtTestOnly }
  invariant NeverBothReports { not (reported and reportedTestOnly) }
  // Outside the range the absence of a use proves nothing, so nothing is said.
  // This holds by definition, since fires() reads inRange(). With the
  // Silent* witnesses below, it shows only that the mapping is one-way: each
  // placement other than Internal is silent. Which code conditions map to
  // which placement is the Placement comment's claim, not this model's.
  invariant SilentOutsideRange {
    (reported or reportedTestOnly or fixed) => placement == Internal
  }
  // A declaration only tests use from outside keeps its name: the external
  // test package would stop compiling.
  invariant NoFixForTestOnly { not (fixed and reportedTestOnly) }

  // One pass converges: once unexported, the declaration is out of the rule,
  // and no report starts after the fix.
  invariant FixedIsSettled { fixed => not fires() and not testOnlyFires() }
  trans NoReportAfterFix {
    old(fixed) => (reported == old(reported) and reportedTestOnly == old(reportedTestOnly))
  }

  trans ReportOnlyWhereItFires { not old(reported) and reported => old(fires()) }
  trans FixOnlyWhereFixable { not old(fixed) and fixed => old(fixable()) }

  reachable Reported { reported }
  reachable Fixed { fixed }
  reachable ReportedTestOnly { reportedTestOnly }
  reachable FixedMethod { fixed and kind == Method }
  reachable FixedField { fixed and kind == Field }

  // The report is advisory where a use is possible: it can be wrong, and the
  // fix is what stays out.
  reachable ReportedDespiteAnUnprovenUse { reported and unprovenUse }

  // An escape silences the report, as a use does.
  invariant SilentOnEscape { (reported or reportedTestOnly) => not escapes() }

  // Each fix blocker withholds the fix and leaves the report, witnessed alone
  // with every other one off.
  def onlyBlocker() = configured() and fires()
  reachable WithheldOnExcludedName {
    onlyBlocker() and doubt == ExcludedName
    and not excludedSamePkg and not generatedRef and not renameUnsafe and not kept and not fixable()
  }
  // A literal through a type parameter may write the field. The report
  // stays, and may be wrong, and the fix is withheld.
  reachable WithheldOnGuessedWrite {
    onlyBlocker() and doubt == Guessed and unprovenUse and reported
    and not excludedSamePkg and not generatedRef and not renameUnsafe and not kept and not fixable()
  }
  // An embedded field a type names is guessed the same way.
  reachable WithheldOnGuessedEmbeddedType {
    onlyBlocker() and kind == Type and doubt == Guessed
    and not excludedSamePkg and not generatedRef and not renameUnsafe and not kept and not fixable()
  }
  reachable WithheldOnExcludedSamePackage {
    onlyBlocker() and doubt == NoDoubt
    and excludedSamePkg and not generatedRef and not renameUnsafe and not kept and not fixable()
  }
  reachable WithheldOnGeneratedReference {
    onlyBlocker() and doubt == NoDoubt
    and not excludedSamePkg and generatedRef and not renameUnsafe and not kept and not fixable()
  }
  reachable WithheldOnUnsafeRename {
    onlyBlocker() and doubt == NoDoubt
    and not excludedSamePkg and not generatedRef and renameUnsafe and not kept and not fixable()
  }
  // A nested module's build may use the declaration through a copy of other
  // source. The report stays, and may be wrong, and the fix is withheld.
  reachable WithheldOnNestedBuild {
    onlyBlocker() and doubt == NestedBuild and hiddenUse and reported
    and not excludedSamePkg and not generatedRef and not renameUnsafe and not kept and not fixable()
  }
  reachable WithheldOnKeptByAnExport {
    onlyBlocker() and doubt == NoDoubt
    and not excludedSamePkg and not generatedRef and not renameUnsafe and kept and not fixable()
  }
  // An escape is a use for a type too, whose name reflect reads, and the
  // report stays out.
  reachable SilentOnTypeEscape {
    configured() and inRange() and not exposed and outside == None and kind == Type
    and doubt == Escapes and not fires()
  }

  // Each reason for silence, witnessed with the declaration otherwise unused.
  def unusedInRange() = configured() and exported and outside == None and not satisfied()
  reachable SilentOnStaticSatisfaction {
    configured() and inRange() and not exposed and outside == None and kind == Method
    and staticSatisfaction and not fires()
  }
  reachable SilentWhenExposedAlone {
    configured() and inRange() and exposed and outside == None
    and not satisfied() and not fires()
  }
  reachable SilentOnSpelledUse {
    configured() and inRange() and not exposed and outside == Spelled
    and not satisfied() and not fires()
  }
  reachable SilentOnExcludedQualifiedUse {
    configured() and inRange() and not exposed and outside == ExcludedQualified and not fires()
  }
  reachable SilentOutsideInternal {
    configured() and placement == NotInternal and outside == None and not fires()
  }
  reachable SilentInMain {
    configured() and placement == MainPkg and outside == None and not fires()
  }
  reachable SilentOnNonGoFiles {
    configured() and placement == NonGoFiles and outside == None and not fires()
  }
  reachable SilentOverUnreadModule {
    configured() and placement == UnreadModule and outside == None and not fires()
  }
  reachable SilentOnLoadError {
    configured() and placement == LoadError and outside == None and not fires()
  }
  reachable CanFireUnused { unusedInRange() and inRange() and fires() }

  reachable PendingReportSurvivesAPass { stalled and fires() and not reported }

  leadsTo EventuallyReported {
    configured() and fires() ~> reported
    helpful report()
    decreases if reported then 0 else 1
  }
  leadsTo EventuallyFixed {
    configured() and fixable() and reported ~> fixed
    helpful fix()
    decreases if fixed then 0 else 1
  }
}
