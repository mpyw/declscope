// shrink reports an exported declaration of an internal package that
// nothing outside its package uses. It fixes the report by unexporting the
// declaration (#112). It is surplus one visibility level up: the
// declaration is exported wider than any use.
//
// Like surplus, it concludes from an absence. Every way to use a
// declaration unseen is a way for that conclusion to be wrong. Here the
// report and the fix are held to different standards. That difference is
// the point of the model:
//
//   report      It may be wrong where a use is possible but not provable.
//               A build-excluded file of another package may use a method
//               or a field. A literal or a conversion through a type
//               parameter may write a field. A nested module's build may
//               read the range through a copy of other source.
//   escape      An escape into an interface counts as a use, so nothing is
//               reported. A struct tag counts the same way, since it
//               declares a use through reflection. fmt, encoding/json and
//               reflect find methods and fields at run time. Dogfooding
//               found no such report anyone could act on. Nearly all were
//               fields of structs written as JSON or printed with %+v.
//   fix         It is never wrong. FixNeverBreaks says an unexport happens
//               only where no use exists outside the package. That covers
//               every path, seen or unseen. Also, nothing inside the
//               package may stop the rename.
//
// The tool reads only what it can see. What it cannot see is modelled as
// truth that no guard reads:
//
//   hiddenUse    A use that no loaded package shows. Examples:
//                - an importer in another module
//                - a plugin that looks up a symbol of package main
//                - a module the build reads that this run could not load
//                - a package that failed to load
//                - assembly or cgo that names a Go symbol
//                - a copy of other source that a nested module builds
//                Each one is possible only in three places. The first is
//                outside Placement Internal. Ruling that out is what the
//                range restriction buys. The second is where the
//                declaration is exposed. The third is where the tool sees
//                the NestedBuild doubt.
//   unprovenUse  A use that the loaded code shows only a trace of. It may
//                go through reflection or an interface found at run time.
//                It may come from a build-excluded file. It may be a
//                literal or a conversion through a type parameter whose
//                type set cannot be computed (#309). It is possible only
//                where the tool sees a Doubt.
//
// One more input silences the report. The tool sees it, but it is not a use
// the tool can find:
//
//   exposed      A method or field of a type that the exported API of an
//                importable package reaches. Another module cannot name the
//                type. But it can hold a value of it: pub.Get().Method().
//                So the internal rule proves nothing about the methods and
//                fields of the type. The tool sees this, the way surplus
//                sees an exported carrier.
//
// ASSUME-1: one exported declaration is enough. A fix renames only
//   identifiers of its own package, and it changes no reference. So it
//   cannot change what the judgment of another declaration reads
//   (modelling assumption).
// ASSUME-2: renameUnsafe stands for the rename guard itself: scope capture,
//   collisions and sibling targets. rename_guarded.fsl, rename_reach.fsl
//   and rename_siblings.fsl hold what the guard must check (modelling
//   assumption).
fsl 5
spec Shrink {
  // Value is a func, var or const. Type is a type name. The two differ only
  // in one way. An escape into an empty interface reaches a type's name,
  // through %T, reflect.Type.Name and gob.Register.
  enum Kind { Value, Type, Method, Field }
  // Where the declaration sits. Only Internal is in range. Every other value
  // is one way the tool cannot vouch for every importer. Then nothing about
  // the package is reported:
  //   NotInternal   Outside internal/, or under an internal/ whose parent
  //                 lies above the module. Another module may import it
  //                 (module.Range).
  //   MainPackage   Package main. A plugin looks symbols up in it
  //                 (run.skip).
  //   NonGoFiles    The package holds non-Go files, or it uses cgo. Non-Go
  //                 files include assembly for any GOARCH. These files name
  //                 Go symbols where go/types never reads (run.skip).
  //   UnreadModule  One of three things (module.Range). A nested module
  //                 that may import the package failed to load. Or the main
  //                 build list could not be read. Or the build reads a
  //                 module in the range from elsewhere. A nested module
  //                 that loads is read, and its uses count as Spelled.
  //   LoadError     A package of the module does not type-check. Then
  //                 module.Load refuses the whole run. Nothing is reported
  //                 for any package.
  // The patterns may name a package that ./... leaves out. That package is
  // not loaded at all, so it has no declaration to judge here.
  enum Placement { Internal, NotInternal, MainPackage, NonGoFiles, UnreadModule, LoadError }
  // What the loaded code shows about a use from another package.
  //   Spelled            A package in the build spells it, or writes it in
  //                      an unkeyed literal. Or it pairs it in a struct
  //                      conversion, passes it as a type argument, or links
  //                      it by name.
  //   ExternalTestOnly   Only an external test package (package foo_test)
  //                      uses it. The tool drops one case without a report:
  //                      a declaration of an in-package _test.go file that
  //                      only external tests use. That is the
  //                      export_test.go idiom. So ReportedTestOnly is
  //                      narrower in the tool than in this model.
  //   ExcludedQualified  A build-excluded file imports the package and
  //                      writes pkg.Name. Only a package-level name can be
  //                      written that way (exclusions.qualifies).
  enum Outside { None, Spelled, ExternalTestOnly, ExcludedQualified }
  // What the tool sees short of a spelled use.
  //   Escapes       The type, or its owner, escapes into an empty interface.
  //                 It may escape directly, or through a field, an element,
  //                 a key or a pointer. The tool reads it as a use, not as a
  //                 doubt (escapes() below).
  //   ExcludedName  A build-excluded file of another package may use it
  //                 (exclusions.mayUse). A method, a field or an embedded
  //                 type needs no written name. Go uses those without
  //                 writing their names. So for them, any such file counts
  //                 if it may hold a value of the package's types. Any
  //                 other declaration counts only where the file writes its
  //                 name under a dot import.
  //   Guessed       A composite literal or a struct conversion in another
  //                 package goes through a type parameter. The type set of
  //                 that parameter cannot be computed. So it may write the
  //                 field, or the embedded field that a type names
  //                 (evidence.guessed, #309).
  //   NestedBuild   A nested module's build compiles a copy of other source
  //                 that imports the range. Or its build list cannot be
  //                 read (module.Doubt). Every fix in the range is withheld,
  //                 and the reports stay.
  // Every value but Escapes withholds the fix and keeps the report.
  enum Doubt { NoDoubt, Escapes, ExcludedName, Guessed, NestedBuild }

  state {
    phase: 0..3 = 0,
    kind: Kind = Value,
    placement: Placement = Internal,
    exposed: Bool = false,
    hiddenUse: Bool = false,
    outside: Outside = None,
    doubt: Doubt = NoDoubt,
    unprovenUse: Bool = false,
    staticSatisfaction: Bool = false,
    excludedFileInPackage: Bool = false,
    generatedRef: Bool = false,
    renameUnsafe: Bool = false,
    keptByAnExport: Bool = false,
    exported: Bool = true,
    reported: Bool = false,
    reportedTestOnly: Bool = false,
    fixed: Bool = false,
    idlePassRan: Bool = false
  }

  // The configuration takes three steps rather than one. One action with
  // every parameter is the product of all of them at every step. The
  // checker has to hold that product.
  action configurePlacement(
    newKind: Kind,
    newPlacement: Placement,
    newExposed: Bool,
    newHiddenUse: Bool
  ) {
    requires phase == 0
    // Only a method or a field is reached through a value.
    requires not (newExposed and (newKind == Value or newKind == Type))
    phase = 1
    kind = newKind
    placement = newPlacement
    exposed = newExposed
    hiddenUse = newHiddenUse
  }
  action configureUse(
    newOutside: Outside,
    newDoubt: Doubt,
    newUnprovenUse: Bool,
    newStaticSatisfaction: Bool
  ) {
    requires phase == 1
    // Only a method satisfies an interface.
    requires not (newStaticSatisfaction and kind != Method)
    // pkg.Name selects a package-level name, never a method or a field.
    requires not (newOutside == ExcludedQualified and (kind == Method or kind == Field))
    // A func, var or const has no method set and no name that reflect reads.
    requires not (newDoubt == Escapes and kind == Value)
    // An unproven use leaves a trace. The trace is an escape, a name in an
    // excluded file, or a guessed write.
    requires not (newUnprovenUse and newDoubt == NoDoubt)
    // A literal writes only a field, and a conversion pairs only a field.
    // A type is written through the embedded field it names.
    requires not (newDoubt == Guessed and (kind == Value or kind == Method))
    // Anything that can hide an importer is in one of three places. It is
    // outside the range. Or it exposes the declaration through a value. Or
    // it is a nested module's build, which the tool sees but cannot read.
    requires not (hiddenUse and placement == Internal and not exposed and newDoubt != NestedBuild)
    phase = 2
    outside = newOutside
    doubt = newDoubt
    unprovenUse = newUnprovenUse
    staticSatisfaction = newStaticSatisfaction
  }
  // The four things inside the package that stop a rename:
  //   excludedFileInPackage  A build-excluded file of the package writes
  //                          the name or linknames it. For a member, such
  //                          a file may also use it.
  //   generatedRef           A reference that the rename cannot rewrite.
  //                          It is a generated file or an example function
  //                          of the package that names the declaration.
  //                          For a package-level string var, it is also
  //                          `-ldflags -X` (candidate.linkerSet). A
  //                          regeneration would put the old name back. go
  //                          vet checks that ExampleF still names F. The
  //                          linker ignores a -X whose name is gone, so a
  //                          release silently loses the value.
  //   renameUnsafe           The rename guard (ASSUME-2).
  //   keptByAnExport         An exported declaration keeps its name and
  //                          hands the type out. Unexporting the type would
  //                          leave that declaration returning a type its
  //                          callers cannot name. Which declarations keep
  //                          their names is settled across the package.
  //                          shrink_settle.fsl models that, and here it is
  //                          one input.
  action configureFix(
    newExcludedFileInPackage: Bool,
    newGeneratedRef: Bool,
    newRenameUnsafe: Bool,
    newKeptByAnExport: Bool
  ) {
    requires phase == 2
    requires not (newKeptByAnExport and kind != Type)
    phase = 3
    excludedFileInPackage = newExcludedFileInPackage
    generatedRef = newGeneratedRef
    renameUnsafe = newRenameUnsafe
    keptByAnExport = newKeptByAnExport
  }

  def configured() = phase == 3

  // A pass that ran and neither reported nor fixed. It may repeat forever.
  action idlePass() {
    requires configured()
    idlePassRan = true
  }

  // --- what the tool reads ------------------------------------------------
  def inRange() = placement == Internal
  // A static satisfaction is a use. refactor/satisfy finds it.
  def satisfied() = kind == Method and staticSatisfaction
  // An escape is a use, like a static satisfaction.
  def escapes() = doubt == Escapes
  // Every condition for a report except the use from outside. The
  // declaration is still exported and sits in range. Nothing the tool sees
  // silences it.
  def noSilencingReason() =
    exported
    and inRange()
    and not exposed
    and not satisfied()
    and not escapes()
  def fires() = noSilencingReason() and outside == None
  def testOnlyFires() = noSilencingReason() and outside == ExternalTestOnly
  def fixBlocked() =
    doubt != NoDoubt
    or excludedFileInPackage
    or generatedRef
    or renameUnsafe
    or keptByAnExport
  def fixable() = fires() and not fixBlocked()

  // --- the truth the tool never reads -------------------------------------
  def usedOutside() = outside != None or hiddenUse or unprovenUse or satisfied()
  def breaksInside() = excludedFileInPackage or generatedRef or renameUnsafe or keptByAnExport
  def fixBreaks() = usedOutside() or breaksInside()

  fair action report() {
    requires configured()
    requires not reported
    requires fires()
    reported = true
  }
  fair action reportTestOnly() {
    requires configured()
    requires not reportedTestOnly
    requires testOnlyFires()
    reportedTestOnly = true
  }
  fair action fix() {
    requires configured()
    requires reported
    requires not fixed
    requires fixable()
    fixed = true
    exported = false
  }

  // Nothing is judged before the configuration is complete. A fix follows
  // its report. These two make the invariants below inductive.
  invariant JudgedOnlyOnceConfigured {
    (reported or reportedTestOnly or fixed or idlePassRan) => configured()
  }
  invariant FixFollowsReport { fixed => reported }
  // Each input keeps its initial value until its configure step sets it.
  invariant PlacementUnsetBeforeItsStep {
    phase == 0 => kind == Value
                  and placement == Internal
                  and not exposed
                  and not hiddenUse
  }
  invariant UseUnsetBeforeItsStep {
    phase <= 1 => outside == None
                  and doubt == NoDoubt
                  and not unprovenUse
                  and not staticSatisfaction
  }
  invariant FixInputsUnsetBeforeTheirStep {
    phase <= 2 => not excludedFileInPackage
                  and not generatedRef
                  and not renameUnsafe
                  and not keptByAnExport
  }
  // The configuration keeps what configure required of it. Nothing hides an
  // importer inside the range, and an unproven use leaves a trace.
  invariant NothingHiddenInRangeUnlessSeen {
    (phase >= 2 and hiddenUse) => placement != Internal or exposed or doubt == NestedBuild
  }
  invariant OnlyAMemberIsExposed { exposed => kind == Method or kind == Field }
  invariant UnprovenUseLeavesATrace { unprovenUse => doubt != NoDoubt }
  invariant OnlyAFieldOrTypeIsGuessed { doubt == Guessed => kind == Field or kind == Type }
  invariant OnlyAMethodSatisfies { staticSatisfaction => kind == Method }
  invariant UnexportedOnlyByTheFix { not exported => fixed }

  // The property the fix exists to keep. An unexport must never break a
  // build or change what a program does.
  invariant FixNeverBreaks { fixed => not fixBreaks() }

  // The report is never made of a declaration the loaded code shows in use.
  invariant NeverReportsVisibleUse { reported => outside == None and not satisfied() }
  // A value of the type reaches another module. Its methods and fields may
  // be used there, so nothing is said.
  invariant SilentWhenExposed { (reported or reportedTestOnly) => not exposed }
  invariant TestOnlyMeansOnlyTests { reportedTestOnly => outside == ExternalTestOnly }
  invariant NeverBothReports { not (reported and reportedTestOnly) }
  // Outside the range, the absence of a use proves nothing. So nothing is
  // said. This holds by definition, since fires() reads inRange(). With the
  // Silent* witnesses below, it shows only one direction of the mapping:
  // each placement other than Internal is silent. Which code conditions map
  // to which placement is the claim of the Placement comment. This model
  // does not check it.
  invariant SilentOutsideRange {
    (reported or reportedTestOnly or fixed) => placement == Internal
  }
  // A declaration that only tests use from outside keeps its name. The
  // external test package would stop compiling otherwise.
  invariant NoFixForTestOnly { not (fixed and reportedTestOnly) }

  // One pass converges. Once unexported, the declaration is out of the
  // rule, and no report starts after the fix.
  invariant FixedIsSettled { fixed => not fires() and not testOnlyFires() }
  trans NoReportAfterFix {
    old(fixed) => (reported == old(reported) and reportedTestOnly == old(reportedTestOnly))
  }

  trans ReportOnlyWhereItFires { not old(reported) and reported => old(fires()) }
  trans FixOnlyWhereFixable { not old(fixed) and fixed => old(fixable()) }

  reachable Reported { reported }
  reachable Fixed { fixed }
  reachable ReportedTestOnly { reportedTestOnly }
  reachable FixedMethod { fixed and kind == Method }
  reachable FixedField { fixed and kind == Field }

  // The report is advisory where a use is possible. It can be wrong, and
  // the fix is what stays out.
  reachable ReportedDespiteAnUnprovenUse { reported and unprovenUse }

  // An escape silences the report, as a use does.
  invariant SilentOnEscape { (reported or reportedTestOnly) => not escapes() }

  // Each fix blocker withholds the fix and leaves the report. Each one is
  // witnessed alone, with every other one off.
  def wouldReport() = configured() and fires()
  // None of the four things inside the package that stop a rename is set.
  def noInsideBlocker() =
    not excludedFileInPackage
    and not generatedRef
    and not renameUnsafe
    and not keptByAnExport
  reachable WithheldOnExcludedName {
    wouldReport()
    and doubt == ExcludedName
    and noInsideBlocker()
    and not fixable()
  }
  // A literal through a type parameter may write the field. The report
  // stays and may be wrong. The fix is withheld.
  reachable WithheldOnGuessedWrite {
    wouldReport()
    and doubt == Guessed
    and unprovenUse
    and reported
    and noInsideBlocker()
    and not fixable()
  }
  // An embedded field that a type names is guessed the same way.
  reachable WithheldOnGuessedEmbeddedType {
    wouldReport()
    and kind == Type
    and doubt == Guessed
    and noInsideBlocker()
    and not fixable()
  }
  reachable WithheldOnExcludedSamePackage {
    wouldReport()
    and doubt == NoDoubt
    and excludedFileInPackage
    and not generatedRef
    and not renameUnsafe
    and not keptByAnExport
    and not fixable()
  }
  reachable WithheldOnGeneratedReference {
    wouldReport()
    and doubt == NoDoubt
    and not excludedFileInPackage
    and generatedRef
    and not renameUnsafe
    and not keptByAnExport
    and not fixable()
  }
  reachable WithheldOnUnsafeRename {
    wouldReport()
    and doubt == NoDoubt
    and not excludedFileInPackage
    and not generatedRef
    and renameUnsafe
    and not keptByAnExport
    and not fixable()
  }
  // A nested module's build may use the declaration through a copy of
  // other source. The report stays and may be wrong. The fix is withheld.
  reachable WithheldOnNestedBuild {
    wouldReport()
    and doubt == NestedBuild
    and hiddenUse
    and reported
    and noInsideBlocker()
    and not fixable()
  }
  reachable WithheldOnKeptByAnExport {
    wouldReport()
    and doubt == NoDoubt
    and not excludedFileInPackage
    and not generatedRef
    and not renameUnsafe
    and keptByAnExport
    and not fixable()
  }
  // An escape is a use for a type too, since reflect reads its name. The
  // report stays out.
  reachable SilentOnTypeEscape {
    configured()
    and inRange()
    and not exposed
    and outside == None
    and kind == Type
    and doubt == Escapes
    and not fires()
  }

  // Each reason for silence, witnessed with the declaration otherwise unused.
  reachable SilentOnStaticSatisfaction {
    configured()
    and inRange()
    and not exposed
    and outside == None
    and kind == Method
    and staticSatisfaction
    and not fires()
  }
  reachable SilentWhenExposedAlone {
    configured()
    and inRange()
    and exposed
    and outside == None
    and not satisfied()
    and not fires()
  }
  reachable SilentOnSpelledUse {
    configured()
    and inRange()
    and not exposed
    and outside == Spelled
    and not satisfied()
    and not fires()
  }
  reachable SilentOnExcludedQualifiedUse {
    configured()
    and inRange()
    and not exposed
    and outside == ExcludedQualified
    and not fires()
  }
  // A placement out of range, with no use that the loaded code shows.
  def silentAt(outOfRange: Placement) =
    configured()
    and placement == outOfRange
    and outside == None
    and not fires()
  reachable SilentOutsideInternal { silentAt(NotInternal) }
  reachable SilentInMain { silentAt(MainPackage) }
  reachable SilentOnNonGoFiles { silentAt(NonGoFiles) }
  reachable SilentOverUnreadModule { silentAt(UnreadModule) }
  reachable SilentOnLoadError { silentAt(LoadError) }

  // The rule fires on an exported declaration that nothing outside uses.
  def unusedOutsideItsPackage() =
    configured()
    and exported
    and outside == None
    and not satisfied()
  reachable CanFireUnused { unusedOutsideItsPackage() and inRange() and fires() }

  reachable PendingReportSurvivesAPass { idlePassRan and fires() and not reported }

  leadsTo EventuallyReported {
    configured() and fires() ~> reported
    helpful report()
    decreases if reported then 0 else 1
  }
  leadsTo EventuallyFixed {
    configured() and fixable() and reported ~> fixed
    helpful fix()
    decreases if fixed then 0 else 1
  }
}
